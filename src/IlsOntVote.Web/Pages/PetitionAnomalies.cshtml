@page "/petitions/anomalies"
@model PetitionAnomaliesModel
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = L.T("anomalies-des-petitions");
    ViewData["Description"] = L.T("baisses-du-nombre-de-soutiens-et");
    var fr = L.Culture;
    var en = L.Anglais;
    var tri = Model.TriEffectif;
    string Nb(int? n) => n is null ? "—" : n.Value.ToString("N0", fr);
}

<h1 class="titre-page">@L.T("anomalies-des-petitions")</h1>
<p class="chapo">@L.TH("le-site-enregistre-a-chaque-import")</p>
<p class="note-source">@L.T("historique-tenu-depuis-le-12-mars")</p>

<form class="filtres filtres-auto filtres-liste" method="get" action="@L.Lien("/petitions/anomalies")">
    <input class="filtre" type="search" name="q" value="@Model.Recherche" placeholder="@L.T("mots-du-titre")" aria-label="@L.T("mots-du-titre-a150")" />
    @if (L.Pays is null)
    {
    <select name="chambre" aria-label="@L.T("plateforme")">
        <option value="">@L.T("senat-et-assemblee")</option>
        <option value="senat" selected="@(Model.Chambre == "senat")">@L.T("senat")</option>
        <option value="an" selected="@(Model.Chambre == "an")">@L.T("assemblee-nationale")</option>
    </select>
    }
    <select name="type" aria-label="@L.T("petition-champ-type")">
        <option value="">@L.T("tous-les-types")</option>
        @foreach (var t in PetitionAnomaliesModel.Types) { <option value="@t" selected="@(Model.Type == t)">@PetitionAnomaliesModel.TypeLibelle(t, L)</option> }
    </select>
    <span class="periode" title="@L.T("date-du-releve-ou-le-constat")">
        <label class="champ-date">@L.T("du") <input type="date" name="du" value="@Model.Du" aria-label="@L.T("du-date-de-debut")" /></label>
        <label class="champ-date">@L.T("au") <input type="date" name="au" value="@Model.Au" aria-label="@L.T("au-date-de-fin")" /></label>
    </span>
    <label class="champ-date" title="@L.T("baisse-minimale-en-nombre-de-soutiens")">@L.T("baisse-344a") <input type="number" min="0" step="1" name="baisse" value="@Model.BaisseTexte" style="width:6.5rem" /></label>
    <label class="champ-date" title="@L.T("baisse-minimale-en-du-nombre-precedent")">@L.T("baisse-fa8a") <input type="number" min="0" step="0.1" name="pct" value="@Model.PctTexte" style="width:5.5rem" /></label>
    <label class="champ-date" title="@L.T("soutiens-au-releve-precedent-au-moins")">@L.T("soutiens-avant") <input type="number" min="0" step="1" name="avant" value="@Model.AvantTexte" style="width:6.5rem" /></label>
    <select name="tri" class="tri-mobile" aria-label="@L.T("trier-par")">
        <option value="date" selected="@(tri == "date")">@L.T("trier-date")</option>
        <option value="titre" selected="@(tri == "titre")">@L.T("trier-titre")</option>
        <option value="type" selected="@(tri == "type")">@L.T("trier-type")</option>
        <option value="avant" selected="@(tri == "avant")">@L.T("trier-soutiens-avant")</option>
        <option value="apres" selected="@(tri == "apres")">@L.T("trier-soutiens-apres")</option>
        <option value="baisse" selected="@(tri == "baisse")">@L.T("trier-baisse")</option>
        <option value="pct" selected="@(tri == "pct")">@L.T("trier-baisse-29a4")</option>
    </select>
    <select name="sens" class="tri-mobile" aria-label="@L.T("sens-du-tri")">
        <option value="desc" selected="@Model.Decroissant">@L.T("decroissant")</option>
        <option value="asc" selected="@(!Model.Decroissant)">@L.T("croissant")</option>
    </select>
    <button type="submit" class="sans-js">@L.T("filtrer")</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@L.Lien("/petitions/anomalies")" title="@L.T("effacer-le-filtre")" aria-label="@L.T("effacer-le-filtre")"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></svg></a> }
</form>

<div class="barre-liste">
    <p class="compte">@Model.Resultats.Total.ToString("N0", fr) @(Model.Resultats.Total > 1 ? L.T("plur-constat-pl") : L.T("plur-constat-sg"))@(Model.ParType.Count > 0 && !Model.FiltreActif ? " (" + string.Join(", ", Model.ParType.Select(t => t.Nombre.ToString("N0", fr) + " " + PetitionAnomaliesModel.TypeLibelle(t.Libelle, L).ToLowerInvariant())) + ")" : "")</p>
    <p class="export">@L.T("exporter-ce-tableau")
        @foreach (var f in Exporteur.Formats) { <a href="@Model.Lien(format: f)" download>@f.ToUpperInvariant()</a> }
    </p>
</div>

@if (Model.Resultats.Lignes.Count == 0)
{
    <p class="vide">@(Model.FiltreActif ? L.T("aucun-constat-ne-correspond-a-ces") : L.T("aucun-constat-pour-le-moment-aucune"))</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead>
                <tr>
                    @Model.Th("date", L.T("detectee-le"), "nowrap")
                    @Model.Th("titre", L.T("petition"))
                    @Model.Th("type", L.T("petition-champ-type"))
                    @Model.Th("avant", L.T("avant"), "num")
                    @Model.Th("apres", L.T("apres"), "num")
                    @Model.Th("baisse", L.T("baisse"), "num")
                    @Model.Th("pct", "%", "num")
                </tr>
            </thead>
            <tbody>
            @foreach (var a in Model.Resultats.Lignes)
            {
                <tr>
                    <td class="nowrap" data-label="@L.T("detectee-le")" title="@L.T("releve-precedent")@a.ReleveAvant.ToString("d MMM yyyy", fr)">@a.DetecteLe.ToString("d MMM yyyy", fr)</td>
                    <td data-label="@L.T("petition")"><a href="@L.Lien("/petition/" + a.PetitionId)">@a.Titre</a> <span class="note-source">@(a.Chambre == "AN" ? L.T("assemblee") : a.Chambre == "UK" ? "UK Parliament" : L.T("senat"))</span></td>
                    <td data-label="@L.T("petition-champ-type")">@PetitionAnomaliesModel.TypeLibelle(a.Type, L)</td>
                    <td class="num" data-label="@L.T("avant")">@Nb(a.ValeurAvant)</td>
                    <td class="num" data-label="@L.T("apres")">@(a.ValeurApres is null ? "—" : Nb(a.ValeurApres))</td>
                    <td class="num" data-label="@L.T("baisse")">@Nb(a.Baisse)</td>
                    <td class="num" data-label="%">@(a.BaissePct is { } p ? p.ToString("0.0", fr) + (L.T("suffixe-pourcent")) : "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Resultats.NbPages > 1)
    {
        <nav class="pagination" aria-label="@L.T("pagination")">
            @if (Model.Resultats.Page > 1) { <a href="@Model.Lien(page: Model.Resultats.Page - 1)" rel="prev">@L.T("precedent")</a> }
            <span>@L.T("page") @Model.Resultats.Page / @Model.Resultats.NbPages</span>
            @if (Model.Resultats.Page < Model.Resultats.NbPages) { <a href="@Model.Lien(page: Model.Resultats.Page + 1)" rel="next">@L.T("suivant")</a> }
        </nav>
    }
    <partial name="_LignesParPage" model="Model" />
}
