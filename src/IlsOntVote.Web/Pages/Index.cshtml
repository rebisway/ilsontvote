@page
@using IlsOntVote.Web.Models
@model IndexModel
@inject IlsOntVote.Web.Services.PaysSite SitePays
@{
    ViewData["Title"] = "";
    var fr = L.Culture;
}

<div class="hero">
<section class="intro">
    <h1>@L.T("qui-a-vote-quoi")</h1>
    @{
        // Pays concerné, dit en clair sous le titre : les données de la page ne portent que sur lui (étanchéité entre pays, PaysSite.ChambresVisibles).
        var infoPays = SitePays.Actifs.FirstOrDefault(x => x.Code == L.Pays);
        var nomPays = L.Pays is null ? L.T("pays-france") : L.NomPays(L.Pays, infoPays?.NomFr ?? L.Pays, infoPays?.NomEn ?? L.Pays);
        var drapeau = (L.Pays ?? "FR").ToLowerInvariant();
    }
    <p class="pays-ligne"><img src="/img/flags/@(drapeau).svg" alt="" width="20" height="14" onerror="this.remove()" /> <strong>@nomPays</strong> · @string.Join(", ", Model.Sections.Select(x => L.Chambre(x.Chambre)))</p>
    <p>@L.TH("voyez-en-un-coup-d-il")</p>
    @{
        // Quelques lignes propres au pays, sous l'accroche (texte en base : clé par pays).
        var cleDecouvrez = "accueil-decouvrez-" + (L.Pays ?? "fr").ToLowerInvariant();
    }
    <p class="intro-decouvrez">@L.T(cleDecouvrez)</p>
</section>
</div>

<div class="colonnes">
@foreach (var section in Model.Sections)
{
    <section class="chambre">
        <div class="chambre-tete">
            <h2>@L.Chambre(section.Chambre)</h2>
            <p class="actions-chambre">
                <a class="bouton-lien" href="@L.Lien("/textes")?chambre=@Chambres.Filtre(section.Chambre)">@(section.Chambre is Chambres.Commons or Chambres.Lords or Chambres.CaCommons or Chambres.IeDail or Chambres.IeSeanad ? L.T("toutes-les-divisions") : Chambres.EstNominal(section.Chambre) ? L.T("tous-les-votes-nominaux") : L.T("tous-les-textes"))</a>
                @if (Chambres.AUneFiche(section.Chambre)) {
                    <a class="bouton-lien" href="@L.Lien("/" + Chambres.Liste(section.Chambre))">@L.T("tous-les")@L.Membres(section.Chambre)</a>
                }
            </p>
        </div>

        @if (section.Cartes.Count == 0)
        {
            <p class="vide">@L.T("aucun-scrutin-importe-pour-le-moment")</p>
        }

        <div class="cartes">
            @foreach (var c in section.Cartes)
            {
                <article class="carte">
                    <header>
                        <time datetime="@c.Scrutin.DateScrutin.ToString("yyyy-MM-dd")">@c.Scrutin.DateScrutin.ToString("d MMMM yyyy", fr)</time>
                        <span class="sort @(c.Scrutin.Adopte ? "adopte" : "rejete")">@(c.Scrutin.Adopte ? L.T("adopte") : L.T("rejete"))</span>
                    </header>
                    <h3><a href="@L.Lien("/scrutin/" + c.Scrutin.Id)" title="@Titres.Info(c.Scrutin.TitreLangue(L.Anglais), c.Scrutin.InfobulleTitre(L))">@Titres.Court(c.Scrutin.TitreLangue(L.Anglais))</a></h3>

                    <a class="carte-hemicycle" href="@L.Lien("/scrutin/" + c.Scrutin.Id)" tabindex="-1" aria-hidden="true">
                        <partial name="_Hemicycle" model="(c.Vue, false)" />
                    </a>

                    <ul class="decompte">
                        <li class="d-pour"><b>@c.Pour</b> @L.T("pour-081c")</li>
                        <li class="d-contre"><b>@c.Contre</b> @L.T("contre-6505")</li>
                        <li class="d-abstention"><b>@c.Abstention</b> @L.T("abst")</li>
                        <li class="d-absent"><b>@c.Absent</b> @L.T("absents-67c7")</li>
                    </ul>
                </article>
            }
        </div>
    </section>
}
</div>

@* Bas de page : séparation nette, puis l'encart de soutien (mêmes liens que /soutenir). *@
<hr class="separateur" />
<aside class="encart-don" aria-labelledby="t-don">
    <div>
        <h2 id="t-don">@L.T("ce-site-est-gratuit-sans-publicite")</h2>
        <p>@L.T("il-vit-de-vos-dons-ils")</p>
    </div>
    <div class="dons">
        <a class="bouton-don bouton-don-principal" href="https://liberapay.com/Rebisway" rel="noopener">@L.T("don-regulier")</a>
        <a class="bouton-don" href="https://buy.stripe.com/28E28r5NraZv6dH3rvg3602" rel="noopener">@L.T("don-unique")</a>
        <a class="lien-don" href="@L.Lien("/soutenir")">@L.T("en-savoir-plus")</a>
    </div>
</aside>
