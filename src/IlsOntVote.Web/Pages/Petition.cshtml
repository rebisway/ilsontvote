@page "/petition/{id}"
@model PetitionModel
@using IlsOntVote.Web.Repositories
@{
    var f = Model.Fiche!;
    ViewData["Title"] = f.Titre.Length > 70 ? f.Titre[..70] + "…" : f.Titre;
    ViewData["Description"] = L.T("Historique des soutiens d'une pétition, relevé par relevé.", "Supporter history of a petition, snapshot by snapshot.");
    var fr = L.Culture;
    var en = L.Anglais;
    // Relevés : on n'affiche que les CHANGEMENTS (soutiens ou statut) + le premier et le dernier, pour ne pas répéter 40 lignes identiques.
    var gardes = new List<RelevePetition>();
    for (var i = 0; i < Model.Releves.Count; i++)
    {
        var r = Model.Releves[i];
        var change = i == 0 || i == Model.Releves.Count - 1 || r.NbVotes != Model.Releves[i - 1].NbVotes || r.Statut != Model.Releves[i - 1].Statut;
        if (change) gardes.Add(r);
    }
}

<p class="chapo"><a href="@L.Lien("/petitions")">← @L.T("Pétitions", "Petitions")</a> · <a href="@L.Lien("/petitions/anomalies")">@L.T("Anomalies", "Anomalies")</a></p>
<h1 class="titre-page">@f.Titre</h1>

<section class="definitions fiche-petition @PetitionsModel.StatutClasse(f.Statut)" aria-label="@L.T("Fiche", "Details")">
    <dl>
        <div><dt>@L.T("Publiée", "Published")</dt><dd>@(f.DatePublication?.ToString("d MMMM yyyy", fr) ?? "—")</dd></div>
        <div><dt>@L.T("Plateforme", "Platform")</dt><dd>@PetitionsModel.PlateformeLibelle(f.Chambre, en)</dd></div>
        @if (f.Type is not null) { <div><dt>Type</dt><dd>@PetitionsModel.TypeLibelle(f.Type, en)</dd></div> }
        @if (f.Commission is not null) { <div><dt>@L.T("Commission saisie", "Committee")</dt><dd>@f.Commission</dd></div> }
        @if (f.DecisionCommission is null && f.Chambre == "AN" && f.Statut is "classee" or "archivee") { <div><dt>@L.T("Décision publiée", "Published decision")</dt><dd><span class="doute doute-manquant" title="@L.T("La source ne publie aucune décision pour cette pétition", "The source publishes no decision for this petition")">? @L.T("non publiée par la source", "not published by the source")</span></dd></div> }
        @if (f.DecisionCommission is not null) { <div><dt>@L.T("Décision publiée", "Published decision")</dt><dd>@f.DecisionCommission</dd></div> }
        <div><dt>@L.T("Statut publié", "Published status")</dt><dd><span class="puce-statut @PetitionsModel.StatutClasse(f.Statut)">@PetitionsModel.StatutLibelle(f.Statut, en)</span></dd></div>
        <div><dt>@L.T("Soutiens", "Supporters")</dt><dd><strong class="grand-nombre">@(f.NbVotes?.ToString("N0", fr) ?? "—")</strong></dd></div>
        @if (f.DateLimiteVote is { } lim) { <div><dt>@L.T("Fin du recueil", "End of collection")</dt><dd>@lim.ToString("d MMMM yyyy", fr)</dd></div> }
        <div><dt>@L.T("Source", "Source")</dt><dd><a href="@f.Url" rel="noopener">@(f.Chambre == "AN" ? "petitions.assemblee-nationale.fr" : f.Chambre == "UK" ? "petition.parliament.uk" : "petitions.senat.fr")</a></dd></div>
    </dl>
    @if (f.Chambre == "UK")
    {
        @* Étapes de la plateforme du Parlement britannique, telles que publiées : seuil de réponse (10 000), réponse, seuil de débat (100 000), débat. Une étape sans date n'a pas eu lieu (ou n'est pas publiée). *@
        <dl>
            <div><dt>Response threshold (10,000)</dt><dd>@(f.SeuilReponseLe is { } sr ? "reached on " + sr.ToString("d MMMM yyyy", fr) : "not reached")</dd></div>
            @if (f.ReponseLe is { } rl)
            {
                <div><dt>Government response</dt><dd>@rl.ToString("d MMMM yyyy", fr)@if (f.ReponseResume is not null) { <br /><span class="note-source">@f.ReponseResume</span> }</dd></div>
            }
            <div><dt>Debate threshold (100,000)</dt><dd>@(f.SeuilDebatLe is { } sd ? "reached on " + sd.ToString("d MMMM yyyy", fr) : "not reached")</dd></div>
            @if (f.DebatLe is { } dl)
            {
                <div><dt>Debate in Parliament</dt><dd>@dl.ToString("d MMMM yyyy", fr)@if (f.DebatUrl is not null) { <text> · <a href="@f.DebatUrl" rel="noopener">transcript</a></text> }</dd></div>
            }
            else if (f.DebatPrevuLe is { } dp)
            {
                <div><dt>Debate scheduled</dt><dd>@dp.ToString("d MMMM yyyy", fr)</dd></div>
            }
        </dl>
    }
    @if (f.AbsenteDepuis is { } abs)
    {
        <p class="note-source"><span class="doute doute-incertain" title="@L.T("Absente du fichier source au dernier relevé", "Missing from the source file at the latest snapshot")">⚠ @L.T("Absente du fichier source", "Missing from the source file")</span> @L.T("depuis le relevé du", "since the snapshot of") @abs.ToString("d MMMM yyyy", fr). @L.T("Les chiffres ci-dessus sont ceux du dernier relevé où elle figurait.", "The figures above are from the last snapshot where it appeared.")</p>
    }
</section>

<h2 class="titre-section">@L.T("Constats", "Findings")</h2>
@if (Model.Anomalies.Count == 0)
{
    <p class="vide">@L.T("Aucun constat : le nombre de soutiens n'a pas baissé et la pétition n'a pas disparu du fichier depuis le début de l'historique.", "No finding: the number of supporters has not dropped and the petition has not left the file since the history began.")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>@L.T("Détecté le", "Detected on")</th><th>Type</th><th class="num">@L.T("Avant", "Before")</th><th class="num">@L.T("Après", "After")</th><th class="num">@L.T("Baisse", "Drop")</th></tr></thead>
            <tbody>
            @foreach (var a in Model.Anomalies)
            {
                <tr>
                    <td class="nowrap" data-label="@L.T("Détecté le", "Detected on")" title="@L.T("Relevé précédent : ", "Previous snapshot: ")@a.ReleveAvant.ToString("d MMM yyyy", fr)">@a.DetecteLe.ToString("d MMM yyyy", fr)</td>
                    <td data-label="Type"><span class="doute doute-incertain">⚠ @PetitionAnomaliesModel.TypeLibelle(a.Type, en)</span></td>
                    <td class="num" data-label="@L.T("Avant", "Before")">@(a.ValeurAvant?.ToString("N0", fr) ?? "—")</td>
                    <td class="num" data-label="@L.T("Après", "After")">@(a.ValeurApres?.ToString("N0", fr) ?? "—")</td>
                    <td class="num" data-label="@L.T("Baisse", "Drop")">@(a.Baisse is { } b ? b.ToString("N0", fr) + (a.BaissePct is { } p ? " (" + p.ToString("0.0", fr) + (en ? "%" : " %") + ")" : "") : "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (f.Chambre == "SENAT" && Model.Anomalies.Any(x => x.Type == "disparition"))
    {
        <p class="note-source">@L.TH("Selon les <a href=\"https://petitions.senat.fr/pages/terms-and-conditions\" rel=\"noopener\">conditions générales du Sénat</a>, une pétition retirée par son auteur est supprimée de la liste, et le Sénat peut en supprimer à tout moment ; il ne s'engage pas à en conserver de copie. Une fermeture aux signatures (suppression du compte de l'auteur, décision de la Conférence des présidents) n'est pas une suppression.", " Under the <a href=\"https://petitions.senat.fr/pages/terms-and-conditions\" rel=\"noopener\">Senate's terms of use</a>, a petition withdrawn by its author is removed from the list, and the Senate may delete petitions at any time; it does not commit to keeping a copy. Closing a petition to signatures (author's account deleted, decision of the Conference of Presidents) is not a deletion.")</p>
    }
}

<h2 class="titre-section">@L.T("Historique des relevés", "Snapshot history")</h2>
@if (gardes.Count == 0)
{
    <p class="vide">@L.T("Aucun relevé conservé pour cette pétition.", "No snapshot kept for this petition.")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>@L.T("Relevé du", "Snapshot of")</th><th class="num">@L.T("Soutiens", "Supporters")</th><th>@L.T("Statut publié", "Published status")</th></tr></thead>
            <tbody>
            @foreach (var r in gardes)
            {
                <tr>
                    <td class="nowrap" data-label="@L.T("Relevé du", "Snapshot of")">@r.ReleveLe.ToString("d MMM yyyy", fr)</td>
                    <td class="num" data-label="@L.T("Soutiens", "Supporters")">@(r.NbVotes?.ToString("N0", fr) ?? "—")</td>
                    <td data-label="@L.T("Statut publié", "Published status")">@PetitionsModel.StatutLibelle(r.Statut, en)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="note-source">@L.T($"{Model.Releves.Count} relevés conservés depuis le {Model.Releves[0].ReleveLe.ToString("d MMMM yyyy", fr)} ; seules les lignes où le nombre de soutiens ou le statut change sont listées, plus le premier et le dernier relevé.", $"{Model.Releves.Count} snapshots kept since {Model.Releves[0].ReleveLe.ToString("d MMMM yyyy", fr)}; only rows where supporters or status change are listed, plus the first and last snapshot.")</p>
}
