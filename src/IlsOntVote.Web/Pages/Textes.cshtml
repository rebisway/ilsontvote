@page "/textes"
@model TextesModel
@using IlsOntVote.Web.Models
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = Model.Resolutions ? L.T("resolutions") : Model.SitePays ? (L.Pays is "GB" or "IE" ? L.T("divisions") : L.T("votes-nominaux")) : L.T("scrutins");
    ViewData["Description"] = L.T("tous-les-scrutins-publics-de-l");
    var fr = L.Culture;
}

@if (Model.Resolutions)
{
    <h1 class="titre-page">@L.T("resolutions")</h1>
    <p class="chapo">@L.TH("votes-sur-des-propositions-de-resolution")</p>
}
else
{
    <h1 class="titre-page">@(Model.SitePays ? (L.Pays is "GB" or "IE" ? L.T("divisions") : L.T("votes-nominaux")) : L.T("scrutins"))</h1>
@* chapô des scrutins : voir plus bas *@
@if (L.Pays == "US")
{
    <p class="chapo">@L.T("les-votes-nominaux-de-la-chambre")</p>
}
else if (L.Pays == "CH")
{
    <p class="chapo">@L.T("les-votes-du-conseil-national-et")</p>
}
else if (L.Pays == "IE")
{
    <p class="chapo">@L.T("les-divisions-votes-nominaux-du-dail")</p>
}
else if (L.Pays == "CA")
{
    <p class="chapo">@L.T("textes-chapo-ca")</p>
}
else if (L.Pays == "IT")
{
    <p class="chapo">@L.T("les-votes-finaux-du-parlement-italien")</p>
}
else if (Model.SitePays)
{
    <p class="chapo">@L.T("les-votes-sur-l-ensemble-d")</p>
}
else
{
<p class="chapo">@L.TH("les-votes-sur-l-ensemble-d-d5c8")</p>
}
}

<form class="filtres filtres-auto filtres-liste" method="get" action="@L.Lien("/textes")">
    <input class="filtre" type="search" name="q" value="@Model.Recherche" placeholder="@L.T("chercher-un-texte-ex-retraites-finances")" aria-label="@L.T("chercher-un-texte")" />
    @if (!string.IsNullOrEmpty(Model.TexteId)) { <input type="hidden" name="texte" value="@Model.TexteId" /> }
    @if (Model.Resolutions) { <input type="hidden" name="nature" value="resolution" /> }
    @if (Model.SitePays && Model.ChambresSite.Length > 1)
    {
    <select name="chambre" aria-label="@L.T("chambre")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Chambre)">@L.T("toutes-les-chambres")</option>
        @foreach (var ch in Model.ChambresSite)
        {
            <option value="@Chambres.Filtre(ch)" selected="@(Model.Chambre == Chambres.Filtre(ch))">@L.Chambre(ch)</option>
        }
    </select>
    }
    @if (Model.ThemesListe.Count > 0)
    {
    <select name="theme" aria-label="@L.T("theme")" title="@L.T("theme-estime-d-apres-les-mots")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Theme)">@L.T("tous-les-themes")</option>
        @foreach (var th in Model.ThemesListe)
        {
            <option value="@th.Code" selected="@(Model.Theme == th.Code)">@L.Theme(th)</option>
        }
    </select>
    }
    @if (!Model.SitePays)
    {
    <select name="chambre" aria-label="@L.T("chambre-accd")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Chambre)">@L.T("assemblee-et-senat")</option>
        <option value="an" selected="@(Model.Chambre == "an")">@L.T("assemblee-nationale")</option>
        <option value="senat" selected="@(Model.Chambre == "senat")">@L.T("senat")</option>
        <option value="ue" selected="@(Model.Chambre == "ue")">@L.T("parlement-europeen")</option>
    </select>
    }
    <span class="periode"><label class="champ-date">@L.T("du") <input type="date" name="du" value="@Model.Du" aria-label="@L.T("du-date-de-debut")" /></label>
        <label class="champ-date">@L.T("au") <input type="date" name="au" value="@Model.Au" aria-label="@L.T("au-date-de-fin")" /></label></span>
    @if (Model.Chambre != "lords" || !Model.SitePays)
    {
    @if (L.Pays != "IE") {<label class="case"><input type="checkbox" name="portee" value="tout" checked="@Model.ToutAfficher" /> @(Model.SitePays ? (L.Pays is "GB" or "CA" ? L.T("amendements-motions-et-autres-divisions") : (L.Pays == "IT" ? L.T("questions-de-confiance-et-autres-votes") : L.T("amendements-cloture-et-motions-de-procedure"))) : L.T("amendements-et-articles"))</label>}
    }
    @* Tri : en-têtes de colonne (écran large) ou ces listes (téléphone). *@
    <select name="tri" class="tri-mobile" aria-label="@L.T("trier-par")">
        <option value="date" selected="@(Model.TriEffectif == "date")">@L.T("trier-date")</option>
        <option value="chambre" selected="@(Model.TriEffectif == "chambre")">@L.T("trier-chambre")</option>
        <option value="titre" selected="@(Model.TriEffectif == "titre")">@L.T("trier-texte")</option>
        <option value="resultat" selected="@(Model.TriEffectif == "resultat")">@L.T("trier-resultat")</option>
        <option value="pour" selected="@(Model.TriEffectif == "pour")">@L.T("trier-pour")</option>
        <option value="contre" selected="@(Model.TriEffectif == "contre")">@L.T("trier-contre")</option>
        <option value="abst" selected="@(Model.TriEffectif == "abst")">@L.T("trier-abstentions")</option>
    </select>
    <select name="sens" class="tri-mobile" aria-label="@L.T("sens-du-tri")">
        <option value="desc" selected="@Model.Decroissant">@L.T("decroissant")</option>
        <option value="asc" selected="@(!Model.Decroissant)">@L.T("croissant")</option>
    </select>
    <button type="submit" class="sans-js">@L.T("filtrer")</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@Model.LienSansFiltre" title="@L.T("effacer-le-filtre")" aria-label="@L.T("effacer-le-filtre")"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></svg></a> }
</form>

<div class="barre-liste">
    <p class="compte">@Model.Resultats.Total.ToString("N0", fr) @(Model.Resultats.Total > 1 ? L.T("plur-scrutin-pl-b7e1") : L.T("plur-scrutin-sg-866e"))</p>
    <p class="export">@L.T("exporter-ce-tableau")
        @foreach (var f in Exporteur.Formats)
        {
            <a href="@Model.Lien(format: f)" download>@f.ToUpperInvariant()</a>
        }
    </p>
</div>

@if (Model.Resultats.Lignes.Count == 0)
{
    <p class="vide">@L.T("aucun-resultat")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead>
                <tr>
                    @Model.Th("date", L.T("date"))
                    @Model.Th("chambre", L.T("chambre-accd"))
                    @Model.Th("titre", L.T("texte"))
                    @Model.Th("resultat", L.T("resultat"))
                    @Model.Th("pour", L.T("pour-2ecc"), "num")
                    @Model.Th("contre", L.T("contre-b885"), "num")
                    @Model.Th("abst", L.T("abst-29c5"), "num")
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Resultats.Lignes)
            {
                <tr>
                    <td class="nowrap" data-label="@L.T("date")"><time datetime="@s.DateScrutin.ToString("yyyy-MM-dd")">@s.DateScrutin.ToString("d MMM yyyy", fr)</time></td>
                    <td data-label="@L.T("chambre-accd")"><span class="chambre-tag @Chambres.ClasseTag(s.Chambre)">@L.ChambreCourt(s.Chambre)</span></td>
                    <td><a href="@L.Lien("/scrutin/" + s.Id)" title="@Titres.Info(s.TitreLangue(L.Anglais), s.InfobulleTitre(L))">@Titres.Court(s.TitreLangue(L.Anglais))</a></td>
                    <td data-label="@L.T("resultat")"><span class="sort @(s.Adopte ? "adopte" : "rejete")">@(s.Adopte ? L.T("adopte") : L.T("rejete"))</span> @if (s.Confiance) { <span class="tag-493" title="@L.T("confiance-infobulle")" tabindex="0">@L.T("confiance-etiquette")</span> }</td>
                    <td class="num" data-label="@L.T("pour-2ecc")">@s.NbPour</td><td class="num" data-label="@L.T("contre-b885")">@s.NbContre</td><td class="num" data-label="@L.T("abstentions")">@s.NbAbstentions</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Resultats.NbPages > 1)
    {
        <nav class="pagination" aria-label="@L.T("pagination")">
            @if (Model.Resultats.Page > 1) { <a href="@Model.Lien(page: Model.Resultats.Page - 1)" rel="prev">@L.T("precedent")</a> }
            <span>@L.T("page") @Model.Resultats.Page / @Model.Resultats.NbPages</span>
            @if (Model.Resultats.Page < Model.Resultats.NbPages) { <a href="@Model.Lien(page: Model.Resultats.Page + 1)" rel="next">@L.T("suivant")</a> }
        </nav>
    }
    <partial name="_LignesParPage" model="Model" />
}
