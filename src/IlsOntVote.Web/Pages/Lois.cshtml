@page "/lois"
@model LoisModel
@using IlsOntVote.Web.Models
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = L.T("lois-b08d", "Lois", "Laws");
    ViewData["Description"] = L.T("le-parcours-de-chaque-loi-votes", "Le parcours de chaque loi : votes de l'Assemblée et du Sénat, promulgation, parution au Journal officiel, décision du Conseil constitutionnel.", "The journey of each law: votes in the National Assembly and the Senate, promulgation, publication in the Official Journal, Constitutional Council decision.");
    var fr = L.Culture;
}

<h1 class="titre-page">@L.T("lois-b08d", "Lois", "Laws")</h1>
<p class="chapo">@L.T("le-parcours-de-chaque-texte-vote", "Le parcours de chaque texte voté : adoption par les assemblées, saisine et décision du Conseil constitutionnel, promulgation et parution au Journal officiel. Le statut est déduit des données officielles, il ne porte aucun jugement.", "The journey of each text voted: adoption by the chambers, referral to and decision of the Constitutional Council, promulgation and publication in the Official Journal. The status is deduced from official data and carries no judgement.")</p>

<form class="filtres filtres-auto filtres-liste filtres-lois" method="get" action="@L.Lien("/lois")">
    <input class="filtre" type="search" name="q" value="@Model.Recherche" placeholder="@L.T("chercher-une-loi-ex-retraites-immigration", "Chercher une loi (ex. retraites, immigration, finances…)", "Search a law (e.g. pensions, immigration, finance…)")" aria-label="@L.T("chercher-une-loi", "Chercher une loi", "Search a law")" />
    <select name="statut" aria-label="@L.T("statut", "Statut", "Status")">
        @foreach (var (cle, libelle, anglais) in LoisModel.Statuts)
        {
            <option value="@cle" selected="@((Model.Statut ?? "") == cle)">@L.T("statut-" + (cle == "" ? "tous" : cle), libelle, anglais)</option>
        }
    </select>
    @if (Model.ThemesListe.Count > 0)
    {
    <select name="theme" aria-label="@L.T("theme", "Thème", "Topic")" title="@L.T("theme-estime-d-apres-les-mots", "Thème estimé d'après les mots du titre : peut être inexact", "Topic estimated from the words of the title: may be inexact")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Theme)">@L.T("tous-les-themes", "Tous les thèmes", "All topics")</option>
        @foreach (var th in Model.ThemesListe)
        {
            <option value="@th.Code" selected="@(Model.Theme == th.Code)">@L.Theme(th)</option>
        }
    </select>
    }
    <select name="chambre" aria-label="@L.T("chambre-accd", "Chambre", "Chamber")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Chambre)">@L.T("assemblee-et-senat", "Assemblée et Sénat", "National Assembly and Senate")</option>
        <option value="an" selected="@(Model.Chambre == "an")">@L.T("votee-a-l-assemblee", "Votée à l'Assemblée", "Voted in the National Assembly")</option>
        <option value="senat" selected="@(Model.Chambre == "senat")">@L.T("votee-au-senat", "Votée au Sénat", "Voted in the Senate")</option>
    </select>
    <span class="periode"><label class="champ-date" title="@L.T("affiche-les-lois-dont-une-date", "Affiche les lois dont une date (vote, promulgation, Journal officiel, Conseil constitutionnel) est dans la période", "Shows the laws with a date (vote, promulgation, Official Journal, Constitutional Council) within the period")">@L.T("du", "Du", "From") <input type="date" name="du" value="@Model.Du" aria-label="@L.T("du-date-de-debut", "Du (date de début)", "From (start date)")" /></label>
        <label class="champ-date">@L.T("au", "au", "to") <input type="date" name="au" value="@Model.Au" aria-label="@L.T("au-date-de-fin", "Au (date de fin)", "To (end date)")" /></label></span>
    @* Le tri se choisit par les en-têtes de colonne (écran large) ou par ces deux listes (téléphone, où les en-têtes disparaissent). *@
    <select name="tri" class="tri-mobile" aria-label="@L.T("trier-par", "Trier par", "Sort by")">
        <option value="vote" selected="@(Model.TriEffectif == "vote")">@L.T("trier-dernier-vote", "Trier : dernier vote", "Sort: last vote")</option>
        <option value="titre" selected="@(Model.TriEffectif == "titre")">@L.T("trier-titre", "Trier : titre", "Sort: title")</option>
        <option value="statut" selected="@(Model.TriEffectif == "statut")">@L.T("trier-statut", "Trier : statut", "Sort: status")</option>
        <option value="promulgation" selected="@(Model.TriEffectif == "promulgation")">@L.T("trier-promulgation", "Trier : promulgation", "Sort: promulgation")</option>
        <option value="jo" selected="@(Model.TriEffectif == "jo")">@L.T("trier-parution-au-jo", "Trier : parution au JO", "Sort: Official Journal")</option>
        <option value="amendements" selected="@(Model.TriEffectif == "amendements")">@L.T("trier-amendements", "Trier : amendements", "Sort: amendments")</option>
        <option value="scrutins" selected="@(Model.TriEffectif == "scrutins")">@L.T("trier-nombre-de-votes", "Trier : nombre de votes", "Sort: number of votes")</option>
    </select>
    <select name="sens" class="tri-mobile" aria-label="@L.T("sens-du-tri", "Sens du tri", "Sort order")">
        <option value="desc" selected="@Model.Decroissant">@L.T("decroissant", "Décroissant", "Descending")</option>
        <option value="asc" selected="@(!Model.Decroissant)">@L.T("croissant", "Croissant", "Ascending")</option>
    </select>
    <button type="submit" class="sans-js">@L.T("filtrer", "Filtrer", "Filter")</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@Model.LienSansFiltre" title="@L.T("effacer-le-filtre", "Effacer le filtre", "Clear filter")" aria-label="@L.T("effacer-le-filtre", "Effacer le filtre", "Clear filter")"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></svg></a> }
</form>
@if (!string.IsNullOrEmpty(Model.Du) || !string.IsNullOrEmpty(Model.Au))
{
    <p class="note-source">@L.T("periode-lois-dont-au-moins-une", "Période : lois dont au moins une date (un des votes, la promulgation, la parution au Journal officiel, la saisine ou la décision du Conseil constitutionnel) tombe dans l'intervalle. Le parcours complet de chaque loi est dans sa fiche.", "Period: laws with at least one date (one of the votes, promulgation, publication in the Official Journal, referral to or decision of the Constitutional Council) within the interval. Each law's full journey is on its page.")</p>
}

<div class="barre-liste">
    <p class="compte">@Model.Resultats.Total.ToString("N0", fr) @(Model.Resultats.Total > 1 ? L.T("plur-loi-pl", " lois", " laws") : L.T("plur-loi-sg", " loi", " law"))</p>
    <p class="export">@L.T("exporter-ce-tableau", "Exporter ce tableau :", "Export this table:")
        @foreach (var f in Exporteur.Formats)
        {
            <a href="@Model.Lien(format: f)" download>@f.ToUpperInvariant()</a>
        }
    </p>
</div>

@if (Model.Resultats.Lignes.Count == 0)
{
    <p class="vide">@L.T("aucun-resultat", "Aucun résultat.", "No results.")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead>
                <tr>
                    @Model.Th("vote", L.T("dernier-vote", "Dernier vote", "Last vote"), "col-date")
                    @Model.Th("titre", L.T("loi", "Loi", "Law"), "col-titre")
                    @* Statut porte aussi les amendements (sous la puce) : deux liens de tri dans le même en-tête, sans colonne de plus. *@
                    <th scope="col" class="col-statut" aria-sort="@(Model.TriEffectif == "statut" ? (Model.Decroissant ? "descending" : "ascending") : Model.TriEffectif == "amendements" ? (Model.Decroissant ? "descending" : "ascending") : "none")">
                        <a class="tri @(Model.TriEffectif == "statut" ? "actif" : "")" href="@Model.Lien("statut", Model.TriEffectif == "statut" ? !Model.Decroissant : false)">@L.T("statut", "Statut", "Status")@(Model.TriEffectif == "statut" ? (Model.Decroissant ? " ▼" : " ▲") : "")</a>
                        <span class="note-source">/</span>
                        <a class="tri @(Model.TriEffectif == "amendements" ? "actif" : "")" href="@Model.Lien("amendements", Model.TriEffectif == "amendements" ? !Model.Decroissant : true)" title="@L.T("trier-par-nombre-d-amendements-deposes", "Trier par nombre d'amendements déposés", "Sort by number of amendments tabled")">@L.T("amend", "amend.", "amdts")@(Model.TriEffectif == "amendements" ? (Model.Decroissant ? " ▼" : " ▲") : "")</a>
                    </th>
                    @Model.Th("promulgation", L.T("promulgation", "Promulgation", "Promulgation"), "col-date")
                    @Model.Th("jo", L.T("parution-jo", "Parution JO", "Official Journal"), "col-date")
                    <th scope="col" class="col-liens">@L.T("liens", "Liens", "Links")</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model.Resultats.Lignes)
            {
                var st = t.Statut.Traduit(L.Anglais);
                <tr>
                    <td class="nowrap col-date" data-label="@L.T("dernier-vote", "Dernier vote", "Last vote")">@(t.DernierVote?.ToString("d MMM yy", fr))</td>
                    <td class="col-titre"><a href="@L.Lien("/texte/" + t.Id)" title="@Titres.Info(t.TitreLangue(L.Anglais), t.InfobulleTitre(L.Anglais))">@Titres.Court(t.TitreLangue(L.Anglais))</a></td>
                    <td class="col-statut" data-label="@L.T("statut", "Statut", "Status")">
                        <span class="statut @st.Classe" title="@st.Libelle">@st.Court</span>
                        @foreach (var c in new[] { t.EtatAnEn(L.Anglais), t.EtatSenatEn(L.Anglais) })
                        {
                            <span class="tag-ch @c.Classe" title="@c.Infobulle" tabindex="0">@c.Etiquette @c.Symbole</span>
                        }
                        @if (t.Adopte493)
                        {
                            <span class="tag-ch ch-493" title="@L.T("au-moins-une-lecture-de-ce", "Au moins une lecture de ce texte a été adoptée SANS VOTE sur le texte, par l'article 49, alinéa 3 de la Constitution : le Gouvernement engage sa responsabilité et le texte est considéré comme adopté sauf si une motion de censure est votée.", "At least one reading of this text was adopted WITHOUT A VOTE on the text, under article 49, paragraph 3 of the Constitution: the Government stakes its responsibility and the text is deemed adopted unless a censure motion passes.")" tabindex="0">49.3</span>
                        }
                        @if (t.NbAmendements is { } na)
                        {
                            // Officiel : effectif publié par l'Assemblée. L'infobulle donne le sort ; la dernière ligne est le seul chiffre calculé par nous.
                            var detail = L.Tf("loi-amendements-detail", "{0:N0} déposés à l'Assemblée (source officielle) : {1:N0} adoptés, {2:N0} rejetés ; les autres sont tombés, non soutenus, retirés, irrecevables ou sans sort publié.",
                                             "{0:N0} tabled in the National Assembly (official source): {1:N0} adopted, {2:N0} rejected; the rest fell, were not moved, withdrawn, inadmissible or have no published outcome.", na, t.NbAmendementsAdoptes, t.NbAmendementsRejetes)
                                     + (t.NbAmendementsScrutins > 0 ? L.Tf("loi-amendements-scrutins-calcules", " {0:N0} ont fait l'objet d'un scrutin public (calculé d'après les titres des scrutins).", " {0:N0} went to a recorded vote (computed from the vote titles).", t.NbAmendementsScrutins) : "");
                            <div class="amdts"><span title="@detail">@na.ToString("N0", fr) @(na > 1 ? L.T("plur-amendement-pl", "amendements", "amendments") : L.T("plur-amendement-sg", "amendement", "amendment"))</span></div>
                        }
                        else if (t.AmendementsManquants)
                        {
                            <div class="amdts"><span class="doute doute-manquant" title="@L.T("texte-examine-a-l-assemblee-avant", "Texte examiné à l'Assemblée avant la 16e législature : le jeu officiel des amendements ne le couvre pas.", "Text examined in the National Assembly before the 16th legislature: the official amendments dataset does not cover it.")">? amendements</span></div>
                        }
                        
                    </td>
                    <td class="nowrap col-date" data-label="Promulgation" title="@(string.IsNullOrEmpty(t.NumeroLoi) ? "" : L.T("loi-n", "Loi n° ", "Law no. ") + t.NumeroLoi)">@(t.DatePromulgation?.ToString("d MMM yy", fr))</td>
                    <td class="nowrap col-date" data-label="@L.T("parution-au-jo", "Parution au JO", "Official Journal")">@(t.DateJo?.ToString("d MMM yy", fr))</td>
                    <td class="col-liens liens" data-label="@L.T("liens", "Liens", "Links")">
                        @if (!string.IsNullOrEmpty(t.UrlLegifrance)) { <a href="@t.UrlLegifrance" rel="noopener" target="_blank" title="@L.T("texte-sur-legifrance", "Texte sur Légifrance", "Text on Légifrance")">Légifrance ↗</a> }
                        @if (!string.IsNullOrEmpty(t.UrlDossierSenat)) { <a href="@t.UrlDossierSenat" rel="noopener" target="_blank" title="@L.T("dossier-legislatif-du-senat", "Dossier législatif du Sénat", "Senate legislative file")">@L.T("dossier", "Dossier", "File") ↗</a> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Resultats.NbPages > 1)
    {
        <nav class="pagination" aria-label="@L.T("pagination", "Pagination", "Pagination")">
            @if (Model.Resultats.Page > 1) { <a href="@Model.Lien(page: Model.Resultats.Page - 1)" rel="prev">@L.T("precedent", "← Précédent", "← Previous")</a> }
            <span>@L.T("page", "Page", "Page") @Model.Resultats.Page / @Model.Resultats.NbPages</span>
            @if (Model.Resultats.Page < Model.Resultats.NbPages) { <a href="@Model.Lien(page: Model.Resultats.Page + 1)" rel="next">@L.T("suivant", "Suivant →", "Next →")</a> }
        </nav>
    }
    <partial name="_LignesParPage" model="Model" />
}

<p class="note-source">@L.T("le-rattachement-d-un-vote-a", "Le rattachement d'un vote à sa loi se fait par comparaison des intitulés : quand plusieurs textes portent le même, le vote reste sans loi plutôt que d'être attribué au hasard. Les décisions du Conseil constitutionnel et les dates de parution proviennent de la base du Sénat.", "A vote is linked to its law by comparing titles: when several texts share the same title, the vote is left unlinked rather than attributed at random. Constitutional Council decisions and publication dates come from the Senate's database. Law titles are shown in French, as published.")</p>
