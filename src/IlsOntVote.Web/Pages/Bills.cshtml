@page "/bills"
@model BillsModel
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = L.T("projets-de-loi-eb82");
    ViewData["Description"] = L.T("projets-de-loi-du-parlement-britannique");
    var fr = L.Culture;
    var tri = Model.TriEffectif;
    int N(string cle) => Model.ParStatut.Where(x => x.Cle == cle).Select(x => x.Nombre).FirstOrDefault();
}

<h1 class="titre-page">@L.T("projets-de-loi-eb82")</h1>
<p class="chapo">@L.TH("projets-de-loi-des-58e-et")</p>

@if (Model.ParStatut.Count > 0)
{
    <section class="definitions" aria-label="@L.T("chiffres")">
        <dl>
            <div><dt>@L.T("projets-de-loi-eb82")</dt><dd>@Model.ParStatut.Sum(x => x.Nombre).ToString("N0", fr) — @L.T("lois") @N("loi").ToString("N0", fr) · @L.T("en-cours") @N("en-cours").ToString("N0", fr) · @L.T("retires-ou-rejetes") @N("retire").ToString("N0", fr)</dd></div>
        </dl>
    </section>
}

<form class="filtres filtres-auto filtres-liste" method="get" action="@L.Lien("/bills")">
    <input class="filtre" type="search" name="q" value="@Model.Recherche" placeholder="@L.T("chercher-un-projet-de-loi")" aria-label="@L.T("chercher-un-projet-de-loi-44fd")" />
    <select name="statut" aria-label="@L.T("statut")">
        <option value="">@L.T("tous-les-statuts")</option>
        <option value="loi" selected="@(Model.Statut == "loi")">@L.T("lois-sanction-royale")</option>
        <option value="en-cours" selected="@(Model.Statut == "en-cours")">@L.T("en-cours-34e5")</option>
        <option value="retire" selected="@(Model.Statut == "retire")">@L.T("retires-ou-rejetes-c794")</option>
    </select>
    <select name="theme" aria-label="@L.T("theme")" title="@L.T("theme-estime-d-apres-les-mots")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Theme)">@L.T("tous-les-themes")</option>
        @foreach (var th in Model.ThemesListe)
        {
            <option value="@th.Code" selected="@(Model.Theme == th.Code)">@L.Theme(th)</option>
        }
    </select>
    <select name="chambre" aria-label="@L.T("chambre")">
        <option value="">@L.T("les-deux-chambres")</option>
        <option value="Commons" selected="@(Model.Chambre == "Commons")">@L.T("actuellement-aux-communes")</option>
        <option value="Lords" selected="@(Model.Chambre == "Lords")">@L.T("actuellement-aux-lords")</option>
    </select>
    <select name="tri" class="tri-mobile" aria-label="@L.T("trier-par")">
        <option value="maj" selected="@(tri == "maj")">@L.T("trier-derniere-mise-a-jour")</option>
        <option value="depot" selected="@(tri == "depot")">@L.T("trier-premiere-seance")</option>
        <option value="titre" selected="@(tri == "titre")">@L.T("trier-titre")</option>
        <option value="statut" selected="@(tri == "statut")">@L.T("trier-statut")</option>
        <option value="divisions" selected="@(tri == "divisions")">@L.T("trier-divisions")</option>
    </select>
    <select name="sens" class="tri-mobile" aria-label="@L.T("ordre-du-tri")">
        <option value="desc" selected="@Model.Decroissant">@L.T("decroissant")</option>
        <option value="asc" selected="@(!Model.Decroissant)">@L.T("croissant")</option>
    </select>
    <button type="submit" class="sans-js">@L.T("filtrer")</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@Model.LienSansFiltre" title="@L.T("effacer-le-filtre")" aria-label="@L.T("effacer-le-filtre")">✕</a> }
</form>

<div class="barre-liste">
    <p class="compte">@Model.Resultats.Total.ToString("N0", fr) @(Model.Resultats.Total > 1 ? L.T("plur-projet-de-loi-pl") : L.T("plur-projet-de-loi-sg"))</p>
    <p class="export">@L.T("exporter-ce-tableau")
        @foreach (var f in Exporteur.Formats) { <a href="@Model.Lien(format: f)" download>@f.ToUpperInvariant()</a> }
    </p>
</div>

@if (Model.Resultats.Lignes.Count == 0)
{
    <p class="vide">@L.T("aucun-projet-de-loi-ne-correspond")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead>
                <tr>
                    @Model.Th("depot", L.T("premiere-seance"), "col-date")
                    @Model.Th("titre", L.T("projet-de-loi"), "col-titre")
                    @Model.Th("statut", L.T("statut"), "col-statut")
                    <th scope="col">@L.T("chambre")</th>
                    @Model.Th("divisions", "Divisions", "num")
                    @Model.Th("maj", L.T("mis-a-jour"), "col-date")
                </tr>
            </thead>
            <tbody>
            @foreach (var b in Model.Resultats.Lignes)
            {
                <tr>
                    <td class="nowrap col-date" data-label="@L.T("premiere-seance")">@(b.DateDepot?.ToString("d MMM yyyy", fr) ?? "—")</td>
                    <td class="col-titre"><a href="@L.Lien("/bill/" + b.Id)">@b.Titre</a> <a class="note-source" href="@b.Url" rel="noopener" title="@L.T("page-du-projet-sur-bills-parliament")">↗</a></td>
                    <td class="col-statut" data-label="@L.T("statut")"><span class="puce-statut @BillsModel.StatutClasse(b)" title="@BillsModel.StatutLibelle(b, L)">@BillsModel.StatutCourt(b, L)</span></td>
                    <td data-label="@L.T("chambre")">@(b.ChambreCourante ?? "—")@if (b.ChambreOrigine is not null && b.ChambreOrigine != b.ChambreCourante) { <span class="note-source"> (@L.T("venu-de") @b.ChambreOrigine)</span> }</td>
                    <td class="num" data-label="@L.T("divisions")">@if (b.NbDivisions > 0) { <a href="@L.Lien("/bill/" + b.Id)" title="@L.T("divisions-rattachees-d-apres-le-titre")">@b.NbDivisions</a> } else { <span class="note-source">—</span> }</td>
                    <td class="nowrap col-date" data-label="@L.T("mis-a-jour")">@(b.DerniereMaj?.ToString("d MMM yyyy", fr) ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Resultats.NbPages > 1)
    {
        <nav class="pagination" aria-label="@L.T("pagination")">
            @if (Model.Resultats.Page > 1) { <a href="@Model.Lien(page: Model.Resultats.Page - 1)" rel="prev">@L.T("precedent")</a> }
            <span>@L.T("page") @Model.Resultats.Page / @Model.Resultats.NbPages</span>
            @if (Model.Resultats.Page < Model.Resultats.NbPages) { <a href="@Model.Lien(page: Model.Resultats.Page + 1)" rel="next">@L.T("suivant")</a> }
        </nav>
    }
    <partial name="_LignesParPage" model="Model" />
}
