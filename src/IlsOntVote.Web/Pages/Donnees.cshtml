<section class="definitions" id="sources" aria-label="@L.T("sources-et-licences")">
    <h2>@L.T("sources-et-conditions-de-reutilisation")</h2>
    @if (L.Pays == "CH")
    {
    <p>@L.THf("donnees-sources-suisse", L.Lien("/methodologie"))</p>
    }
    else if (L.Pays == "CA")
    {
    <p>@L.THf("donnees-sources-canada", L.Lien("/methodologie"))</p>
    <p>@L.THf("donnees-sources-canada-senat", L.Lien("/methodologie"))</p>
    }
    else if (L.Pays == "IE")
    {
    <p>@L.THf("donnees-sources-irlande", L.Lien("/methodologie"))</p>
    }
    else if (L.Pays == "IT")
    {
    <p>@L.THf("donnees-sources-italie", L.Lien("/methodologie"))</p>
    }
    else if (L.Pays == "US")
    {
    <p>@L.THf("donnees-sources-etats-unis", L.Lien("/methodologie"))</p>
    }
    else if (royaumeUni)
    {
    <p>@L.THf("donnees-sources-royaume-uni", L.Lien("/methodologie"))</p>
    }
