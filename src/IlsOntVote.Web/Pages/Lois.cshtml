@page "/lois"
@model LoisModel
@using IlsOntVote.Web.Models
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = L.T("lois-b08d");
    ViewData["Description"] = L.T("le-parcours-de-chaque-loi-votes");
    var fr = L.Culture;
}

<h1 class="titre-page">@L.T("lois-b08d")</h1>
<p class="chapo">@L.T("le-parcours-de-chaque-texte-vote")</p>

<form class="filtres filtres-auto filtres-liste filtres-lois" method="get" action="@L.Lien("/lois")">
    <input class="filtre" type="search" name="q" value="@Model.Recherche" placeholder="@L.T("chercher-une-loi-ex-retraites-immigration")" aria-label="@L.T("chercher-une-loi")" />
    <select name="statut" aria-label="@L.T("statut")">
        @foreach (var cle in LoisModel.Statuts)
        {
            <option value="@cle" selected="@((Model.Statut ?? "") == cle)">@L.T("statut-" + (cle == "" ? "tous" : cle))</option>
        }
    </select>
    @if (Model.ThemesListe.Count > 0)
    {
    <select name="theme" aria-label="@L.T("theme")" title="@L.T("theme-estime-d-apres-les-mots")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Theme)">@L.T("tous-les-themes")</option>
        @foreach (var th in Model.ThemesListe)
        {
            <option value="@th.Code" selected="@(Model.Theme == th.Code)">@L.Theme(th)</option>
        }
    </select>
    }
    <select name="chambre" aria-label="@L.T("chambre-accd")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Chambre)">@L.T("assemblee-et-senat")</option>
        <option value="an" selected="@(Model.Chambre == "an")">@L.T("votee-a-l-assemblee")</option>
        <option value="senat" selected="@(Model.Chambre == "senat")">@L.T("votee-au-senat")</option>
    </select>
    <span class="periode"><label class="champ-date" title="@L.T("affiche-les-lois-dont-une-date")">@L.T("du") <input type="date" name="du" value="@Model.Du" aria-label="@L.T("du-date-de-debut")" /></label>
        <label class="champ-date">@L.T("au") <input type="date" name="au" value="@Model.Au" aria-label="@L.T("au-date-de-fin")" /></label></span>
    @* Le tri se choisit par les en-têtes de colonne (écran large) ou par ces deux listes (téléphone, où les en-têtes disparaissent). *@
    <select name="tri" class="tri-mobile" aria-label="@L.T("trier-par")">
        <option value="vote" selected="@(Model.TriEffectif == "vote")">@L.T("trier-dernier-vote")</option>
        <option value="titre" selected="@(Model.TriEffectif == "titre")">@L.T("trier-titre")</option>
        <option value="statut" selected="@(Model.TriEffectif == "statut")">@L.T("trier-statut")</option>
        <option value="promulgation" selected="@(Model.TriEffectif == "promulgation")">@L.T("trier-promulgation")</option>
        <option value="jo" selected="@(Model.TriEffectif == "jo")">@L.T("trier-parution-au-jo")</option>
        <option value="amendements" selected="@(Model.TriEffectif == "amendements")">@L.T("trier-amendements")</option>
        <option value="scrutins" selected="@(Model.TriEffectif == "scrutins")">@L.T("trier-nombre-de-votes")</option>
    </select>
    <select name="sens" class="tri-mobile" aria-label="@L.T("sens-du-tri")">
        <option value="desc" selected="@Model.Decroissant">@L.T("decroissant")</option>
        <option value="asc" selected="@(!Model.Decroissant)">@L.T("croissant")</option>
    </select>
    <button type="submit" class="sans-js">@L.T("filtrer")</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@Model.LienSansFiltre" title="@L.T("effacer-le-filtre")" aria-label="@L.T("effacer-le-filtre")"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></svg></a> }
</form>
@if (!string.IsNullOrEmpty(Model.Du) || !string.IsNullOrEmpty(Model.Au))
{
    <p class="note-source">@L.T("periode-lois-dont-au-moins-une")</p>
}

<div class="barre-liste">
    <p class="compte">@Model.Resultats.Total.ToString("N0", fr) @(Model.Resultats.Total > 1 ? L.T("plur-loi-pl") : L.T("plur-loi-sg"))</p>
    <p class="export">@L.T("exporter-ce-tableau")
        @foreach (var f in Exporteur.Formats)
        {
            <a href="@Model.Lien(format: f)" download>@f.ToUpperInvariant()</a>
        }
    </p>
</div>

@if (Model.Resultats.Lignes.Count == 0)
{
    <p class="vide">@L.T("aucun-resultat")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead>
                <tr>
                    @Model.Th("vote", L.T("dernier-vote"), "col-date")
                    @Model.Th("titre", L.T("loi"), "col-titre")
                    @* Statut porte aussi les amendements (sous la puce) : deux liens de tri dans le même en-tête, sans colonne de plus. *@
                    <th scope="col" class="col-statut" aria-sort="@(Model.TriEffectif == "statut" ? (Model.Decroissant ? "descending" : "ascending") : Model.TriEffectif == "amendements" ? (Model.Decroissant ? "descending" : "ascending") : "none")">
                        <a class="tri @(Model.TriEffectif == "statut" ? "actif" : "")" href="@Model.Lien("statut", Model.TriEffectif == "statut" ? !Model.Decroissant : false)">@L.T("statut")@(Model.TriEffectif == "statut" ? (Model.Decroissant ? " ▼" : " ▲") : "")</a>
                        <span class="note-source">/</span>
                        <a class="tri @(Model.TriEffectif == "amendements" ? "actif" : "")" href="@Model.Lien("amendements", Model.TriEffectif == "amendements" ? !Model.Decroissant : true)" title="@L.T("trier-par-nombre-d-amendements-deposes")">@L.T("amend")@(Model.TriEffectif == "amendements" ? (Model.Decroissant ? " ▼" : " ▲") : "")</a>
                    </th>
                    @Model.Th("promulgation", L.T("promulgation"), "col-date")
                    @Model.Th("jo", L.T("parution-jo"), "col-date")
                    <th scope="col" class="col-liens">@L.T("liens")</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model.Resultats.Lignes)
            {
                var st = t.Statut.Traduit(L.Anglais);
                <tr>
                    <td class="nowrap col-date" data-label="@L.T("dernier-vote")">@(t.DernierVote?.ToString("d MMM yy", fr))</td>
                    <td class="col-titre"><a href="@L.Lien("/texte/" + t.Id)" title="@Titres.Info(t.TitreLangue(L.Anglais), t.InfobulleTitre(L.Anglais))">@Titres.Court(t.TitreLangue(L.Anglais))</a></td>
                    <td class="col-statut" data-label="@L.T("statut")">
                        <span class="statut @st.Classe" title="@st.Libelle">@st.Court</span>
                        @foreach (var c in new[] { t.EtatAnEn(L.Anglais), t.EtatSenatEn(L.Anglais) })
                        {
                            <span class="tag-ch @c.Classe" title="@c.Infobulle" tabindex="0">@c.Etiquette @c.Symbole</span>
                        }
                        @if (t.Adopte493)
                        {
                            <span class="tag-ch ch-493" title="@L.T("au-moins-une-lecture-de-ce")" tabindex="0">49.3</span>
                        }
                        @if (t.NbAmendements is { } na)
                        {
                            // Officiel : effectif publié par l'Assemblée. L'infobulle donne le sort ; la dernière ligne est le seul chiffre calculé par nous.
                            var detail = L.Tf("loi-amendements-detail", na, t.NbAmendementsAdoptes, t.NbAmendementsRejetes)
                                     + (t.NbAmendementsScrutins > 0 ? L.Tf("loi-amendements-scrutins-calcules", t.NbAmendementsScrutins) : "");
                            <div class="amdts"><span title="@detail">@na.ToString("N0", fr) @(na > 1 ? L.T("plur-amendement-pl") : L.T("plur-amendement-sg"))</span></div>
                        }
                        else if (t.AmendementsManquants)
                        {
                            <div class="amdts"><span class="doute doute-manquant" title="@L.T("texte-examine-a-l-assemblee-avant")">? amendements</span></div>
                        }
                        
                    </td>
                    <td class="nowrap col-date" data-label="Promulgation" title="@(string.IsNullOrEmpty(t.NumeroLoi) ? "" : L.T("loi-n") + t.NumeroLoi)">@(t.DatePromulgation?.ToString("d MMM yy", fr))</td>
                    <td class="nowrap col-date" data-label="@L.T("parution-au-jo")">@(t.DateJo?.ToString("d MMM yy", fr))</td>
                    <td class="col-liens liens" data-label="@L.T("liens")">
                        @if (!string.IsNullOrEmpty(t.UrlLegifrance)) { <a href="@t.UrlLegifrance" rel="noopener" target="_blank" title="@L.T("texte-sur-legifrance")">Légifrance ↗</a> }
                        @if (!string.IsNullOrEmpty(t.UrlDossierSenat)) { <a href="@t.UrlDossierSenat" rel="noopener" target="_blank" title="@L.T("dossier-legislatif-du-senat")">@L.T("dossier") ↗</a> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Resultats.NbPages > 1)
    {
        <nav class="pagination" aria-label="@L.T("pagination")">
            @if (Model.Resultats.Page > 1) { <a href="@Model.Lien(page: Model.Resultats.Page - 1)" rel="prev">@L.T("precedent")</a> }
            <span>@L.T("page") @Model.Resultats.Page / @Model.Resultats.NbPages</span>
            @if (Model.Resultats.Page < Model.Resultats.NbPages) { <a href="@Model.Lien(page: Model.Resultats.Page + 1)" rel="next">@L.T("suivant")</a> }
        </nav>
    }
    <partial name="_LignesParPage" model="Model" />
}

<p class="note-source">@L.T("le-rattachement-d-un-vote-a")</p>
