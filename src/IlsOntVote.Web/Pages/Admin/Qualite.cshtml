@page
@model IlsOntVote.Web.Pages.Admin.QualiteModel
@{
    ViewData["Title"] = "Qualité des données";
    ViewData["NoIndex"] = true;
}
<partial name="_AdminNav" />
<h1 class="titre-page">Qualité des données</h1>
<p class="chapo">Ce que le site sait ne pas savoir : chaque ligne est un doute ou un manque affiché au public.</p>

<div class="table-wrap">
    <table>
        <thead><tr><th>Contrôle</th><th class="num">Nombre</th><th>Pourquoi c'est important</th></tr></thead>
        <tbody>
            <tr><td>Scrutins au décompte incomplet</td><td class="num">@Model.ScrutinsIncomplets</td><td>Des « absents » peuvent avoir voté ; exclus de la une.</td></tr>
            <tr><td>Votes sur l'ensemble sans texte rattaché</td><td class="num">@Model.EnsemblesSansTexte</td><td>Rapprochement par titre ambigu ou introuvable.</td></tr>
            <tr><td>Mises au point sans position d'origine (Sénat)</td><td class="num">@Model.MisesAuPointSansOrigine</td><td>Étiquette « origine inconnue » affichée.</td></tr>
            <tr><td>Députés en exercice (doit rester ≤ 577)</td><td class="num">@Model.Sieges</td><td>Au-delà : mandats de suppléants mal datés.</td></tr>
        </tbody>
    </table>
</div>

<h2>Scrutins incomplets (50 plus récents)</h2>
<div class="table-wrap">
    <table>
        <thead><tr><th>Date</th><th>Chambre</th><th>Scrutin</th><th class="num">Votes manquants</th></tr></thead>
        <tbody>
        @foreach (var s in Model.Incomplets)
        {
            <tr><td class="nowrap">@s.DateScrutin.ToString("dd/MM/yyyy")</td><td>@s.Chambre</td><td><a href="/scrutin/@s.Id">@s.Titre</a></td><td class="num">@s.Manquants</td></tr>
        }
        </tbody>
    </table>
</div>
