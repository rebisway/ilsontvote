@page "/methodologie"
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = L.T("methodologie-et-limites", "Méthodologie et limites", "Methodology and limits");
    ViewData["Description"] = L.T("d-ou-viennent-les-donnees-d", "D'où viennent les données d'Ils ont voté, comment elles sont lues, ce qui est calculé par le site et ce qui reste incertain ou manquant.", "Where the data of Ils ont voté comes from, how it is read, what the site calculates and what remains uncertain or missing.");
}

@if (L.Pays == "US")
{
<h1 class="titre-page">@L.T("methodologie-et-limites", "Méthodologie et limites", "Methodology and limits")</h1>
<p class="chapo">@L.T("le-site-ne-juge-personne-il", "Le site ne juge personne : il affiche ce que la source publie. Quand une donnée est calculée, douteuse ou manquante, il le dit.", "The site judges no one: it displays what the source publishes. When a piece of data is calculated, doubtful or missing, it says so.")</p>

<section class="bloc-texte">
    <h2>@L.T("d-ou-viennent-les-donnees", "D'où viennent les données", "Where the data comes from")</h2>
    <ul>
        <li>@L.TH("chambre-des-representants-source-officielle", "<strong>Chambre des représentants</strong> : source <strong>officielle</strong>, les fichiers XML du <a href=\"https://clerk.house.gov/Votes\">greffe de la Chambre</a> (un par vote, avec les totaux officiels et le vote de chaque représentant). <strong>Sénat</strong> : <a href=\"https://voteview.com/\">Voteview</a> (UCLA et Université de Géorgie), projet universitaire <strong>tiers</strong> qui reprend les enregistrements du <a href=\"https://www.senate.gov/legislative/votes_new.htm\">Sénat</a>, car <code>senate.gov</code> refuse les accès automatiques. Les noms et partis des élus viennent aussi de Voteview. Chaque vote renvoie à son enregistrement officiel.", "<strong>House of Representatives</strong>: <strong>official</strong> source, the XML files of the <a href=\"https://clerk.house.gov/Votes\">Clerk of the House</a> (one per vote, with the official totals and each Representative's vote). <strong>Senate</strong>: <a href=\"https://voteview.com/\">Voteview</a> (UCLA and the University of Georgia), a <strong>third-party</strong> academic project that reprocesses the <a href=\"https://www.senate.gov/legislative/votes_new.htm\">Senate</a> records, because <code>senate.gov</code> refuses automated access. Members' names and parties also come from Voteview. Each vote links to its official record.")</li>
        <li>@L.TH("citation-demandee-par-voteview-pour-les", "<strong>Citation demandée par Voteview</strong> pour les données du Sénat, des noms et des partis : Lewis, Jeffrey B., Keith Poole, Howard Rosenthal, Adam Boche, Aaron Rudkin, and Luke Sonnet (2026). <em>Voteview: Congressional Roll-Call Votes Database</em>. https://voteview.com/", "<strong>Citation requested by Voteview</strong> for the Senate data, names and parties: Lewis, Jeffrey B., Keith Poole, Howard Rosenthal, Adam Boche, Aaron Rudkin, and Luke Sonnet (2026). <em>Voteview: Congressional Roll-Call Votes Database</em>. https://voteview.com/")</li>
        <li>@L.T("mise-a-jour-automatique-chaque-nuit", "Mise à jour automatique chaque nuit : les votes de moins de sept jours sont relus. Le code est un logiciel libre (GPL-3.0).", "Automatic update every night: votes less than seven days old are read again. The code is free software (GPL-3.0).")</li>
    </ul>
</section>

<section class="bloc-texte">
    <h2>@L.T("comment-se-lit-un-vote", "Comment se lit un vote", "How a vote is read")</h2>
    <ul>
        <li>@L.TH("pour-yea-contre-nay-present-tels", "<strong>Pour (yea), contre (nay), présent</strong> : tels que publiés. « Present » est affiché comme une abstention.", "<strong>For (yea), against (nay), present</strong>: as published. “Present” is shown as an abstention.")</li>
        <li>@L.TH("absent-l-elu-siegeait-a-la", "<strong>Absent</strong> : l'élu siégeait à la date du vote mais n'a pas voté (« not voting »). Le site ne donne <em>aucune raison</em>. Une position seulement <em>annoncée</em> ou un <em>appariement</em> n'est pas un vote et n'est pas compté : l'élu apparaît absent, et la note du vote le signale.", "<strong>Absent</strong>: the member was in office on the date of the vote but did not vote (“not voting”). The site gives <em>no reason</em>. A position that was only <em>announced</em>, or a <em>pair</em>, is not a vote and is not counted: the member appears absent, and the note of the vote says so.")</li>
        <li>@L.TH("mandats-la-source-n-a-pas", "<strong>Mandats</strong> : la source n'a pas d'annuaire daté. Un mandat va du premier au dernier vote nominal où l'élu figure dans la liste du Congrès (<strong>calculé par le site</strong>), un mandat par Congrès. Le Sénat compte 100 sièges.", "<strong>Mandates</strong>: the source has no dated directory. A mandate runs from the first to the last roll call in which the member appears in the Congress list (<strong>calculated by the site</strong>), one mandate per Congress. The Senate has 100 seats.")</li>
        <li>@L.T("parti-celui-de-l-elu-dans", "Parti : celui de l'élu dans le Congrès considéré, d'après la source.", "Party: the member's party in the Congress concerned, as given by the source.")</li>
    </ul>
</section>

<section class="bloc-texte">
    <h2>@L.T("calcule-par-le-site-non-publie", "Calculé par le site (non publié tel quel)", "Calculated by the site (not published as is)")</h2>
    <ul>
        <li>@L.T("le-resultat-adopte-rejete-reprend-le", "Le résultat « adopté / rejeté » reprend le texte de la source (« Passed », « Failed »…) ; sans résultat (élection du Président de la Chambre), rien n'est affiché.", "The “adopted / rejected” result follows the source's text (“Passed”, “Failed”…); with no result (election of the Speaker), nothing is shown.")</li>
        <li>@L.TH("vote-sur-l-ensemble-le-congres", "<strong>Vote sur l'ensemble</strong> : le Congrès ne distingue pas ces votes. Le site les repère d'après la question posée : adoption finale d'un projet ou d'une résolution, motion « suspend the rules and pass », confirmation d'une nomination. Amendements, clôture des débats (cloture) et motions de procédure n'en sont pas.", "<strong>Vote on the whole</strong>: Congress does not distinguish these votes. The site finds them from the question put: final passage of a bill or resolution, “suspend the rules and pass” motion, confirmation of a nomination. Amendments, cloture and procedural motions are not.")</li>
        <li>@L.T("majorite-requise-calculee-d-apres-la", "Majorité requise : calculée d'après la règle indiquée par la source (simple, trois cinquièmes, deux tiers) et les suffrages exprimés.", "Required majority: calculated from the rule given by the source (simple, three-fifths, two-thirds) and the votes cast.")</li>
        <li>@L.T("participation-parmi-les-elus-en-fonction", "Participation : parmi les élus en fonction à la date d'un vote, la part de ceux qui ont voté. Les autres sont absents.", "Participation: among the members in office on the date of a vote, the share who voted. The others are absent.")</li>
    </ul>
</section>

<section class="bloc-texte">
    <h2>@L.T("limites-connues", "Limites connues", "Known limits")</h2>
    <ul>
        <li>@L.TH("senat-decomptes-differents-dans-environ-un", "<strong>Sénat : décomptes différents</strong> : dans environ un vote sur sept, le décompte officiel diffère d'une voix de la liste de Voteview. Le site affiche le décompte officiel, les points suivent la liste, et la note du vote donne les deux chiffres. À la Chambre, source officielle, les totaux et la liste coïncident.", "<strong>Senate: counts that differ</strong>: in about one vote in seven, the official count differs by one from Voteview's member list. The site shows the official count, the dots follow the list, and the note of the vote gives both figures. In the House, an official source, totals and list agree.")</li>
        <li>@L.T("ne-figurent-pas-les-appels-de", "Ne figurent pas : les appels de quorum (« Call of the House ») et l'élection du Président de la Chambre, où chacun vote pour un nom de candidat et non pour ou contre.", "Not included: quorum calls (“Call of the House”) and the election of the Speaker, where each member votes for a candidate's name rather than yea or nay.")</li>
        <li>@L.T("historique-les-congres-de-la-periode", "Historique : les Congrès de la période chargée seulement (depuis 2001 quand l'historique est importé).", "History: only the Congresses of the loaded period (since 2001 once the history is imported).")</li>
        <li>@L.TH("pour-signaler-une-erreur-ecrivez-a", "Pour signaler une erreur, écrivez à <a href=\"mailto:contact@rebisway.com\">contact@rebisway.com</a>.", "To report an error, write to <a href=\"mailto:contact@rebisway.com\">contact@rebisway.com</a>.")</li>
    </ul>
</section>
}
