@page "/elus"
@model ElusModel
@using IlsOntVote.Web.Models
@using IlsOntVote.Web.Services
@{
    var lords = Model.ChambreCode == Chambres.Lords;
    var titreElus = lords ? L.T("participation-aux-votes-des-pairs") : L.Pays == "US" ? L.T("participation-aux-votes-des-elus-du") : L.Pays == "CH" ? L.T("participation-aux-votes-du-parlement-suisse") : L.Pays == "CA" ? L.T("elus-titre-ca") : L.Pays == "IE" ? L.T("participation-aux-votes-des-parlementaires-i") : L.Pays == "IT" ? L.T("participation-aux-votes-des-parlementaires-i-0aa4") : L.T("taux-de-presence-des-elus");
    ViewData["Title"] = titreElus;
    ViewData["Description"] = L.T("tous-les-elus-avec-leur-taux");
    var fr = L.Culture;
    string Pct(double? v) => v is null ? "—" : v.Value.ToString("0.0", fr) + (L.T("suffixe-pourcent"));
    var decalage = (Model.Resultats.Page - 1) * Model.Resultats.ParPage;
    var rang = decalage;
}

<h1 class="titre-page">@titreElus</h1>

<section class="definitions" aria-label="@L.T("definitions")">
    <p class="def-base">@L.TH("chaque-taux-est-calcule-sur-les")</p>
    @if (L.Pays == "IT") { <p class="note-source">@Doute.Html(NiveauDoute.Incertain, L.T("import-partiel"), L.T("seuls-les-votes-finaux-et-pour"))</p> }
    <dl>
        <div><dt>@L.T("participation-titre")</dt><dd>@L.T("un-vote-a-ete-exprime-pour")</dd></div>
        <div><dt>@L.T("presence")</dt><dd>@L.T("vote-exprime-par-l-elu-lui")</dd></div>
        <div><dt>@L.T("delegation")</dt><dd>@L.T("vote-exprime-par-un-collegue-a")</dd></div>
        <div><dt>@L.T("mise-au-point")</dt><dd>@L.T("position-rectifiee-apres-le-scrutin")</dd></div>
        <div><dt>@L.T("absence")</dt><dd>@L.T("aucun-vote-exprime-le-site-n")</dd></div>
    </dl>
    <p class="note-source">@L.T("les-non-votants-declares-par-l")</p>
</section>

<form class="filtres filtres-auto filtres-liste" method="get" action="@L.Lien("/elus")">
    <input class="filtre" type="search" name="q" value="@Model.Recherche" placeholder="@L.T("chercher-un-nom-ou-un-groupe")" aria-label="@L.T("chercher-un-elu")" />
    @if (L.Pays is not null)
    {
    @if (Model.ChambresSite.Length > 1)
    {
    <select name="chambre" aria-label="@L.T("chambre")">
        @foreach (var ch in Model.ChambresSite)
        {
            <option value="@Chambres.Filtre(ch)" selected="@(Model.ChambreCode == ch)">@L.Chambre(ch)</option>
        }
    </select>
    }
    }
    @if (L.Pays is null)
    {
    <select name="chambre" aria-label="@L.T("chambre-accd")">
        <option value="an" selected="@(Model.ChambreCle == "an")">@L.T("assemblee-nationale")</option>
        <option value="senat" selected="@(Model.ChambreCle == "senat")">@L.T("senat")</option>
        <option value="ue" selected="@(Model.ChambreCle == "ue")">@L.T("parlement-europeen")</option>
    </select>
    }
    <select name="periode" aria-label="@L.T("periode")">
        <option value="12m" selected="@(Model.PeriodeCle == "12m")">@L.T("12-derniers-mois")</option>
        <option value="annee" selected="@(Model.PeriodeCle == "annee")">@L.T("annee-en-cours")</option>
        <option value="tout" selected="@(Model.PeriodeCle == "tout")">@L.T("depuis-le-debut-des-donnees")</option>
        @if (Model.PeriodeCle == "perso") { <option value="12m" selected>@L.T("dates-choisies")</option> }
    </select>
    <span class="periode" title="@L.T("dates-precises-elles-remplacent-la-periode")">
        <label class="champ-date">@L.T("du") <input type="date" name="du" value="@Model.Du" aria-label="@L.T("du-date-de-debut")" /></label>
        <label class="champ-date">@L.T("au") <input type="date" name="au" value="@Model.Au" aria-label="@L.T("au-date-de-fin")" /></label>
    </span>
    <label class="case"><input type="checkbox" name="votants" value="1" checked="@Model.AvecVotes" /> @L.T("masquer-ceux-qui-n-ont-vote")</label>
    @* Les Lords n'ont pas de vote sur l'ensemble : option sans objet. *@
    @if (!lords)
    {
    <label class="case"><input type="checkbox" name="ensemble" value="1" checked="@Model.EnsembleSeul" /> @L.T("votes-sur-l-ensemble-d-un")</label>
    }
    @* Tri : en-têtes de colonne (écran large) ou ces listes (téléphone). *@
    <select name="tri" class="tri-mobile" aria-label="@L.T("trier-par")">
        <option value="nom" selected="@(Model.TriEffectif == "nom")">@L.T("trier-nom")</option>
        <option value="groupe" selected="@(Model.TriEffectif == "groupe")">@L.T("trier-groupe")</option>
        <option value="scrutins" selected="@(Model.TriEffectif == "scrutins")">@L.T("trier-scrutins")</option>
        <option value="participation" selected="@(Model.TriEffectif == "participation")">@L.T("trier-participation")</option>
        <option value="presence" selected="@(Model.TriEffectif == "presence")">@L.T("trier-presence")</option>
        <option value="delegation" selected="@(Model.TriEffectif == "delegation")">@L.T("trier-delegation")</option>
        <option value="mise_au_point" selected="@(Model.TriEffectif == "mise_au_point")">@L.T("trier-mise-au-point")</option>
        <option value="absence" selected="@(Model.TriEffectif == "absence")">@L.T("trier-absence")</option>
    </select>
    <select name="sens" class="tri-mobile" aria-label="@L.T("sens-du-tri")">
        <option value="desc" selected="@Model.Decroissant">@L.T("decroissant")</option>
        <option value="asc" selected="@(!Model.Decroissant)">@L.T("croissant")</option>
    </select>
    <button type="submit" class="sans-js">@L.T("filtrer")</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@L.Lien("/elus")" title="@L.T("effacer-le-filtre")" aria-label="@L.T("effacer-le-filtre")"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></svg></a> }
</form>

<p class="periode-rappel">@L.Chambre(Model.ChambreCode) · <strong>@Model.PeriodeLibelle</strong>@(Model.EnsembleSeul ? L.T("votes-sur-l-ensemble-seulement") : "")</p>
@if (Model.ChambreCode == Chambres.Lords)
{
    <p class="note-source">@Doute.Html(NiveauDoute.Incertain, L.T("absences-surestimees"), L.T("seuls-les-pairs-ayant-vote-sont")) @L.T("les-taux-des-lords-sont-a") @L.T("ces-taux-comptent-les-votes-exprimes")</p>
}

<div class="barre-liste">
    <p class="compte">@Model.Resultats.Total.ToString("N0", fr) @(Model.Resultats.Total > 1 ? L.T("plur-elu-pl") : L.T("plur-elu-sg"))</p>
    <p class="export">@L.T("exporter-ce-tableau")
        @foreach (var f in Exporteur.Formats) { <a href="@Model.Lien(format: f)" download>@f.ToUpperInvariant()</a> }
    </p>
</div>

@if (Model.Resultats.Lignes.Count == 0)
{
    <p class="vide">@L.T("aucun-elu-a-afficher-aucun-scrutin")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes table-elus">
            <thead>
                <tr>
                    <th scope="col" class="num" title="@L.T("rang-dans-le-tri-choisi")">#</th>
                    @Model.Th("nom", L.T("elu"))
                    @Model.Th("groupe", L.T("groupe"))
                    @Model.Th("scrutins", L.T("scrutins"), "num")
                    @Model.Th("participation", "Participation", "num")
                    @Model.Th("presence", L.T("presence"), "num")
                    @Model.Th("delegation", L.T("delegation"), "num")
                    @Model.Th("mise_au_point", L.T("mise-au-point"), "num")
                    @Model.Th("absence", L.T("absence"), "num")
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Resultats.Lignes)
            {
                rang++;
                <tr>
                    <td class="num rang" data-label="@L.T("rang")">@rang.ToString("N0", fr)</td>
                    <td data-label="@L.T("elu")"><a href="@L.Lien("/" + Chambres.Fiche(e.Chambre) + "/" + e.Slug)">@Noms.Html(e.Prenom, e.Nom)</a>@if (e.Statut is not null) { <text> </text>@Doute.Html(NiveauDoute.Incertain, StatutTexte.Libelle(e.Statut, L)!, L.T("statut-du-jour-d-apres-l")) }</td>
                    <td data-label="@L.T("groupe")"><span class="pastille" style="background:@(e.GroupeCouleur ?? "#8d949a")"></span> @(e.GroupeSigle ?? "—")</td>
                    <td data-label="@L.T("scrutins")" class="num">@e.Scrutins.ToString("N0", fr)</td>
                    <td data-label="@L.T("participation-titre")" class="num" title="@e.Votants.ToString("N0", fr) / @e.Scrutins.ToString("N0", fr)">@Pct(e.ParticipationPct)</td>
                    <td data-label="@L.T("presence")" class="num" title="@((e.Votants - e.Delegations).ToString("N0", fr)) / @e.Scrutins.ToString("N0", fr)">@Pct(e.PresencePct)</td>
                    <td data-label="@L.T("delegation")" class="num" title="@e.Delegations.ToString("N0", fr) / @e.Scrutins.ToString("N0", fr)">@Pct(e.DelegationPct)</td>
                    <td data-label="@L.T("mise-au-point")" class="num" title="@e.MisesAuPoint.ToString("N0", fr) / @e.Scrutins.ToString("N0", fr)">@Pct(e.MiseAuPointPct)</td>
                    <td data-label="@L.T("absence")" class="num" title="@((e.Scrutins - e.Votants).ToString("N0", fr)) / @e.Scrutins.ToString("N0", fr)">@Pct(e.AbsencePct)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Resultats.NbPages > 1)
    {
        <nav class="pagination" aria-label="@L.T("pagination")">
            @if (Model.Resultats.Page > 1) { <a href="@Model.Lien(page: Model.Resultats.Page - 1)" rel="prev">@L.T("precedent")</a> }
            <span>@L.T("page") @Model.Resultats.Page / @Model.Resultats.NbPages</span>
            @if (Model.Resultats.Page < Model.Resultats.NbPages) { <a href="@Model.Lien(page: Model.Resultats.Page + 1)" rel="next">@L.T("suivant")</a> }
        </nav>
    }
    <partial name="_LignesParPage" model="Model" />
}
