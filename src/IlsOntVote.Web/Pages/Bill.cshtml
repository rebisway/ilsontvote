@page "/bill/{id:long}"
@model BillModel
@using IlsOntVote.Web.Repositories
@using IlsOntVote.Web.Services
@{
    var b = Model.Fiche;
    ViewData["Title"] = b.Titre.Length > 70 ? b.Titre[..70] + "…" : b.Titre;
    ViewData["Description"] = L.T("etapes-d-un-projet-de-loi", "Étapes d'un projet de loi du Parlement britannique et divisions des Communes qui lui sont rattachées.", "Stages of a bill before the UK Parliament and the Commons divisions linked to it.");
    var fr = L.Culture;
}

<p class="chapo"><a href="@L.Lien("/bills")">@L.T("projets-de-loi", "← Projets de loi", "← Bills")</a></p>
<h1 class="titre-page">@b.Titre</h1>
@if (b.TitreLong is not null) { <p class="note-source">@b.TitreLong</p> }

<section class="definitions fiche-petition @BillsModel.StatutClasse(b)" aria-label="@L.T("details", "Détails", "Details")">
    <dl>
        <div><dt>@L.T("statut", "Statut", "Status")</dt><dd><span class="puce-statut @BillsModel.StatutClasse(b)">@BillsModel.StatutLibelle(b, L)</span></dd></div>
        @if (b.ChambreOrigine is not null) { <div><dt>@L.T("depose-a", "Déposé à", "Introduced in")</dt><dd>@(b.ChambreOrigine == "Commons" ? L.T("la-chambre-des-communes", "la Chambre des Communes", "the Commons") : L.T("la-chambre-des-lords", "la Chambre des Lords", "the Lords"))</dd></div> }
        @if (b.ChambreCourante is not null) { <div><dt>@L.T("actuellement-a", "Actuellement à", "Now in")</dt><dd>@(b.ChambreCourante == "Commons" ? L.T("la-chambre-des-communes", "la Chambre des Communes", "the Commons") : L.T("la-chambre-des-lords", "la Chambre des Lords", "the Lords"))</dd></div> }
        @if (b.DateDepot is { } dd) { <div><dt>@L.T("premiere-seance", "Première séance", "First sitting")</dt><dd>@dd.ToString("d MMMM yyyy", fr)</dd></div> }
        @if (b.DateLoi is { } dl) { <div><dt>@L.T("sanction-royale", "Sanction royale", "Royal Assent")</dt><dd>@dl.ToString("d MMMM yyyy", fr)</dd></div> }
        @if (b.RetireLe is { } rl) { <div><dt>@L.T("retire-le", "Retiré le", "Withdrawn on")</dt><dd>@rl.ToString("d MMMM yyyy", fr)</dd></div> }
        <div><dt>@L.T("source", "Source", "Source")</dt><dd><a href="@b.Url" rel="noopener">bills.parliament.uk</a></dd></div>
    </dl>
    <div class="liens-externes">
        <a class="raccourci" href="@b.Url" rel="noopener" target="_blank">@L.T("texte-du-projet", "Texte du projet", "Bill text") ↗</a>
        @{ var promptIA = PromptResume.Construire(L.Anglais, b.Titre, new[] { b.Url }); }
        <partial name="_ResumeIA" model="promptIA" />
    </div>
</section>

<h2 class="titre-section">@L.T("etapes", "Étapes", "Stages")</h2>
@if (Model.Etapes.Count == 0)
{
    <p class="vide">@L.T("aucune-etape-publiee-pour-ce-projet", "Aucune étape publiée pour ce projet pour l'instant.", "No stage published for this bill yet.")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>Date</th><th>@L.T("chambre", "Chambre", "House")</th><th>@L.T("etape", "Étape", "Stage")</th></tr></thead>
            <tbody>
            @foreach (var e in Model.Etapes)
            {
                <tr>
                    <td class="nowrap" data-label="Date">@if (e.DateSeance is { } d) { @d.ToString("d MMM yyyy", fr) } else { <span class="doute doute-manquant" title="@L.T("la-source-ne-donne-pas-de", "La source ne donne pas de date de séance pour cette étape (pas encore tenue, ou non publiée).", "The source gives no sitting date for this stage (not held yet, or not published).")">?</span> }</td>
                    <td data-label="@L.T("chambre", "Chambre", "House")">@(e.Chambre ?? "—")</td>
                    <td data-label="@L.T("etape", "Étape", "Stage")">@e.Libelle</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h2 class="titre-section">@L.T("divisions-aux-communes", "Divisions aux Communes", "Divisions in the Commons")</h2>
<p class="note-source">@L.T("rattachees-par-ce-site-d-apres", "Rattachées par ce site d'après le titre de la division (calculé, non publié par le Parlement). Les votes à main levée ne laissent aucun vote individuel et n'apparaissent pas.", "Linked by this site from the division title (computed, not published by Parliament). Votes on the voices leave no individual vote and do not appear.")</p>
@if (Model.Divisions.Count == 0)
{
    <p class="vide">@L.T("aucune-division-n-est-rattachee-a", "Aucune division n'est rattachée à ce projet.", "No division is linked to this bill.")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>Date</th><th>Division</th><th>@L.T("resultat", "Résultat", "Result")</th><th class="num">@L.T("pour", "Pour", "Aye")</th><th class="num">@L.T("contre", "Contre", "No")</th></tr></thead>
            <tbody>
            @foreach (var d in Model.Divisions)
            {
                <tr>
                    <td class="nowrap" data-label="Date">@d.DateScrutin.ToString("d MMM yyyy", fr)</td>
                    <td data-label="Division"><a href="@L.Lien("/scrutin/" + d.Id)">@(d.BillEtape ?? d.Titre)</a></td>
                    <td data-label="@L.T("resultat", "Résultat", "Result")">@(d.Sort is null ? "—" : d.Sort.StartsWith("adopt") ? L.T("adopte", "✓ Adopté", "✓ Adopted") : L.T("rejete", "✗ Rejeté", "✗ Rejected"))</td>
                    <td class="num" data-label="@L.T("pour", "Pour", "Aye")">@(d.NbPour?.ToString("N0", fr) ?? "—")</td>
                    <td class="num" data-label="@L.T("contre", "Contre", "No")">@(d.NbContre?.ToString("N0", fr) ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
