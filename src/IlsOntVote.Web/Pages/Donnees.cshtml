@page "/donnees"
@inject IlsOntVote.Web.Services.DonneesOuvertes Donnees
@{
    ViewData["Title"] = L.T("Données ouvertes", "Open data");
    ViewData["Description"] = L.T("Téléchargez toutes les données du site : scrutins, vote de chaque élu, élus, textes de loi (CSV compressés, mis à jour chaque nuit).", "Download all the site's data: votes, each official's vote, officials, laws (compressed CSV, updated every night).");
    var fr = L.Culture;
    // Chaque site ne propose que les fichiers de SON pays (manifeste : « FR » = France et Union européenne, « GB » = fichiers gb_…).
    var paysSite = L.Pays ?? "FR";
    var fichiers = Donnees.Lire().Where(f => f.Pays == paysSite).ToList();
    var royaumeUni = L.Pays == "GB";
    string Taille(long o) => o >= 1_048_576 ? (o / 1_048_576.0).ToString("0.#", fr) + " Mo" : Math.Max(1, o / 1024).ToString("N0", fr) + " Ko";
}

<h1 class="titre-page">@L.T("Données ouvertes", "Open data")</h1>
<p class="chapo">@L.TH("Toutes les données affichées sur le site, en fichiers <strong>CSV compressés (gzip)</strong>, régénérés chaque nuit. Séparateur virgule, encodage UTF-8, une ligne d'en-tête ; les dates sont au format AAAA-MM-JJ et les booléens valent <code>t</code> ou <code>f</code>.", "All the data shown on the site, as <strong>compressed CSV files (gzip)</strong>, regenerated every night. Comma-separated, UTF-8, one header row; dates are YYYY-MM-DD and booleans are <code>t</code> or <code>f</code>.")</p>

@if (L.Pays == "US")
{
    <p class="note-source">@L.TH("Ces fichiers ne contiennent que les données des États-Unis (Chambre des représentants et Sénat) : leur nom commence par <code>us_</code>. Les votes nominaux sont dans <code>us_scrutins</code>, les votes individuels dans <code>us_votes</code> ; les absents ne sont pas stockés (ils se déduisent des mandats).", "These files only contain data for the United States (House of Representatives and Senate): their name starts with <code>us_</code>. Roll call votes are in <code>us_scrutins</code>, individual votes in <code>us_votes</code>; absent members are not stored (they are deduced from the mandates).")</p>
}
else if (royaumeUni)
{
    <p class="note-source">@L.TH("Ces fichiers ne contiennent que les données du Royaume-Uni (Chambre des Communes, Chambre des Lords, pétitions, projets de loi) : leur nom commence par <code>gb_</code>. Les divisions sont dans <code>gb_scrutins</code>, les votes individuels dans <code>gb_votes</code> ; les absents ne sont pas stockés (ils se déduisent des mandats).", "These files only contain data for the United Kingdom (House of Commons, House of Lords, petitions, bills): their name starts with <code>gb_</code>. Divisions are in <code>gb_scrutins</code>, individual votes in <code>gb_votes</code>; absent members are not stored (they are deduced from the mandates).")</p>
}

@if (fichiers.Count == 0)
{
    <p class="vide">@L.T("Les fichiers ne sont pas encore générés.", "The files have not been generated yet.")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>@L.T("Fichier", "File")</th><th>@L.T("Contenu", "Content")</th><th class="num">@L.T("Lignes", "Rows")</th><th class="num">@L.T("Taille", "Size")</th><th>@L.T("Mis à jour", "Updated")</th></tr></thead>
            <tbody>
            @foreach (var f in fichiers)
            {
                <tr>
                    <td data-label="@L.T("Fichier", "File")"><a href="@L.Lien("/donnees/fichier/" + f.Fichier)" download>@f.Fichier</a><br /><span class="note-source" title="SHA-256">@(f.Sha256[..Math.Min(16, f.Sha256.Length)])…</span></td>
                    <td data-label="@L.T("Contenu", "Content")">@(L.Anglais ? DescriptionsDonnees.Anglais(f.Fichier) ?? f.Description : f.Description)</td>
                    <td class="num" data-label="@L.T("Lignes", "Rows")">@f.Lignes.ToString("N0", fr)</td>
                    <td class="num" data-label="@L.T("Taille", "Size")">@Taille(f.Octets)</td>
                    <td class="nowrap" data-label="@L.T("Mis à jour", "Updated")">@f.GenereLe.ToString("d MMM yyyy", fr)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<section class="definitions" aria-label="@L.T("Lire les fichiers", "Reading the files")">
    <h2>@L.T("Comment lire les fichiers", "How to read the files")</h2>
    @if (L.Pays == "US")
    {
    <dl>
        <div><dt>us_votes</dt><dd>@L.TH("une ligne par élu et par vote nominal où il s'est exprimé : <code>position</code> = pour (yea), contre (nay) ou abstention (« present »). Les non-votants et les positions seulement annoncées ou appariées n'y figurent pas.", "one row per member and roll call where they voted: <code>position</code> = pour (yea), contre (nay) or abstention (“present”). Not voting members and merely announced or paired positions are not included.")</dd></div>
        <div><dt>@L.T("absents", "absentees")</dt><dd>@L.TH("<strong>Les absents ne sont pas dans <code>us_votes</code></strong> : ils se déduisent. Un élu est absent à un vote s'il avait un mandat en cours à sa date (fichier <code>us_mandats</code>, dont <code>legislature</code> est le numéro du Congrès) et n'a pas de ligne dans <code>us_votes</code>.", "<strong>Absentees are not in <code>us_votes</code></strong>: they are deduced. A member is absent from a roll call if they held a mandate on its date (file <code>us_mandats</code>, whose <code>legislature</code> is the Congress number) and have no row in <code>us_votes</code>.")</dd></div>
        <div><dt>us_scrutins</dt><dd>@L.TH("<code>nb_pour</code>, <code>nb_contre</code> : décompte OFFICIEL ; il peut différer d'une voix de la liste des élus (le champ <code>note</code> le dit). <code>sur_ensemble</code> : adoption finale, nomination ou « suspend the rules and pass » (<strong>calculé</strong> d'après la question). <code>type_vote_libelle</code> : la question posée ; <code>suffrages_requis</code> : calculé d'après la règle de majorité ; <code>url_officielle</code> : enregistrement officiel du vote.", "<code>nb_pour</code>, <code>nb_contre</code>: OFFICIAL count; it can differ by one from the member list (the <code>note</code> field says so). <code>sur_ensemble</code>: final passage, nomination or “suspend the rules and pass” (<strong>calculated</strong> from the question). <code>type_vote_libelle</code>: the question put; <code>suffrages_requis</code>: calculated from the majority rule; <code>url_officielle</code>: official record of the vote.")</dd></div>
        <div><dt>chambre</dt><dd>USHOUSE (@L.T("Chambre des représentants", "House of Representatives")), USSENATE (@L.T("Sénat des États-Unis", "United States Senate")).</dd></div>
    </dl>
    }
    else
    {
    @if (royaumeUni)
    {
    <dl>
        <div><dt>gb_votes</dt><dd>@L.TH("une ligne par membre et par division où il a voté : <code>position</code> = pour (aye ou content), contre (no ou not content) ou abstention (membre présent dans les deux couloirs aux Communes). <code>par_delegation</code> : vote par procuration (Communes).", "one row per member and division where they voted: <code>position</code> = pour (aye or content), contre (no or not content) or abstention (member listed in both lobbies in the Commons). <code>par_delegation</code>: proxy vote (Commons).")</dd></div>
        <div><dt>@L.T("absents", "absentees")</dt><dd>@L.TH("<strong>Les absents ne sont pas dans <code>gb_votes</code></strong> : ils se déduisent. Un membre est absent à une division s'il avait un mandat en cours à sa date (fichier <code>gb_mandats</code>) et n'a pas de ligne dans <code>gb_votes</code>. Aux Lords, un pair en congé ou suspendu ne se distingue pas d'un absent. Les divisions où <code>nominatif_incomplet</code> vaut <code>t</code> ont une liste plus courte que le décompte officiel : n'en déduisez pas d'absents.", "<strong>Absentees are not in <code>gb_votes</code></strong>: they are deduced. A member is absent from a division if they held a mandate on its date (file <code>gb_mandats</code>) and have no row in <code>gb_votes</code>. In the Lords, a peer on leave of absence or suspended cannot be told apart from an absent one. Divisions where <code>nominatif_incomplet</code> is <code>t</code> have a list shorter than the official count: do not deduce absentees from them.")</dd></div>
        <div><dt>gb_scrutins</dt><dd>@L.TH("<code>sur_ensemble</code> : division de troisième lecture aux Communes (vote sur l'ensemble du projet, <strong>calculé</strong> d'après le titre ; jamais vrai aux Lords). <code>bill_id</code>, <code>bill_etape</code> : projet de loi et étape rattachés d'après le titre (<strong>calculé</strong>, vide si non rattaché). <code>sort</code> est calculé d'après les décomptes officiels.", "<code>sur_ensemble</code>: third-reading division in the Commons (vote on the whole bill, <strong>calculated</strong> from the title; never true in the Lords). <code>bill_id</code>, <code>bill_etape</code>: bill and stage linked from the title (<strong>calculated</strong>, empty when not linked). <code>sort</code> is computed from the official counts.")</dd></div>
        <div><dt>gb_bills, gb_bill_etapes</dt><dd>@L.TH("projets de loi du Parlement britannique (sessions 35 à 40) et leurs étapes dans chaque chambre, tels que publiés par bills-api.parliament.uk.", "bills of the UK Parliament (sessions 35 to 40) and their stages in each house, as published by bills-api.parliament.uk.")</dd></div>
        <div><dt>gb_petitions</dt><dd>@L.TH("pétitions de petition.parliament.uk (plateforme <code>UK</code>) telles que publiées : statut, soutiens, réponse du gouvernement et débat. <code>gb_petitions_historique</code> : un relevé quotidien ; <code>gb_petitions_anomalies</code> : baisses de soutiens, disparitions.", "petitions from petition.parliament.uk (platform <code>UK</code>) as published: status, supporters, government response and debate. <code>gb_petitions_historique</code>: one daily reading; <code>gb_petitions_anomalies</code>: drops in supporters, disappearances.")</dd></div>
        <div><dt>chambre</dt><dd>COMMONS (@L.T("Chambre des Communes", "House of Commons")), LORDS (@L.T("Chambre des Lords", "House of Lords")).</dd></div>
    </dl>
    }
    else
    {
    <dl>
        <div><dt>votes</dt><dd>@L.TH("une ligne par élu et par scrutin public où il a une position : <code>position</code> = pour, contre, abstention ou non_votant. <code>par_delegation</code> : un collègue a voté pour lui. <code>rectifie</code> : position corrigée après le scrutin (<code>position_origine</code> = position publiée au scrutin, vide si absent à l'origine ; <code>origine_inconnue</code> au Sénat).", "one row per official and public vote where they have a position: <code>position</code> = pour, contre, abstention or non_votant. <code>par_delegation</code>: a colleague voted for them. <code>rectifie</code>: position corrected after the vote (<code>position_origine</code> = position published at the vote, empty if absent originally; <code>origine_inconnue</code> in the Senate).")</dd></div>
        <div><dt>@L.T("absents", "absentees")</dt><dd>@L.TH("<strong>Les absents ne sont pas dans <code>votes</code></strong> : ils se déduisent. Un élu est absent à un scrutin s'il avait un mandat en cours à sa date (fichier <code>mandats</code> ; pour l'Assemblée et le Parlement européen, la législature du scrutin doit être celle du mandat) et n'a pas de ligne dans <code>votes</code>. Les scrutins où <code>nominatif_incomplet</code> vaut <code>t</code> ont un décompte nominatif plus court que le total officiel : n'en déduisez pas d'absents.", "<strong>Absentees are not in <code>votes</code></strong>: they are deduced. An official is absent from a vote if they held a mandate on its date (file <code>mandats</code>; for the Assembly and the European Parliament the vote's legislature must match the mandate's) and have no row in <code>votes</code>. Votes where <code>nominatif_incomplet</code> is <code>t</code> have a shorter individual count than the official total: do not deduce absentees from them.")</dd></div>
        <div><dt>scrutins</dt><dd>@L.TH("<code>sur_ensemble</code> : vote sur l'ensemble d'un texte (sinon amendement, article…). <code>texte_id</code> : texte de loi dont c'est le vote sur l'ensemble ; <code>texte_lie_id</code> : texte cité par un amendement ou un article. <strong>Ces rattachements sont calculés par le site</strong> d'après les titres et les dates : ils peuvent manquer ou se tromper. <code>titre_fr_auto</code> / <code>titre_en_auto</code> : le titre est une traduction automatique.", "<code>sur_ensemble</code>: vote on the whole text (otherwise amendment, article…). <code>texte_id</code>: law whose vote on the whole text this is; <code>texte_lie_id</code>: law cited by an amendment or an article. <strong>These links are computed by the site</strong> from titles and dates: they may be missing or wrong. <code>titre_fr_auto</code> / <code>titre_en_auto</code>: the title is a machine translation.")</dd></div>
        <div><dt>texte_etapes</dt><dd>@L.TH("décisions de séance publique sur un texte, à l'Assemblée et au Sénat, <strong>avec ou sans scrutin public</strong> (<code>sans_scrutin_public</code> = vote à main levée : le détail nominatif n'existe pas). <code>article_49_3</code> : adopté sans vote par l'article 49, alinéa 3.", "public-session decisions on a text, in the Assembly and the Senate, <strong>with or without a roll-call vote</strong> (<code>sans_scrutin_public</code> = show of hands: no individual detail exists). <code>article_49_3</code>: adopted without a vote under article 49, paragraph 3.")</dd></div>
        <div><dt>amendements_dossiers</dt><dd>@L.TH("amendements déposés à l'Assemblée par dossier législatif (<code>dossier_an</code>, lié à <code>texte_etapes</code>) : <code>deposes</code> et sort publié par la source (<code>adoptes</code>, <code>rejetes</code>, <code>tombes</code>, <code>non_soutenus</code>, <code>retires</code>, <code>irrecevables</code>) ; le reste est sans sort publié. 16e et 17e législatures.", "amendments tabled in the National Assembly per legislative file (<code>dossier_an</code>, linked to <code>texte_etapes</code>): <code>deposes</code> and the outcome published by the source (<code>adoptes</code>, <code>rejetes</code>, <code>tombes</code>, <code>non_soutenus</code>, <code>retires</code>, <code>irrecevables</code>); the rest has no published outcome. 16th and 17th legislatures.")</dd></div>
        <div><dt>petitions</dt><dd>@L.TH("pétitions déposées sur petitions.senat.fr et petitions.assemblee-nationale.fr (colonne <code>chambre</code>, identifiants de l'Assemblée préfixés « AN- »), telles que publiées (statut et nombre de soutiens de citoyens). <code>petitions_historique</code> : un relevé (date, soutiens, statut) par import, jamais effacé. <code>petitions_anomalies</code> : constats entre deux relevés (<code>baisse</code>, <code>disparition</code>, <code>reapparition</code>), sans cause connue.", "petitions filed on petitions.senat.fr and petitions.assemblee-nationale.fr (<code>chambre</code> column, Assembly ids prefixed “AN-”), as published (status and number of citizen supporters). <code>petitions_historique</code>: one snapshot (date, supporters, status) per import, never deleted. <code>petitions_anomalies</code>: findings between two snapshots (<code>baisse</code> = drop, <code>disparition</code> = missing, <code>reapparition</code> = back), no known cause.")</dd></div>
        <div><dt>chambre</dt><dd>AN (@L.T("Assemblée nationale", "National Assembly")), SENAT (@L.T("Sénat", "Senate")), UE (@L.T("Parlement européen", "European Parliament")).</dd></div>
    </dl>
    }
    }
    <p class="note-source">@L.TH("Un fichier se lit avec n'importe quel tableur après décompression, ou directement par exemple avec Python : <code>pandas.read_csv(\"votes.csv.gz\")</code>. Les empreintes SHA-256 permettent de vérifier un téléchargement.", "A file can be opened in any spreadsheet after decompression, or directly for example with Python: <code>pandas.read_csv(\"votes.csv.gz\")</code>. The SHA-256 fingerprints let you check a download.")</p>
</section>

<section class="definitions" aria-label="@L.T("Sources et licences", "Sources and licences")">
    <h2>@L.T("Sources et conditions de réutilisation", "Sources and terms of reuse")</h2>
    @if (L.Pays == "US")
    {
    <p>@L.TH("Les votes de la <strong>Chambre des représentants</strong> viennent du greffe de la Chambre (fichiers officiels) ; ceux du <strong>Sénat</strong> de <strong>Voteview</strong> (UCLA et Université de Géorgie : voteview.com), projet universitaire tiers à citer, car senate.gov refuse les accès automatiques. Les noms des élus viennent de Voteview ; les mandats sont déduits des votes. La source officielle de chaque vote est liée dans <code>us_scrutins</code> (<code>url_officielle</code>). Citation demandée par Voteview : Lewis, Jeffrey B., Keith Poole, Howard Rosenthal, Adam Boche, Aaron Rudkin, and Luke Sonnet (2026). <em>Voteview: Congressional Roll-Call Votes Database</em>. https://voteview.com/. Les rattachements, majorités et mandats calculés par le site sont fournis sans garantie ; voir la page <a href=\"" + L.Lien("/methodologie") + "\">Méthodologie et limites</a>. Aucune photo n'est incluse.", "The <strong>House of Representatives</strong> votes come from the Clerk of the House (official files); the <strong>Senate</strong> votes from <strong>Voteview</strong> (UCLA and the University of Georgia: voteview.com), a third-party academic project to cite, because senate.gov refuses automated access. Members' names come from Voteview; mandates are deduced from the votes. The official source of each vote is linked in <code>us_scrutins</code> (<code>url_officielle</code>). Citation requested by Voteview: Lewis, Jeffrey B., Keith Poole, Howard Rosenthal, Adam Boche, Aaron Rudkin, and Luke Sonnet (2026). <em>Voteview: Congressional Roll-Call Votes Database</em>. https://voteview.com/. Links, majorities and mandates calculated by the site are provided without warranty; see the <a href=\"" + L.Lien("/methodologie") + "\">Methodology and limits</a> page. No photo is included.")</p>
    }
    else if (royaumeUni)
    {
    <p>@L.TH("Les données viennent des services publics du <strong>Parlement britannique</strong> : Commons Votes API, Lords Votes API, Members API, Bills API et petition.parliament.uk, sous <a href=\"https://www.parliament.uk/site-information/copyright-parliament/open-parliament-licence/\">Open Parliament Licence v3.0</a> (réutilisation libre avec mention de la source). Les rattachements (projet de loi, troisième lecture), taux et mandats des Communes calculés par le site sont fournis sans garantie ; voir la page <a href=\"" + L.Lien("/methodologie") + "\">Méthodologie et limites</a>. Aucune photo n'est incluse.", "The data comes from the public services of the <strong>UK Parliament</strong>: Commons Votes API, Lords Votes API, Members API, Bills API and petition.parliament.uk, under the <a href=\"https://www.parliament.uk/site-information/copyright-parliament/open-parliament-licence/\">Open Parliament Licence v3.0</a> (free reuse with attribution). Links (bill, third reading), rates and Commons mandates calculated by the site are provided without warranty; see the <a href=\"" + L.Lien("/methodologie") + "\">Methodology and limits</a> page. No photo is included.")</p>
    }
    else
    {
    <p>@L.TH("Les données viennent des sources officielles : <strong>Assemblée nationale</strong> (data.assemblee-nationale.fr), <strong>Sénat</strong> (data.senat.fr), et, pour le <strong>Parlement européen</strong>, du projet indépendant HowTheyVote.eu, sous Open Database License (attribution et partage à l'identique). La réutilisation de chaque ligne est soumise aux conditions publiées par sa source : citez la source d'origine. Les rattachements, taux et traductions calculés par le site sont fournis sans garantie ; voir la page <a href=\"/methodologie\">Méthodologie et limites</a>. Aucune photo n'est incluse.", "The data comes from official sources: the <strong>National Assembly</strong> (data.assemblee-nationale.fr), the <strong>Senate</strong> (data.senat.fr), and, for the <strong>European Parliament</strong>, from the independent HowTheyVote.eu project, under the Open Database License (attribution and share-alike). Reuse of each row is subject to the terms published by its source: cite the original source. Links, rates and translations computed by the site are provided without warranty; see the <a href=\"/methodologie\">Methodology and limits</a> page. No photo is included.")</p>
    }
</section>
