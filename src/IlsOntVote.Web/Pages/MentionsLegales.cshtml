@page "/mentions-legales"
@{
    ViewData["Title"] = L.T("mentions-legales-et-confidentialite");
    ViewData["Description"] = L.T("editeur-hebergeur-propriete-intellectuelle-c");
}

<h1 class="titre-page">@L.T("mentions-titre")</h1>

<section class="bloc-texte">
    <h2>@L.T("mentions-editeur-titre")</h2>
    <p>@L.TH("mentions-editeur")</p>
</section>

<section class="bloc-texte">
    <h2>@L.T("mentions-hebergement-titre")</h2>
    <p>@L.TH("mentions-hebergement")</p>
</section>

<section class="bloc-texte">
    <h2>@L.T("mentions-propriete-titre")</h2>
    @* Propriété intellectuelle et sources : un paragraphe par pays (textes en base), avec le lien vers la méthodologie du pays. *@
    <p>@(L.Pays switch
    {
        "US" => L.THf("mentions-propriete-us", L.Lien("/methodologie")),
        "CH" => L.THf("mentions-propriete-ch", L.Lien("/methodologie")),
        "CA" => L.THf("mentions-propriete-ca", L.Lien("/methodologie")),
        "IE" => L.THf("mentions-propriete-ie", L.Lien("/methodologie")),
        "IT" => L.THf("mentions-propriete-it", L.Lien("/methodologie")),
        "GB" => L.THf("mentions-propriete-gb", L.Lien("/methodologie")),
        _ => L.THf("mentions-propriete-fr", L.Lien("/methodologie")),
    })</p>
    <p>@L.T("mentions-donnees-publiques")</p>
</section>

<section class="bloc-texte" id="confidentialite">
    <h2>@L.T("mentions-confidentialite-titre")</h2>
    <p>@L.TH("mentions-conf-visites")</p>
    <p>@L.TH("mentions-conf-ip")</p>
    <p>@L.TH("mentions-conf-cookies")</p>
    <p>@L.T("mentions-conf-journaux")</p>
    <p>@L.TH("mentions-conf-droits")</p>
</section>
