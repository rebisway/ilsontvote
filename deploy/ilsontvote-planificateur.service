# IlsOntVote - planificateur d'imports : exécute les demandes faites dans /Admin/Imports et les créneaux du planning (base de données).
# Lancé chaque minute par ilsontvote-planificateur.timer ; un passage sans travail dure une seconde. Remplace ilsontvote-import.timer
# (l'import nocturne est maintenant un planning modifiable dans /Admin/Imports). À la main :
#   sudo systemctl start ilsontvote-planificateur.service     puis     journalctl -u ilsontvote-planificateur.service -f
[Unit]
Description=IlsOntVote (planificateur d'imports)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
# Les jeux téléchargés (zips extraits, plusieurs centaines de Mo) vont dans ./data de ce dossier.
WorkingDirectory=/var/lib/ilsontvote-import
ExecStart=/usr/bin/dotnet /var/www/ilsontvote_importer/IlsOntVote.Importer.dll planificateur
# Un import peut durer des heures (premier remplissage) : pas de limite côté systemd (le planificateur borne lui-même chaque tâche à 3 h).
TimeoutStartSec=infinity
Nice=10

Environment=DOTNET_ENVIRONMENT=Production
# Mêmes secrets que le site (une seule copie du mot de passe de la base).
Environment=ILSONVOTE_LOCAL_CONFIG=/var/www/ilsontvote_app/appsettings.Local.json
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=HOME=/var/lib/ilsontvote-import
# Traduction automatique (tâche « traductions ») : modèles installés par setup-traduction.sh ; absents, la tâche est ignorée sans erreur.
Environment=ILSONVOTE_PYTHON=/opt/ilsontvote-traduction/venv/bin/python
Environment=ILSONVOTE_MODELE_TRADUCTION=/opt/ilsontvote-traduction/opus-mt-fr-en
Environment=ILSONVOTE_MODELE_TRADUCTION_EN_FR=/opt/ilsontvote-traduction/opus-mt-en-fr
# Export des données ouvertes (tâche « export ») : dossier lu par le site pour /donnees.
Environment=ILSONVOTE_EXPORT_DIR=/var/lib/ilsontvote-export

NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
