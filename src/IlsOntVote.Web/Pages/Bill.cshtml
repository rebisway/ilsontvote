@page "/bill/{id:long}"
@model BillModel
@using IlsOntVote.Web.Repositories
@{
    var b = Model.Fiche;
    ViewData["Title"] = b.Titre.Length > 70 ? b.Titre[..70] + "…" : b.Titre;
    ViewData["Description"] = "Stages of a bill before the UK Parliament and the Commons divisions linked to it.";
    var fr = L.Culture;
}

<p class="chapo"><a href="@L.Lien("/bills")">← Bills</a></p>
<h1 class="titre-page">@b.Titre</h1>
@if (b.TitreLong is not null) { <p class="note-source">@b.TitreLong</p> }

<section class="definitions fiche-petition @BillsModel.StatutClasse(b)" aria-label="Details">
    <dl>
        <div><dt>Status</dt><dd><span class="puce-statut @BillsModel.StatutClasse(b)">@BillsModel.StatutLibelle(b)</span></dd></div>
        @if (b.ChambreOrigine is not null) { <div><dt>Introduced in</dt><dd>the @b.ChambreOrigine</dd></div> }
        @if (b.ChambreCourante is not null) { <div><dt>Now in</dt><dd>the @b.ChambreCourante</dd></div> }
        @if (b.DateDepot is { } dd) { <div><dt>First sitting</dt><dd>@dd.ToString("d MMMM yyyy", fr)</dd></div> }
        @if (b.DateLoi is { } dl) { <div><dt>Royal Assent</dt><dd>@dl.ToString("d MMMM yyyy", fr)</dd></div> }
        @if (b.RetireLe is { } rl) { <div><dt>Withdrawn on</dt><dd>@rl.ToString("d MMMM yyyy", fr)</dd></div> }
        <div><dt>Source</dt><dd><a href="@b.Url" rel="noopener">bills.parliament.uk</a></dd></div>
    </dl>
</section>

<h2 class="titre-section">Stages</h2>
@if (Model.Etapes.Count == 0)
{
    <p class="vide">No stage published for this bill yet.</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>Date</th><th>House</th><th>Stage</th></tr></thead>
            <tbody>
            @foreach (var e in Model.Etapes)
            {
                <tr>
                    <td class="nowrap" data-label="Date">@if (e.DateSeance is { } d) { @d.ToString("d MMM yyyy", fr) } else { <span class="doute doute-manquant" title="The source gives no sitting date for this stage (not held yet, or not published).">?</span> }</td>
                    <td data-label="House">@(e.Chambre ?? "—")</td>
                    <td data-label="Stage">@e.Libelle</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h2 class="titre-section">Divisions in the Commons</h2>
<p class="note-source">Linked by this site from the division title (computed, not published by Parliament). Votes on the voices leave no individual vote and do not appear.</p>
@if (Model.Divisions.Count == 0)
{
    <p class="vide">No division is linked to this bill.</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>Date</th><th>Division</th><th>Result</th><th class="num">Aye</th><th class="num">No</th></tr></thead>
            <tbody>
            @foreach (var d in Model.Divisions)
            {
                <tr>
                    <td class="nowrap" data-label="Date">@d.DateScrutin.ToString("d MMM yyyy", fr)</td>
                    <td data-label="Division"><a href="@L.Lien("/scrutin/" + d.Id)">@(d.BillEtape ?? d.Titre)</a></td>
                    <td data-label="Result">@(d.Sort is null ? "—" : d.Sort.StartsWith("adopt") ? "✓ Adopted" : "✗ Rejected")</td>
                    <td class="num" data-label="Aye">@(d.NbPour?.ToString("N0", fr) ?? "—")</td>
                    <td class="num" data-label="No">@(d.NbContre?.ToString("N0", fr) ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
