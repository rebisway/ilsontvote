@page "/petitions"
@model PetitionsModel
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = L.T("petitions");
    var royaumeUni = L.Pays == "GB";
    ViewData["Description"] = L.Pays == "CA" ? L.T("petca-chapo") : L.T("les-petitions-deposees-sur-la-plateforme");
    var fr = L.Culture;
    var en = L.Anglais;
    var total = Model.ParStatut.Sum(s => s.Nombre);
    var tri = Model.TriEffectif;
}

<h1 class="titre-page">@L.T("petitions")</h1>
@if (royaumeUni)
{
    <p class="chapo">@L.TH("petitions-adressees-au-parlement-britannique")</p>
}
else if (L.Pays == "CA")
{
    <p class="chapo">@L.T("petca-chapo")</p>
}
else
{
<p class="chapo">@L.TH("les-petitions-deposees-sur-petitions-senat")</p>
}

<p><a class="bouton-lien" href="@L.Lien("/petitions/anomalies")">⚠ @L.T("anomalies-baisses-de-soutiens-disparitions")</a></p>

@if (total > 0)
{
    <section class="definitions" aria-label="@L.T("chiffres")">
        <dl>
            @foreach (var g in Model.ParStatut.GroupBy(x => x.Chambre))
            {
                <div><dt>@PetitionsModel.PlateformeLibelle(g.Key, L)</dt>
                    <dd>@g.Sum(x => x.Nombre).ToString("N0", fr) @L.T("petitions-f7ee") — @string.Join(" · ", g.Select(x => PetitionsModel.StatutLibelle(x.Libelle, L) + " " + x.Nombre.ToString("N0", fr)))</dd></div>
            }
        </dl>
    </section>
}

<form class="filtres filtres-auto filtres-liste filtres-lois" method="get" action="@L.Lien("/petitions")">
    <input class="filtre" type="search" name="q" value="@Model.Recherche" placeholder="@L.T("chercher-dans-les-titres")" aria-label="@L.T("chercher-une-petition")" />
    @* Même disposition que /lois : recherche, statut, chambre, période. Statut, type et commission suivent la chambre choisie. *@
    <select name="statut" aria-label="@L.T("statut")">
        <option value="">@L.T("tous-les-statuts")</option>
        @foreach (var g in Model.ParStatut.Where(x => Model.ChambreCode is null || x.Chambre == Model.ChambreCode).GroupBy(x => x.Chambre))
        {
            // Les deux plateformes ont chacune un statut « Ouverte » : en vue combinée, les statuts sont groupés pour ne pas prêter à confusion.
            if (Model.ChambreCode is null) { @Html.Raw("<optgroup label=\"" + (g.Key == "AN" ? L.T("assemblee-nationale") : L.T("senat")) + "\">") }
            @foreach (var x in g) { <option value="@x.Libelle" selected="@(Model.Statut == x.Libelle)">@PetitionsModel.StatutLibelle(x.Libelle, L) (@x.Nombre.ToString("N0", fr))</option> }
            if (Model.ChambreCode is null) { @Html.Raw("</optgroup>") }
        }
    </select>
    <select name="theme" aria-label="@L.T("theme")" title="@L.T("theme-estime-d-apres-les-mots")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Theme)">@L.T("tous-les-themes")</option>
        @foreach (var th in Model.ThemesListe)
        {
            <option value="@th.Code" selected="@(Model.Theme == th.Code)">@L.Theme(th)</option>
        }
    </select>
    @if (L.Pays is null)
    {
    <select name="chambre" aria-label="@L.T("chambre-accd")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Chambre)">@L.T("assemblee-et-senat")</option>
        <option value="an" selected="@(Model.Chambre == "an")">@L.T("petitions-de-l-assemblee")</option>
        <option value="senat" selected="@(Model.Chambre == "senat")">@L.T("petitions-du-senat")</option>
    </select>
    }
    <select name="anomalie" aria-label="@L.T("historique")" title="@L.T("petitions-dont-le-nombre-de-soutiens")">
        <option value="">@L.T("historique-toutes")</option>
        <option value="oui" selected="@(Model.Anomalie == "oui")">@L.T("avec-constat-s")</option>
        <option value="baisse" selected="@(Model.Anomalie == "baisse")">@L.T("baisse-des-soutiens")</option>
        <option value="disparition" selected="@(Model.Anomalie == "disparition")">@L.T("absente-du-fichier")</option>
        <option value="reapparition" selected="@(Model.Anomalie == "reapparition")">@L.T("de-nouveau-dans-le-fichier")</option>
    </select>
    <span class="periode"><label class="champ-date" title="@L.T("affiche-les-petitions-publiees-dans-la")">@L.T("du") <input type="date" name="du" value="@Model.Du" aria-label="@L.T("du-date-de-debut")" /></label>
        <label class="champ-date">@L.T("au") <input type="date" name="au" value="@Model.Au" aria-label="@L.T("au-date-de-fin")" /></label></span>
    @if (Model.ChambreCode == "SENAT")
    {
        <select name="type" aria-label="@L.T("petition-champ-type")">
            <option value="">@L.T("tous-les-types")</option>
            @foreach (var t in Model.ParType.Where(x => x.Chambre == "SENAT")) { <option value="@t.Libelle" selected="@(Model.Type == t.Libelle)">@PetitionsModel.TypeLibelle(t.Libelle, L) (@t.Nombre.ToString("N0", fr))</option> }
        </select>
    }
    @if (Model.ChambreCode == "AN")
    {
        <select name="commission" aria-label="@L.T("commission")">
            <option value="">@L.T("toutes-les-commissions")</option>
            @foreach (var c in Model.ParCommission.Where(x => x.Chambre == "AN")) { <option value="@c.Libelle" selected="@(Model.Commission == c.Libelle)">@c.Libelle (@c.Nombre.ToString("N0", fr))</option> }
        </select>
    }
    @* Tri : en-têtes de colonne (écran large) ou ces listes (téléphone). *@
    <select name="tri" class="tri-mobile" aria-label="@L.T("trier-par")">
        <option value="date" selected="@(tri == "date")">@L.T("trier-date")</option>
        @if (Model.ChambreCode is null) { <option value="chambre" selected="@(tri == "chambre")">@L.T("trier-plateforme")</option> }
        <option value="titre" selected="@(tri == "titre")">@L.T("trier-titre")</option>
        <option value="fin" selected="@(tri == "fin")">@L.T("trier-fin-du-recueil")</option>
        <option value="historique" selected="@(tri == "historique")">@L.T("trier-constats")</option>
        <option value="soutiens" selected="@(tri == "soutiens")">@L.T("trier-soutiens")</option>
        <option value="statut" selected="@(tri == "statut")">@L.T("trier-statut")</option>
        @if (Model.ChambreCode == "SENAT") { <option value="type" selected="@(tri == "type")">@L.T("trier-type")</option> }
        @if (Model.ChambreCode == "AN") { <option value="commission" selected="@(tri == "commission")">@L.T("trier-commission")</option> }
    </select>
    <select name="sens" class="tri-mobile" aria-label="@L.T("sens-du-tri")">
        <option value="desc" selected="@Model.Decroissant">@L.T("decroissant")</option>
        <option value="asc" selected="@(!Model.Decroissant)">@L.T("croissant")</option>
    </select>
    <button type="submit" class="sans-js">@L.T("filtrer")</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@L.Lien("/petitions")" title="@L.T("effacer-le-filtre")" aria-label="@L.T("effacer-le-filtre")"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></svg></a> }
</form>

<div class="barre-liste">
    <p class="compte">@Model.Resultats.Total.ToString("N0", fr) @(Model.Resultats.Total > 1 ? L.T("plur-petition-pl") : L.T("plur-petition-sg"))</p>
    <p class="export">@L.T("exporter-ce-tableau")
        @foreach (var f in Exporteur.Formats) { <a href="@Model.Lien(format: f)" download>@f.ToUpperInvariant()</a> }
    </p>
</div>

@if (Model.Resultats.Lignes.Count == 0)
{
    <p class="vide">@L.T("aucune-petition-a-afficher-aucun-resultat")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead>
                <tr>
                    @Model.Th("date", L.T("publiee"), "nowrap")
                    @if (Model.ChambreCode is null) { @Model.Th("chambre", L.T("plateforme")) }
                    @Model.Th("titre", L.T("titre"))
                    @if (Model.ChambreCode == "SENAT") { @Model.Th("type", L.T("petition-champ-type")) }
                    @if (Model.ChambreCode == "AN") { @Model.Th("commission", L.T("commission")) }
                    @if (Model.ChambreCode == "UK") { <th scope="col">@L.T("petition-etape-colonne")</th> }
                    @Model.Th("statut", L.T("statut"))
                    @Model.Th("fin", L.T("fin-du-recueil"), "nowrap")
                    @Model.Th("soutiens", L.T("soutiens"), "num")
                    @Model.Th("historique", L.T("historique"))
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Resultats.Lignes)
            {
                <tr>
                    <td class="nowrap" data-label="@L.T("publiee")">@(p.DatePublication?.ToString("d MMM yyyy", fr) ?? "—")</td>
                    @if (Model.ChambreCode is null) { <td data-label="@L.T("plateforme")">@(p.Chambre == "AN" ? L.T("assemblee") : L.T("senat"))</td> }
                    <td data-label="@L.T("titre")"><a href="@L.Lien("/petition/" + p.Id)">@p.Titre</a> <a class="note-source" href="@p.Url" rel="noopener" title="@L.T("page-de-la-petition-sur-la")">↗</a></td>
                    @if (Model.ChambreCode == "SENAT") { <td data-label="@L.T("petition-champ-type")">@PetitionsModel.TypeLibelle(p.Type, L)</td> }
                    @if (Model.ChambreCode == "UK")
                    {
                        <td data-label="@L.T("petition-etape-colonne")">
                            @if (p.DebatLe is { } dl) { <span class="puce-statut st-seuil" title="@L.Tf("petition-debattue-le", dl.ToString("d MMMM yyyy", fr))">@L.Tf("petition-puce-debattue", dl.ToString("d MMM yyyy", fr))</span> }
                            else if (p.DebatPrevuLe is { } dp) { <span class="puce-statut st-seuil" title="@L.T("petition-debat-prevu")">@L.Tf("petition-puce-debat-prevu", dp.ToString("d MMM yyyy", fr))</span> }
                            else if (p.ReponseLe is { } rl) { <span class="puce-statut st-neutre" title="@L.Tf("petition-reponse-publiee-le", rl.ToString("d MMMM yyyy", fr))">@L.Tf("petition-puce-reponse", rl.ToString("d MMM yyyy", fr))</span> }
                            else { <span class="note-source">—</span> }
                        </td>
                    }
                    @if (Model.ChambreCode == "AN") { <td data-label="@L.T("commission")">@(p.Commission ?? "—")@if (p.DecisionCommission is null && p.Statut is "classee" or "archivee") { <br /><span class="doute doute-manquant" title="@L.T("la-source-ne-publie-aucune-decision")">? @L.T("decision-non-publiee")</span> }@if (p.DecisionCommission is not null) { <br /><span class="note-source" title="@p.DecisionCommission">@L.T("decision")@(p.DecisionCommission.Length > 70 ? p.DecisionCommission[..70] + "…" : p.DecisionCommission)</span> }</td> }
                    <td data-label="@L.T("statut")" title="@(p.DateLimiteVote is { } d ? L.T("date-limite") + d.ToString("d MMM yyyy", fr) : "")"><span class="puce-statut @PetitionsModel.StatutClasse(p.Statut)">@PetitionsModel.StatutLibelle(p.Statut, L)</span></td>
                    <td class="nowrap" data-label="@L.T("fin-du-recueil")">@(p.DateLimiteVote?.ToString("d MMM yyyy", fr) ?? "—")</td>
                    <td class="num" data-label="@L.T("soutiens")">@if (p.NbVotes is { } nv) { @nv.ToString("N0", fr) } else { <span class="doute doute-manquant" title="@L.T("nombre-de-soutiens-non-renseigne-par")">?</span> }</td>
                    <td data-label="@L.T("historique")">
                        @if (p.AbsenteDepuis is { } abs) { <a class="doute doute-incertain" href="@L.Lien("/petition/" + p.Id)" title="@L.T("absente-du-fichier-source-depuis-le")@abs.ToString("d MMM yyyy", fr)">⚠ @L.T("absente")</a> }
                        else if (p.NbAnomalies > 0) { <a class="doute doute-incertain" href="@L.Lien("/petition/" + p.Id)" title="@L.T("constat-s-entre-deux-releves-voir")">⚠ @p.NbAnomalies.ToString(fr)</a> }
                        else { <span class="note-source">—</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Resultats.NbPages > 1)
    {
        <nav class="pagination" aria-label="@L.T("pagination")">
            @if (Model.Resultats.Page > 1) { <a href="@Model.Lien(page: Model.Resultats.Page - 1)" rel="prev">@L.T("precedent")</a> }
            <span>@L.T("page") @Model.Resultats.Page / @Model.Resultats.NbPages</span>
            @if (Model.Resultats.Page < Model.Resultats.NbPages) { <a href="@Model.Lien(page: Model.Resultats.Page + 1)" rel="next">@L.T("suivant")</a> }
        </nav>
    }
    <partial name="_LignesParPage" model="Model" />
}
