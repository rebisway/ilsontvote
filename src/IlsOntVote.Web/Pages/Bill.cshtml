@page "/bill/{id:long}"
@model BillModel
@using IlsOntVote.Web.Repositories
@using IlsOntVote.Web.Services
@{
    var b = Model.Fiche;
    ViewData["Title"] = b.Titre.Length > 70 ? b.Titre[..70] + "…" : b.Titre;
    ViewData["Description"] = L.T("etapes-d-un-projet-de-loi");
    var fr = L.Culture;
}

<p class="chapo"><a href="@L.Lien("/bills")">@L.T("projets-de-loi")</a></p>
<h1 class="titre-page">@b.Titre</h1>
@if (b.TitreLong is not null) { <p class="note-source">@b.TitreLong</p> }

<section class="definitions fiche-petition @BillsModel.StatutClasse(b)" aria-label="@L.T("details")">
    <dl>
        <div><dt>@L.T("statut")</dt><dd><span class="puce-statut @BillsModel.StatutClasse(b)">@BillsModel.StatutLibelle(b, L)</span>@if (b.SessionClose) { <span class="note-source">@L.T("bill-session-close-aide")</span> }</dd></div>
        @if (b.ChambreOrigine is not null) { <div><dt>@L.T("depose-a")</dt><dd>@(b.ChambreOrigine == "Commons" ? L.T("la-chambre-des-communes") : L.T("la-chambre-des-lords"))</dd></div> }
        @if (b.ChambreCourante is not null) { <div><dt>@L.T("actuellement-a")</dt><dd>@(b.ChambreCourante == "Commons" ? L.T("la-chambre-des-communes") : L.T("la-chambre-des-lords"))</dd></div> }
        @if (b.DateDepot is { } dd) { <div><dt>@L.T("premiere-seance")</dt><dd>@dd.ToString("d MMMM yyyy", fr)</dd></div> }
        @if (b.DateLoi is { } dl) { <div><dt>@L.T("sanction-royale")</dt><dd>@dl.ToString("d MMMM yyyy", fr)</dd></div> }
        @if (b.RetireLe is { } rl) { <div><dt>@L.T("retire-le")</dt><dd>@rl.ToString("d MMMM yyyy", fr)</dd></div> }
        <div><dt>@L.T("source")</dt><dd><a href="@b.Url" rel="noopener">bills.parliament.uk</a></dd></div>
    </dl>
    <div class="liens-externes">
        <a class="raccourci" href="@b.Url" rel="noopener" target="_blank">@L.T("texte-du-projet") ↗</a>
        @{ var promptIA = PromptResume.Construire(L, b.Titre, new[] { b.Url }); }
        <partial name="_ResumeIA" model="promptIA" />
    </div>
</section>

<h2 class="titre-section">@L.T("etapes")</h2>
@if (Model.Etapes.Count == 0)
{
    <p class="vide">@L.T("aucune-etape-publiee-pour-ce-projet")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>@L.T("date")</th><th>@L.T("chambre")</th><th>@L.T("etape")</th></tr></thead>
            <tbody>
            @foreach (var e in Model.Etapes)
            {
                <tr>
                    <td class="nowrap" data-label="@L.T("date")">@if (e.DateSeance is { } d) { @d.ToString("d MMM yyyy", fr) } else { <span class="doute doute-manquant" title="@L.T("la-source-ne-donne-pas-de")">?</span> }</td>
                    <td data-label="@L.T("chambre")">@(e.Chambre ?? "—")</td>
                    <td data-label="@L.T("etape")">@e.Libelle</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h2 class="titre-section">@L.T("divisions-aux-communes")</h2>
<p class="note-source">@L.T("rattachees-par-ce-site-d-apres")</p>
@if (Model.Divisions.Count == 0)
{
    <p class="vide">@L.T("aucune-division-n-est-rattachee-a")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>@L.T("date")</th><th>@L.T("bill-division")</th><th>@L.T("resultat")</th><th class="num">@L.T("pour")</th><th class="num">@L.T("contre")</th></tr></thead>
            <tbody>
            @foreach (var d in Model.Divisions)
            {
                <tr>
                    <td class="nowrap" data-label="@L.T("date")">@d.DateScrutin.ToString("d MMM yyyy", fr)</td>
                    <td data-label="@L.T("bill-division")"><a href="@L.Lien("/scrutin/" + d.Id)">@(d.BillEtape ?? d.Titre)</a></td>
                    <td data-label="@L.T("resultat")">@(d.Sort is null ? "—" : d.Sort.StartsWith("adopt") ? L.T("adopte") : L.T("rejete"))</td>
                    <td class="num" data-label="@L.T("pour")">@(d.NbPour?.ToString("N0", fr) ?? "—")</td>
                    <td class="num" data-label="@L.T("contre")">@(d.NbContre?.ToString("N0", fr) ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
