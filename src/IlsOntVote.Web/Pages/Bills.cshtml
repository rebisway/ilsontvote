@page "/bills"
@model BillsModel
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = L.T("Projets de loi", "Bills");
    ViewData["Description"] = L.T("Projets de loi du Parlement britannique : étape, chambre, sanction royale et divisions des Communes rattachées à chacun.", "Bills before the UK Parliament: stage, house, Royal Assent, and the Commons divisions linked to each.");
    var fr = L.Culture;
    var tri = Model.TriEffectif;
    int N(string cle) => Model.ParStatut.Where(x => x.Cle == cle).Select(x => x.Nombre).FirstOrDefault();
}

<h1 class="titre-page">@L.T("Projets de loi", "Bills")</h1>
<p class="chapo">@L.TH("Projets de loi des 58e et 59e Parlements (depuis décembre 2019), d'après <a href=\"https://bills.parliament.uk/\" rel=\"noopener\">bills.parliament.uk</a> : où en est chacun, dans quelle chambre, et s'il est devenu une loi (Act). Le statut est celui publié par la source. Le nombre de divisions est calculé par ce site d'après les titres des divisions (par exemple « Finance Bill: Third Reading ») : une division dont le titre ne nomme pas son projet n'est pas comptée.", "Bills of the 58th and 59th Parliaments (since December 2019), from <a href=\"https://bills.parliament.uk/\" rel=\"noopener\">bills.parliament.uk</a>: where each one stands, in which house, and whether it became an Act. Status is as published by the source. The number of divisions is computed by this site from the division titles (for example “Finance Bill: Third Reading”), so a division whose title does not name its bill is not counted.")</p>

@if (Model.ParStatut.Count > 0)
{
    <section class="definitions" aria-label="@L.T("Chiffres", "Figures")">
        <dl>
            <div><dt>@L.T("Projets de loi", "Bills")</dt><dd>@Model.ParStatut.Sum(x => x.Nombre).ToString("N0", fr) — @L.T("lois", "Acts") @N("loi").ToString("N0", fr) · @L.T("en cours", "in progress") @N("en-cours").ToString("N0", fr) · @L.T("retirés ou rejetés", "withdrawn or defeated") @N("retire").ToString("N0", fr)</dd></div>
        </dl>
    </section>
}

<form class="filtres filtres-auto filtres-liste" method="get" action="@L.Lien("/bills")">
    <input class="filtre" type="search" name="q" value="@Model.Recherche" placeholder="@L.T("Chercher un projet de loi…", "Search a bill…")" aria-label="@L.T("Chercher un projet de loi", "Search a bill")" />
    <select name="statut" aria-label="@L.T("Statut", "Status")">
        <option value="">@L.T("Tous les statuts", "All statuses")</option>
        <option value="loi" selected="@(Model.Statut == "loi")">@L.T("Lois (sanction royale)", "Acts (Royal Assent)")</option>
        <option value="en-cours" selected="@(Model.Statut == "en-cours")">@L.T("En cours", "In progress")</option>
        <option value="retire" selected="@(Model.Statut == "retire")">@L.T("Retirés ou rejetés", "Withdrawn or defeated")</option>
    </select>
    <select name="chambre" aria-label="@L.T("Chambre", "House")">
        <option value="">@L.T("Les deux chambres", "Both houses")</option>
        <option value="Commons" selected="@(Model.Chambre == "Commons")">@L.T("Actuellement aux Communes", "Now in the Commons")</option>
        <option value="Lords" selected="@(Model.Chambre == "Lords")">@L.T("Actuellement aux Lords", "Now in the Lords")</option>
    </select>
    <select name="tri" class="tri-mobile" aria-label="@L.T("Trier par", "Sort by")">
        <option value="maj" selected="@(tri == "maj")">@L.T("Trier : dernière mise à jour", "Sort: last update")</option>
        <option value="depot" selected="@(tri == "depot")">@L.T("Trier : première séance", "Sort: first sitting")</option>
        <option value="titre" selected="@(tri == "titre")">@L.T("Trier : titre", "Sort: title")</option>
        <option value="statut" selected="@(tri == "statut")">@L.T("Trier : statut", "Sort: status")</option>
        <option value="divisions" selected="@(tri == "divisions")">@L.T("Trier : divisions", "Sort: divisions")</option>
    </select>
    <select name="sens" class="tri-mobile" aria-label="@L.T("Ordre du tri", "Sort order")">
        <option value="desc" selected="@Model.Decroissant">@L.T("Décroissant", "Descending")</option>
        <option value="asc" selected="@(!Model.Decroissant)">@L.T("Croissant", "Ascending")</option>
    </select>
    <button type="submit" class="sans-js">@L.T("Filtrer", "Filter")</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@Model.LienSansFiltre" title="@L.T("Effacer le filtre", "Clear filter")" aria-label="@L.T("Effacer le filtre", "Clear filter")">✕</a> }
</form>

<div class="barre-liste">
    <p class="compte">@Model.Resultats.Total.ToString("N0", fr) @L.T(Model.Resultats.Total > 1 ? "projets de loi" : "projet de loi", Model.Resultats.Total > 1 ? "bills" : "bill")</p>
    <p class="export">@L.T("Exporter ce tableau :", "Export this table:")
        @foreach (var f in Exporteur.Formats) { <a href="@Model.Lien(format: f)" download>@f.ToUpperInvariant()</a> }
    </p>
</div>

@if (Model.Resultats.Lignes.Count == 0)
{
    <p class="vide">@L.T("Aucun projet de loi ne correspond à ces critères.", "No bill matches these criteria.")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead>
                <tr>
                    @Model.Th("depot", L.T("Première séance", "First sitting"), "col-date")
                    @Model.Th("titre", L.T("Projet de loi", "Bill"), "col-titre")
                    @Model.Th("statut", L.T("Statut", "Status"), "col-statut")
                    <th scope="col">@L.T("Chambre", "House")</th>
                    @Model.Th("divisions", "Divisions", "num")
                    @Model.Th("maj", L.T("Mis à jour", "Updated"), "col-date")
                </tr>
            </thead>
            <tbody>
            @foreach (var b in Model.Resultats.Lignes)
            {
                <tr>
                    <td class="nowrap col-date" data-label="@L.T("Première séance", "First sitting")">@(b.DateDepot?.ToString("d MMM yyyy", fr) ?? "—")</td>
                    <td class="col-titre"><a href="@L.Lien("/bill/" + b.Id)">@b.Titre</a> <a class="note-source" href="@b.Url" rel="noopener" title="@L.T("Page du projet sur bills.parliament.uk", "Bill page on bills.parliament.uk")">↗</a></td>
                    <td class="col-statut" data-label="@L.T("Statut", "Status")"><span class="puce-statut @BillsModel.StatutClasse(b)" title="@BillsModel.StatutLibelle(b, L)">@BillsModel.StatutCourt(b, L)</span></td>
                    <td data-label="@L.T("Chambre", "House")">@(b.ChambreCourante ?? "—")@if (b.ChambreOrigine is not null && b.ChambreOrigine != b.ChambreCourante) { <span class="note-source"> (@L.T("venu de", "from") @b.ChambreOrigine)</span> }</td>
                    <td class="num" data-label="@L.T("Divisions", "Divisions")">@if (b.NbDivisions > 0) { <a href="@L.Lien("/bill/" + b.Id)" title="@L.T("Divisions rattachées d'après le titre (calculé)", "Divisions linked by title (computed)")">@b.NbDivisions</a> } else { <span class="note-source">—</span> }</td>
                    <td class="nowrap col-date" data-label="@L.T("Mis à jour", "Updated")">@(b.DerniereMaj?.ToString("d MMM yyyy", fr) ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Resultats.NbPages > 1)
    {
        <nav class="pagination" aria-label="@L.T("Pagination", "Pagination")">
            @if (Model.Resultats.Page > 1) { <a href="@Model.Lien(page: Model.Resultats.Page - 1)" rel="prev">@L.T("← Précédent", "← Previous")</a> }
            <span>@L.T("Page", "Page") @Model.Resultats.Page / @Model.Resultats.NbPages</span>
            @if (Model.Resultats.Page < Model.Resultats.NbPages) { <a href="@Model.Lien(page: Model.Resultats.Page + 1)" rel="next">@L.T("Suivant →", "Next →")</a> }
        </nav>
    }
    <partial name="_LignesParPage" model="Model" />
}
