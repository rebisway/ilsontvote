@page
@model ErrorModel
@{
    ViewData["Title"] = L.T("erreur");
    ViewData["NoIndex"] = true;
}

<h1>@L.T("une-erreur-est-survenue")</h1>
<p class="chapo">@L.T("la-page-demandee-n-a-pas")</p>

@if (Model.ShowRequestId)
{
    <p><strong>@L.T("identifiant")</strong> <code>@Model.RequestId</code></p>
}

<p><a href="@L.Lien("/")">@L.T("retour-a-l-accueil")</a> · <a href="mailto:contact@rebisway.com">contact@rebisway.com</a></p>
