// IlsOntVote - fichier des secrets de production.
//
// Copier en /var/www/ilsontvote_app/appsettings.Local.json (à côté de IlsOntVote.Web.dll), puis :
//   sudo chown www-data:www-data /var/www/ilsontvote_app/appsettings.Local.json
//   sudo chmod 600               /var/www/ilsontvote_app/appsettings.Local.json
// Remplacer chaque valeur <...>. Jamais dans le dépôt, une ligne de commande ou un dossier publié (une mise à jour ne le contient pas).
// Le service d'import lit ce même fichier (variable ILSONVOTE_LOCAL_CONFIG) : un seul mot de passe de base à tenir à jour.
{
  // La base « ilsontvote » (sa propre base, son propre utilisateur, rien de partagé avec un autre site) :
  // créée par setup-site.sh, qui demande le mot de passe à ce moment-là : mettre le même ici.
  "ConnectionStrings": {
    "PostgreSQL_Release": "Host=localhost;Port=5432;Database=ilsontvote;Username=ilsontvote;Password=<mot de passe de la base>"
  },

  // Administrateur initial : créé au premier démarrage s'il n'existe pas (12 caractères minimum).
  // À RETIRER de ce fichier une fois le compte créé ; les autres comptes se gèrent dans /Admin/Utilisateurs.
  "AdminBootstrapEmail": "<adresse e-mail de l'administrateur>",
  "AdminBootstrapPassword": "<mot de passe long>"
}
