@model IlsOntVote.Web.Pages.ListePageModel
@* Choix du nombre de lignes par page : de simples liens (fonctionnent sans JavaScript), filtres et tri conservés, retour page 1. *@
<p class="lignes-page" aria-label="@L.T("Nombre de lignes par page", "Number of rows per page")">
    @L.T("Lignes par page :", "Rows per page:")
    @foreach (var n in IlsOntVote.Web.Pages.ListePageModel.ChoixLignes)
    {
        if (n == Model.ParPage) { <strong aria-current="true">@n</strong> }
        else { <a href="@Model.Lien(lignes: n)">@n</a> }
    }
    @if (Model.ParPage == IlsOntVote.Web.Pages.ListePageModel.Toutes) { <strong aria-current="true">@L.T("Tous", "All")</strong> }
    else { <a href="@Model.Lien(lignes: IlsOntVote.Web.Pages.ListePageModel.Toutes)">@L.T("Tous", "All")</a> }
</p>
@if (Model.ParPage == IlsOntVote.Web.Pages.ListePageModel.Toutes && Model.TotalLignes > IlsOntVote.Web.Pages.ListePageModel.Toutes)
{
    <p class="note-source">@L.T("Affichage limité aux " + IlsOntVote.Web.Pages.ListePageModel.Toutes.ToString("N0", L.Culture) + " premières lignes sur " + Model.TotalLignes.ToString("N0", L.Culture) + " : l'export (CSV, JSON) donne tout.", "Display limited to the first " + IlsOntVote.Web.Pages.ListePageModel.Toutes.ToString("N0", L.Culture) + " rows of " + Model.TotalLignes.ToString("N0", L.Culture) + ": the export (CSV, JSON) gives everything.")</p>
}
