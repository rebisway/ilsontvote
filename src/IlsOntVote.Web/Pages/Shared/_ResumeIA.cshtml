@model string
@* Bouton « Résumer avec une IA » : le modèle est le prompt (voir PromptResume). Aucun appel serveur : liens vers l'assistant choisi ; pour ceux dont l'adresse
   n'accepte pas de pré-remplissage fiable, le prompt est copié dans le presse-papiers puis le site s'ouvre (à coller). *@
@{
    // (nom, adresse, pré-remplissage ?) : vrai = l'adresse accepte le prompt en paramètre. Gemini et les trois assistants chinois n'ont pas de pré-remplissage documenté : copier puis coller.
    (string Nom, string Url, bool Prefill)[] assistants =
    [
        ("ChatGPT", "https://chatgpt.com/?q=", true),
        ("Claude", "https://claude.ai/new?q=", true),
        ("Mistral", "https://chat.mistral.ai/chat?q=", true),
        ("Perplexity", "https://www.perplexity.ai/search?q=", true),
        ("Gemini", "https://gemini.google.com/app", false),   // pas de pré-remplissage documenté
        ("DeepSeek", "https://chat.deepseek.com/", false),
        ("Qwen", "https://chat.qwen.ai/", false),
        ("Kimi", "https://www.kimi.com/", false),
    ];
    var q = Uri.EscapeDataString(Model);
}
<details class="resume-ia" data-prompt="@Model">
    <summary>@L.T("resumer-avec-une-ia")</summary>
    <div class="resume-ia-panneau">
    <div class="resume-ia-liste">
        @foreach (var a in assistants)
        {
            if (a.Prefill)
            {
                <a class="raccourci" href="@(a.Url + q)" target="_blank" rel="noopener noreferrer">@a.Nom ↗</a>
            }
            else
            {
                <a class="raccourci" href="@a.Url" target="_blank" rel="noopener noreferrer" data-copie>@a.Nom ↗</a>
            }
        }
        <button type="button" class="raccourci" data-copier>@L.T("copier-le-prompt")</button>
        @* Téléphone : la feuille de partage du système propose les applications d'IA installées (ouvre l'app plutôt que le site). Cachée si le navigateur ne sait pas partager. *@
        <button type="button" class="raccourci" data-partager hidden>@L.T("envoyer-a-une-app")</button>
        <span class="note-source" role="status" data-etat></span>
    </div>
    <p class="note-source">@L.T("outil-externe-non-officiel-le-site")</p>
    </div>
</details>
<script>
(function () {
    var d = document.currentScript.previousElementSibling;
    var etat = d.querySelector('[data-etat]');
    function copier() {
        var p = d.getAttribute('data-prompt');
        var ok = function () { etat.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L.T("prompt-copie-collez-le-dans-l"))); };
        try { return navigator.clipboard.writeText(p).then(ok); } catch (e) { }
        var t = document.createElement('textarea'); t.value = p; document.body.appendChild(t); t.select();
        try { document.execCommand('copy'); ok(); } catch (e) { }
        document.body.removeChild(t);
    }
    // Fenêtre flottante : recalée à droite du bouton si elle dépasserait de l'écran (bouton en bout de rangée), puis à gauche de la page si elle dépasse encore.
    d.addEventListener('toggle', function () {
        var pn = d.querySelector('.resume-ia-panneau');
        pn.style.left = ''; pn.style.right = '';
        if (!d.open || !window.innerWidth) return;
        var r = pn.getBoundingClientRect();
        if (r.right > window.innerWidth - 8) { pn.style.left = 'auto'; pn.style.right = '0'; r = pn.getBoundingClientRect(); }
        if (r.left < 8) { pn.style.right = 'auto'; pn.style.left = (8 - d.getBoundingClientRect().left) + 'px'; }
    });
    var partage = d.querySelector('[data-partager]');
    if (partage && navigator.share && window.matchMedia('(pointer: coarse)').matches) partage.hidden = false;
    d.addEventListener('click', function (e) {
        if (e.target.closest('[data-partager]')) { navigator.share({ text: d.getAttribute('data-prompt') }).catch(function () { }); return; }
        if (e.target.closest('[data-copier], [data-copie]')) copier();
    });
})();
</script>
