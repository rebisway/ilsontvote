# IlsOntVote - site nginx complet APRÈS certbot (HTTPS inclus), adresse officielle : https://www.ilsontvote.org
# À installer à la place de /etc/nginx/sites-available/ilsontvote (NE PAS relancer setup-site.sh : il écraserait les blocs TLS).
# Le certificat (un seul, nom « ilsontvote.org ») couvre les 4 noms. Redirections en UNE étape vers l'adresse officielle.
# Puis : sudo nginx -t && sudo systemctl reload nginx

# --- Site (adresse officielle, HTTPS) ---
server {
    listen 443 ssl;
    server_name www.ilsontvote.org;

    # Pas de journal d'accès : les visites sont comptées par le site, sans IP. Les erreurs restent journalisées.
    access_log off;
    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_types text/css text/csv application/json application/javascript image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:5295;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    ssl_certificate /etc/letsencrypt/live/ilsontvote.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ilsontvote.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

# --- Autres noms en HTTPS -> adresse officielle (301 directe) ---
server {
    listen 443 ssl;
    server_name ilsontvote.org ilsontvote.com www.ilsontvote.com;
    return 301 https://www.ilsontvote.org$request_uri;

    ssl_certificate /etc/letsencrypt/live/ilsontvote.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ilsontvote.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

# --- Tous les noms en HTTP -> adresse officielle en HTTPS (301 directe, sans passer par un nom intermédiaire) ---
server {
    listen 80;
    server_name ilsontvote.org www.ilsontvote.org ilsontvote.com www.ilsontvote.com;
    return 301 https://www.ilsontvote.org$request_uri;
}
