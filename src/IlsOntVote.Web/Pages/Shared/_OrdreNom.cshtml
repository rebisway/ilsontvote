@* Bascule « Prénom Nom » / « Nom Prénom » : à placer sur les pages qui affichent des noms d'élus (le script est dans _Layout). *@            <div class="ordre-nom" role="group" aria-label="@L.T("ordre-d-affichage-des-noms", "Ordre d'affichage des noms", "Name display order")">
                <button type="button" data-ordre="prenom-nom" title="@L.T("afficher-prenom-nom", "Afficher « Prénom Nom »", "Show “First name Last name”")">@L.T("prenom-nom", "Prénom Nom", "First Last")</button>
                <button type="button" data-ordre="nom-prenom" title="@L.T("afficher-nom-prenom", "Afficher « Nom Prénom »", "Show “Last name First name”")">@L.T("nom-prenom", "Nom Prénom", "Last First")</button>
            </div>
