# IlsOntVote - service systemd du site (copié dans /etc/systemd/system/ilsontvote.service par update-ilsontvote.sh).
# Secrets : /var/www/ilsontvote_app/appsettings.Local.json uniquement (modèle : appsettings.Local.example.json), jamais ici.
[Unit]
Description=IlsOntVote (site)
After=network.target postgresql.service

[Service]
WorkingDirectory=/var/www/ilsontvote_app
ExecStart=/usr/bin/dotnet /var/www/ilsontvote_app/IlsOntVote.Web.dll

Restart=always
RestartSec=10
User=www-data

Environment=ASPNETCORE_ENVIRONMENT=Production
# Boucle locale seulement : nginx est la seule porte d'entrée (les en-têtes X-Forwarded-* ne sont crus que pour cette raison).
# Port 5295 : 5000 rebisway, 5290-5294 FreeSpeech/openpostpro, 5299 autre - ne pas réutiliser.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5295
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=HOME=/var/www/ilsontvote_app

NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
