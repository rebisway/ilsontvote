@page "/scrutin/{id}"
@using IlsOntVote.Web.Models
@using IlsOntVote.Web.Services
@model ScrutinModel
@{
    var s = Model.Scrutin;
    ViewData["OgImage"] = L.Lien("/apercu/scrutin/" + s.Id + ".png");
    ViewData["Description"] = L.Anglais
        ? $"{(s.Adopte ? "Adopted" : "Rejected")}: {s.NbPour} for, {s.NbContre} against, {s.NbAbstentions} abstentions ({s.DateScrutin.ToString("d MMMM yyyy", L.Culture)}, {Chambres.Nom(s.Chambre, true)}). See who voted what, group by group."
        : $"{(s.Adopte ? "Adopté" : "Rejeté")} : {s.NbPour} pour, {s.NbContre} contre, {s.NbAbstentions} abstentions ({s.DateScrutin.ToString("d MMMM yyyy", L.Culture)}, {Chambres.Nom(s.Chambre)}). Voyez qui a voté quoi, groupe par groupe.";
    var titre = s.TitreLangue(L.Anglais);
    ViewData["Title"] = titre.Length > 60 ? titre[..60] + "…" : titre;
    var fr = L.Culture;
    string Libelle(string p) => Pos.Libelle(p, L.Anglais);
    // Types de vote publiés par les assemblées (données françaises) : traduits quand on les connaît, sinon laissés tels quels.
    string TypeVoteLangue(string t) => !L.Anglais ? t : t.ToLowerInvariant() switch
    {
        "scrutin public" or "scrutin public (appel nominal)" => "Roll-call vote",
        "scrutin public ordinaire" => "Ordinary roll-call vote",
        "scrutin public solennel" => "Solemn roll-call vote",
        _ => t,
    };
}

<p class="retour"><a href="@L.Lien("/textes")">@L.T("← Tous les textes", "← All votes")</a></p>

<header class="scrutin-tete">
    <p class="meta">
        @Chambres.Nom(s.Chambre, L.Anglais) · @(s.Chambre is Chambres.Commons or Chambres.Lords ? L.T("division n°", "division no.") : Chambres.EstNominal(s.Chambre) ? L.T("vote nominal n°", "roll call no.") : L.T("scrutin n°", "vote no.")) @s.Numero · <time datetime="@s.DateScrutin.ToString("yyyy-MM-dd")">@s.DateScrutin.ToString("d MMMM yyyy", fr)</time>
        @if (s.Sort is not null) { <text>· </text><span class="sort @(s.Adopte ? "adopte" : "rejete")">@(s.Adopte ? L.T("✓ Adopté", "✓ Adopted") : L.T("✗ Rejeté", "✗ Rejected"))</span> }
    </p>
    <h1>@titre</h1>
<partial name="_OrdreNom" />
</header>
@if (s.TitreTraduitAuto(L.Anglais))
{
    @if (L.Anglais)
    {
        <p class="note-source">@Doute.Html(NiveauDoute.Calcule, "automatic translation", "Machine-translated title (not official). The official title is the French one.") Official title: <span lang="fr">@s.TitreAffiche</span></p>
    }
    else
    {
        <p class="note-source">@Doute.Html(NiveauDoute.Calcule, "traduction automatique", "Titre traduit automatiquement de l'anglais (non officiel) : le Parlement européen n'en publie pas de version française pour ce vote. Le titre officiel est l'original anglais.") Titre original : <span lang="en">@s.TitreEn</span></p>
    }
}

@{
    // Jauge de majorité : pour (bleu) puis contre (rouge), sur une échelle qui inclut le seuil requis.
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var exprimes = s.SuffragesExprimes ?? ((s.NbPour ?? 0) + (s.NbContre ?? 0));
    var base100 = Math.Max(1, Math.Max(exprimes, s.SuffragesRequis ?? 0));
    string Pc(int? n) => (100.0 * (n ?? 0) / base100).ToString("0.##", inv);
    var typeVote = TypeVoteLangue(string.IsNullOrWhiteSpace(s.TypeVoteLibelle) ? "scrutin public" : s.TypeVoteLibelle!.Trim());
    typeVote = char.ToUpperInvariant(typeVote[0]) + typeVote[1..];
}

@{
    // Prompt « Résumer avec une IA » : le CONTENU du texte (voir PromptResume) ; sources = projet britannique, Légifrance, dossiers de l'Assemblée et du Sénat.
    var liensPrompt = new List<string>();
    if (s.UrlOfficielle is { } uo) liensPrompt.Add(uo);
    if (Model.Bill is { } b0) liensPrompt.Add("https://bills.parliament.uk/bills/" + b0.Id);
    if (Model.Loi is { } l0) { liensPrompt.Add(l0.UrlLegifrance ?? ""); liensPrompt.Add(l0.UrlDossierAn ?? ""); liensPrompt.Add(l0.UrlDossierSenat ?? ""); }
    var promptIA = PromptResume.Construire(L.Anglais, titre, liensPrompt);
}
@* Sans bloc « texte » (UE, vote isolé) : le bouton reste seul ; sinon il est dans la rangée des raccourcis du bloc. *@
@if (Model.Loi is null && Model.Bill is null && !Chambres.EstNominal(s.Chambre))
{
    <section class="bloc-texte" aria-label="@L.T("Résumé par IA", "AI summary")"><div class="bloc-texte-titre"><partial name="_ResumeIA" model="promptIA" /></div></section>
}
@if (Chambres.EstNominal(s.Chambre))
{
    <section class="bloc-texte" aria-label="@L.T("Source", "Source")">
        <div class="bloc-texte-titre">@if (s.Chambre == Chambres.UsSenate) { @Doute.Html(NiveauDoute.Calcule, L.T("source tierce", "third-party source"), L.T("Votes du Sénat retraités par Voteview (UCLA, Université de Géorgie) d'après les enregistrements officiels : senate.gov n'est pas accessible aux robots.", "Senate votes reprocessed by Voteview (UCLA, University of Georgia) from the official records: senate.gov is not open to automated clients.")) }
            @if (s.UrlOfficielle is { } urlOff) { <a class="raccourci" href="@urlOff" rel="noopener" target="_blank">@L.T("Enregistrement officiel", "Official record") ↗</a> }
            @if (s.SurEnsemble && s.Chambre is not (Chambres.ItCamera or Chambres.ItSenate)) { @Doute.Html(NiveauDoute.Calcule, L.T("vote sur l'ensemble", "vote on the whole"), L.T("Repéré par ce site d'après la question posée (adoption finale, nomination, « suspend the rules and pass ») : le Congrès ne publie pas cette distinction.", "Found by this site from the question put (final passage, nomination, “suspend the rules and pass”): Congress does not publish that distinction.")) }
            <partial name="_ResumeIA" model="promptIA" />
        </div>
    </section>
}
@if (Model.Bill is { } bill)
{
    <section class="bloc-texte" aria-label="@L.T("Projet de loi", "Bill")">
        <div class="bloc-texte-titre"><span class="statut">@L.T("Projet de loi", "Bill")</span>
            <a href="@L.Lien("/bill/" + bill.Id)">@bill.Titre</a>
            @if (bill.Etape is not null) { <span class="note-source">· @bill.Etape</span> }
            @Doute.Html(NiveauDoute.Calcule, L.T("calculé", "computed"), L.T("Rattaché par ce site d'après le titre de la division ; le Parlement ne publie pas ce lien.", "Linked by this site from the division title; Parliament does not publish this link."))
            <a class="raccourci" href="https://bills.parliament.uk/bills/@bill.Id" rel="noopener" target="_blank">@L.T("Texte du projet", "Bill text") ↗</a>
            <partial name="_ResumeIA" model="promptIA" /></div>
    </section>
}
@if (Model.Loi is { } loi)
{
    var statutLoi = loi.Statut.Traduit(L.Anglais);
    <section class="bloc-texte" aria-label="@L.T("Le texte voté", "The text voted")">
        <div class="bloc-texte-titre"><span class="statut @statutLoi.Classe">@statutLoi.Libelle</span>
            <a class="raccourci" href="@L.Lien("/texte/" + loi.Id)">@L.T("Voir tout le parcours de ce texte →", "See this text's full journey →")</a>
            @if (!string.IsNullOrEmpty(loi.UrlLegifrance)) { <a class="raccourci" href="@loi.UrlLegifrance" rel="noopener" target="_blank">@L.T("Texte sur Légifrance", "Text on Légifrance") ↗</a> }
            @if (!string.IsNullOrEmpty(loi.UrlDossierSenat)) { <a class="raccourci" href="@loi.UrlDossierSenat" rel="noopener" target="_blank">@L.T("Dossier législatif", "Legislative file") ↗</a> }
            <partial name="_ResumeIA" model="promptIA" />
        </div>
        <p class="bloc-texte-faits">
            @if (loi.DatePromulgation is not null) { <span>@L.T("Promulgué le", "Promulgated on") <b>@loi.DatePromulgation.Value.ToString("d MMMM yyyy", fr)</b></span> }
            @if (loi.DateJo is not null) { <span>@L.T("Paru au Journal officiel le", "Published in the Official Journal on") <b>@loi.DateJo.Value.ToString("d MMMM yyyy", fr)</b></span> }
            @if (!string.IsNullOrEmpty(loi.NumeroLoi)) { <span>@L.T("Loi n°", "Law no.") <b>@loi.NumeroLoi</b></span> }
            @if (loi.DecisionCcLibelle is not null) { <span>@L.T("Conseil constitutionnel :", "Constitutional Council:") <b>@loi.DecisionCcLibelle</b></span> }
        </p>
    </section>
}

<section class="fiche-vote" aria-label="@L.T("Caractéristiques du vote", "Vote details")">
    <dl>
        <div><dt>@L.T("Type de vote", "Type of vote")</dt><dd>@typeVote</dd></div>
        <div><dt>@L.T("Votants", "Voters")</dt><dd>@(s.NbVotants?.ToString("N0", fr) ?? "—")</dd><dd class="detail">@(s.NbNonVotants is > 0 ? (L.Anglais ? $"{s.NbNonVotants} non-voting" : $"{s.NbNonVotants} non-votant{(s.NbNonVotants > 1 ? "s" : "")}") : "")</dd></div>
        <div><dt>@L.T("Suffrages exprimés", "Votes cast")</dt><dd>@exprimes.ToString("N0", fr)</dd><dd class="detail">@L.T("pour + contre (hors abstentions)", "for + against (excluding abstentions)")</dd></div>
        @if (s.SuffragesRequis is not null)
        {
            <div>
                <dt>@L.T("Majorité requise", "Majority required")</dt>
                <dd>@s.SuffragesRequis.Value.ToString("N0", fr) @L.T("voix", "votes")</dd>
                <dd class="detail">@(string.IsNullOrWhiteSpace(s.TypeMajorite) ? L.T("pour être adopté", "to be adopted") : char.ToUpperInvariant(s.TypeMajorite.Trim()[0]) + s.TypeMajorite.Trim()[1..])</dd>
            </div>
        }
    </dl>

    <div class="jauge" role="img" aria-label="@L.T("Pour", "For") @s.NbPour, @L.T("contre", "against") @s.NbContre@(s.SuffragesRequis is null ? "" : L.T($", majorité requise {s.SuffragesRequis}", $", majority required {s.SuffragesRequis}"))">
        <span class="j-pour" style="width:@(Pc(s.NbPour))%"></span>
        <span class="j-contre" style="width:@(Pc(s.NbContre))%"></span>
        @if (s.SuffragesRequis is not null)
        {
            <i class="j-seuil" style="left:@(Pc(s.SuffragesRequis))%" title="@L.T("Majorité requise", "Majority required") : @s.SuffragesRequis @L.T("voix", "votes")"></i>
        }
    </div>
    <p class="jauge-legende">
        <span class="c-pour"><b>@s.NbPour</b> @L.T("pour", "for")</span>
        <span class="c-contre"><b>@s.NbContre</b> @L.T("contre", "against")</span>
        <span class="c-abstention"><b>@s.NbAbstentions</b> @L.T("abstention", "abstention")@(s.NbAbstentions > 1 ? "s" : "")</span>
        @if (s.SuffragesRequis is not null) { <span class="seuil">▏@L.T("seuil", "threshold") : @s.SuffragesRequis @L.T("voix", "votes")</span> }
    </p>
</section>

@if (s.NominatifIncomplet)
{
    <p class="alerte" role="note">
        @Doute.Html(NiveauDoute.Incertain, L.T("décompte incomplet", "incomplete count"), L.T("La source ne détaille pas tous les votes de ce scrutin.", "The source does not detail every vote of this ballot."))
        @if (L.Anglais)
        {
            <text>Incomplete official data: for this vote, the @Chambres.Nom(s.Chambre, true) does not detail the vote of @s.NbVotesManquants @(s.NbVotesManquants > 1 ? Chambres.Membres(s.Chambre, true) : Chambres.Membre(s.Chambre, true)). Some “absent” members below may therefore have voted; only the official totals are authoritative.</text>
        }
        else
        {
            <text>Données officielles incomplètes : pour ce scrutin, l'@Chambres.Nom(s.Chambre) ne détaille pas le vote de
            @s.NbVotesManquants @Chambres.Membre(s.Chambre)@(s.NbVotesManquants > 1 ? "s" : ""). Certains « absents » ci-dessous peuvent donc
            avoir voté ; seuls les totaux officiels font foi.</text>
        }
    </p>
}

@if (s.Chambre == Chambres.Senat)
{
    <p class="note-source">@L.T("Au Sénat, « absent » signifie « n'a pas pris part au vote » : un sénateur absent de l'hémicycle peut y avoir fait voter un collègue par délégation, ce qui compte comme un vote.", "In the Senate, “absent” means “did not take part in the vote”: a senator absent from the chamber may have had a colleague vote for them by proxy, which counts as a vote.")</p>
}

<div class="bascule" role="group" aria-label="@L.T("Colorer les points", "Colour the dots")">
    <span>@L.T("Colorer par :", "Colour by:")</span>
    <button type="button" class="actif" data-mode="vote">@L.T("Vote", "Vote")</button>
    <button type="button" data-mode="groupe">@L.T("Groupe", "Group")</button>
    <label class="case anneau-case"><input type="checkbox" id="anneau" /> @L.T("Cercle de groupe", "Group ring")</label>
</div>

<div class="hemicycle-grand" id="hemicycle">
    <partial name="_Hemicycle" model="(Model.Vue, true)" />
</div>

<ul class="legende" id="legende-vote">
    <li class="d-pour"><i></i> @L.T("Pour", "For") <b>@Model.Sieges.Count(x => x.Position == Pos.Pour)</b></li>
    <li class="d-contre"><i></i> @L.T("Contre", "Against") <b>@Model.Sieges.Count(x => x.Position == Pos.Contre)</b></li>
    <li class="d-abstention"><i></i> @L.T("Abstention", "Abstention") <b>@Model.Sieges.Count(x => x.Position == Pos.Abstention)</b></li>
    <li class="d-nonvotant"><i></i> @L.T("Non-votant", "Non-voting") <b>@Model.Sieges.Count(x => x.Position == Pos.NonVotant)</b></li>
    <li class="d-absent"><i></i> @L.T("Absent", "Absent") <b>@Model.Sieges.Count(x => x.Position == Pos.Absent)</b></li>
</ul>

<ul class="legende" id="legende-groupe" hidden>
    @foreach (var g in Model.Groupes)
    {
        <li><span class="pastille" style="background:@(g.Couleur ?? "#8d949a")"></span> @g.Sigle <b>@g.Total</b></li>
    }
</ul>

@{
    // Communes : le décompte officiel est le nombre de noms des listes « ayes » / « noes » ; les scrutateurs (tellers) sont listés à part par la source. Ils ont voté et figurent dans les
    // points, la légende et les totaux par groupe : l'écart avec l'en-tête (ex. 290 / 94 contre 292 / 96) est EXPLIQUÉ ici, et non laissé à deviner (ce n'est pas un effet des procurations).
    var pourListe = Model.Sieges.Count(x => x.Position == Pos.Pour);
    var contreListe = Model.Sieges.Count(x => x.Position == Pos.Contre);
    var ecartPour = pourListe - (s.NbPour ?? 0);
    var ecartContre = contreListe - (s.NbContre ?? 0);
    var procurations = Model.Sieges.Count(x => x.ParDelegation && (x.Position == Pos.Pour || x.Position == Pos.Contre));
}
@if (s.Chambre == Chambres.Commons && (ecartPour > 0 || ecartContre > 0))
{
    <p class="note-source">@Doute.Html(NiveauDoute.Calcule, L.T("scrutateurs", "tellers"), L.T("Écart calculé par le site entre le décompte officiel et les votes listés : il correspond aux scrutateurs, que la source liste à part.", "Difference calculated by the site between the official count and the listed votes: it matches the tellers, whom the source lists separately."))
        @L.T($"Le décompte officiel ({s.NbPour} pour, {s.NbContre} contre) est le nombre de noms des listes « ayes » et « noes ». Les scrutateurs ({ecartPour} pour, {ecartContre} contre), listés à part par la source, ont voté : ils figurent dans l'hémicycle et les totaux par groupe ({pourListe} pour, {contreListe} contre). Les votes par procuration ({procurations}) sont compris dans les deux décomptes.",
             $"The official count ({s.NbPour} ayes, {s.NbContre} noes) is the number of names in the ayes and noes lists. The tellers ({ecartPour} ayes, {ecartContre} noes), listed separately by the source, voted: they appear in the seating chart and the group totals ({pourListe} ayes, {contreListe} noes). Proxy votes ({procurations}) are included in both counts.")</p>
}
@if (!string.IsNullOrWhiteSpace(s.Note))
{
    @if (s.Chambre == Chambres.UE)
    {
        <p class="note-source">@Doute.Html(NiveauDoute.Calcule, L.T("source tierce", "third-party source"), L.T("Données du Parlement européen retraitées par un projet indépendant, pas publiées directement par l'institution.", "European Parliament data reprocessed by an independent project, not published directly by the institution.")) @L.T(s.Note ?? "", "Third-party source: HowTheyVote.eu, based on the European Parliament's roll-call votes.")</p>
    }
    else
    {
        <p class="note-source"><strong>@L.T("Note officielle :", "Official note:")</strong> @s.Note</p>
    }
}

<h2>@L.T("Par groupe", "By group")</h2>
<div class="table-wrap">
    <table class="groupes">
        <thead>
            <tr>
                <th>@L.T("Groupe", "Group")</th>
                <th class="th-pour">@L.T("Pour", "For")</th><th class="th-contre">@L.T("Contre", "Against")</th><th class="th-abstention">@L.T("Abst.", "Abst.")</th>
                <th>@L.T("Non-votant", "Non-voting")</th><th>@L.T("Absents", "Absent")</th><th>Total</th><th class="col-barre">@L.T("Répartition", "Breakdown")</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var g in Model.Groupes)
        {
            string W(int n) => g.Total == 0 ? "0" : (100.0 * n / g.Total).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            <tr>
                <th scope="row"><span class="pastille" style="background:@(g.Couleur ?? "#8d949a")"></span>@g.Sigle</th>
                <td class="c-pour">@g.Pour</td><td class="c-contre">@g.Contre</td><td class="c-abstention">@g.Abstention</td>
                <td>@g.NonVotant</td><td>@g.Absent</td><td>@g.Total</td>
                <td class="col-barre">
                    <div class="barre-empilee fine" role="img" aria-label="@L.T("Répartition des votes du groupe", "Vote breakdown of the group") @g.Sigle">
                        <span class="b-pour" style="width:@(W(g.Pour))%"></span>
                        <span class="b-contre" style="width:@(W(g.Contre))%"></span>
                        <span class="b-abstention" style="width:@(W(g.Abstention))%"></span>
                        <span class="b-non_votant" style="width:@(W(g.NonVotant))%"></span>
                        <span class="b-absent" style="width:@(W(g.Absent))%"></span>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<h2>@L.T("Tous les ", "All ")@Chambres.Membres(s.Chambre, L.Anglais)</h2>
<input id="filtre" class="filtre" type="search" placeholder="@L.T("Chercher un nom, un groupe…", "Search a name, a group…")" aria-label="@L.T("Chercher un élu", "Search an elected official")" autocomplete="off" />
<div class="table-wrap">
    <table class="deputes" id="deputes">
        <thead><tr><th>@char.ToUpper(Chambres.Membre(s.Chambre, L.Anglais)[0])@Chambres.Membre(s.Chambre, L.Anglais)[1..]</th><th>@L.T("Groupe", "Group")</th><th>Vote</th></tr></thead>
        <tbody>
        @foreach (var d in Model.Sieges.OrderBy(x => x.Nom).ThenBy(x => x.Prenom))
        {
            <tr data-q="@((d.NomComplet + " " + d.GroupeSigle).ToLowerInvariant())">
                <td>@if (d.Lien is { } lienFiche) { <a href="@L.Lien(lienFiche)">@Noms.Html(d.Prenom, d.Nom)</a> } else { @Noms.Html(d.Prenom, d.Nom) }</td>
                <td>@d.GroupeSigle</td>
                <td>
                    <span class="badge b-@d.Position">@Libelle(d.Position)</span>
                    @if (d.Rectifie)
                    {
                        <span class="tag tag-rectifie">@(d.OrigineInconnue ? L.T("mise au point", "vote correction") : L.T("rectifié (à l'origine : ", "corrected (originally: ") + (d.PositionOrigine is null ? L.T("absent", "absent") : Libelle(d.PositionOrigine).ToLowerInvariant()) + ")")</span>
@if (d.OrigineInconnue) { @Doute.Html(NiveauDoute.Manquant, L.T("origine inconnue", "original vote unknown"), L.T("La position publiée au scrutin avant la mise au point n'est pas fournie par la source.", "The position published at the vote before the correction is not provided by the source.")) }
                    }
                    @if (d.ParDelegation)
                    {
                        <span class="tag tag-delegation">@L.T("par délégation", "by proxy")</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<script>
    (function () {
        var svg = document.querySelector('#hemicycle svg');
        var lv = document.getElementById('legende-vote');
        var lg = document.getElementById('legende-groupe');
        var boutons = document.querySelectorAll('.bascule button');
        boutons.forEach(function (b) {
            b.addEventListener('click', function () {
                var parGroupe = b.dataset.mode === 'groupe';
                svg.classList.toggle('par-groupe', parGroupe);
                lv.hidden = parGroupe;
                lg.hidden = !parGroupe;
                boutons.forEach(function (x) { x.classList.toggle('actif', x === b); });
            });
        });
        var anneau = document.getElementById('anneau');
        anneau.addEventListener('change', function () { svg.classList.toggle('anneau', anneau.checked); });
    })();
    (function () {
        var input = document.getElementById('filtre');
        var rows = document.querySelectorAll('#deputes tbody tr');
        input.addEventListener('input', function () {
            var q = input.value.trim().toLowerCase();
            rows.forEach(function (r) { r.hidden = q && r.dataset.q.indexOf(q) === -1; });
        });
    })();
</script>
