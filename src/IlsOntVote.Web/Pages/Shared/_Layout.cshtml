@inject IlsOntVote.Web.Services.PaysSite SitePays
@{
    // Description du site propre à un pays (balise description, partage) ; null pour la France (texte par défaut).
    var descPays = L.Pays == "GB"
        ? L.T("Pour chaque division des Communes et des Lords, voyez d'un coup d'œil le vote de chaque parlementaire : pour, contre, les deux couloirs, n'a pas voté.", "For each division of the House of Commons and the House of Lords, see at a glance how every member voted: aye, no, both lobbies, did not vote.")
        : L.Pays == "US"
            ? L.T("Pour chaque vote nominal de la Chambre des représentants et du Sénat des États-Unis, voyez d'un coup d'œil le vote de chaque élu : pour, contre, présent, n'a pas voté.", "For each roll call vote of the US House of Representatives and Senate, see at a glance how every member voted: yea, nay, present, not voting.")
            : L.Pays == "IT"
                ? L.T("Pour chaque vote final du Parlement italien (Chambre des députés et Sénat), voyez d'un coup d'œil le vote de chaque élu : favorable, contraire, abstention, n'a pas voté.", "For each final vote of the Italian Parliament (Chamber of Deputies and Senate), see at a glance how every member voted: in favour, against, abstained, did not vote.")
                : null;
}
<!DOCTYPE html>
<html lang="@L.Code">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>document.documentElement.classList.add("js");var th="dark";try{th=localStorage.getItem("theme")==="light"?"light":"dark";}catch(e){}document.documentElement.setAttribute("data-theme",th);/* sombre par défaut ; le bouton ◐ mémorise un choix clair */</script>
    <script>try{if(localStorage.getItem("ordreNom")==="nom-prenom")document.documentElement.setAttribute("data-ordre","nom-prenom");}catch(e){}</script>
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} — {(L.Pays is not null ? "They voted" : "Ils ont voté")}" : L.Pays == "GB" ? L.T("They voted — qui a voté quoi au Parlement britannique", "They voted — who voted what in the UK Parliament") : L.Pays == "US" ? L.T("They voted — qui a voté quoi au Congrès américain", "They voted — who voted what in the US Congress") : L.T("Ils ont voté — qui a voté quoi à l'Assemblée nationale et au Sénat", "Ils ont voté (They voted) — who voted what in the French National Assembly, Senate and European Parliament"))</title>
    <meta name="description" content="@(ViewData["Description"] ?? descPays ?? L.T("Pour chaque grand texte de loi, voyez d'un coup d'œil le vote de chaque député et de chaque sénateur : pour, contre, abstention, absent.", "For each major law, see at a glance how every French deputy, senator and MEP voted: for, against, abstention, absent."))" />
    @if (ViewData["NoIndex"] is true)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    @{
        // Adresse canonique : toujours www.ilsontvote.org, sans paramètres (tri, pages, filtres) -> pas de contenu dupliqué.
        // Chaque langue a sa propre adresse canonique ; les balises hreflang relient les deux versions.
        var site = "https://www.ilsontvote.org";
        var cheminSeul = Context.Request.Path.Value ?? "/";
        // Page d'un pays hors France (/uk/…) : une seule adresse (préfixe du pays, interface anglaise), pas de version fr / en.
        var prefixePays = L.Pays is null ? "" : Context.Request.PathBase.Value;
        string Absolu(bool en) => L.Pays is not null ? site + prefixePays + (cheminSeul == "/" ? "" : cheminSeul) : site + (en ? "/en" + (cheminSeul == "/" ? "" : cheminSeul) : cheminSeul);
        var canon = Absolu(L.Anglais);
        var titrePage = ViewData["Title"] is string tp && tp.Length > 0 ? tp : (L.Pays is not null ? "They voted" : "Ils ont voté");
        var descPage = ViewData["Description"] ?? descPays ?? L.T("Pour chaque grand texte de loi, voyez d'un coup d'œil le vote de chaque député et de chaque sénateur : pour, contre, abstention, absent.", "For each major law, see at a glance how every French deputy, senator and MEP voted: for, against, abstention, absent.");
    }
    <link rel="canonical" href="@canon" />
    @if (ViewData["NoIndex"] is not true && L.Pays is null)
    {
        <link rel="alternate" hreflang="fr" href="@Absolu(false)" />
        <link rel="alternate" hreflang="en" href="@Absolu(true)" />
        <link rel="alternate" hreflang="x-default" href="@Absolu(false)" />
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@(L.Pays is not null ? "They voted" : "Ils ont voté")" />
    <meta property="og:locale" content="@(L.Anglais ? "en_GB" : "fr_FR")" />
    <meta property="og:locale:alternate" content="@(L.Anglais ? "fr_FR" : "en_GB")" />
    <meta name="theme-color" content="#14171a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content="@titrePage" />
    <meta property="og:description" content="@descPage" />
    <meta property="og:url" content="@canon" />
    @{ var image = (ViewData["OgImage"] as string) ?? L.Lien("/apercu/defaut.png"); }
    @* ?v= : version de la mise en page des images (les messageries gardent l'aperçu en cache plusieurs jours : changer ce numéro les force à relire l'image après un nouveau dessin). *@
    <meta property="og:image" content="https://www.ilsontvote.org@(image)?v=3" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="@titrePage" />
    <meta name="twitter:card" content="summary_large_image" />
    @{
        // Données structurées (schema.org, JSON-LD) : celles de la page (ViewData["JsonLd"]) et, sur l'accueil, celles du site avec sa
        // recherche. Sérialisées par System.Text.Json (échappe < > & : impossible de fermer la balise script depuis une donnée).
        var jsonLd = new List<object>();
        if (ViewData["JsonLd"] is object pageLd) jsonLd.Add(pageLd);
        if (cheminSeul == "/")
        {
            jsonLd.Add(new Dictionary<string, object>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "WebSite",
                ["name"] = L.Pays is not null ? "They voted" : "Ils ont voté",
                ["alternateName"] = "They voted",
                ["url"] = Absolu(L.Anglais),
                ["inLanguage"] = L.Code,
                ["publisher"] = new Dictionary<string, object>
                {
                    ["@type"] = "Person", ["name"] = "Thomas Gourgnier", ["url"] = "https://www.rebisway.com/fr/",
                },
                ["potentialAction"] = new Dictionary<string, object>
                {
                    ["@type"] = "SearchAction",
                    ["target"] = site + (L.Anglais ? "/en" : "") + "/textes?q={search_term_string}",
                    ["query-input"] = "required name=search_term_string",
                },
            });
        }
    }
    @foreach (var ld in jsonLd)
    {
        @Html.Raw("<script type=\"application/ld+json\">" + System.Text.Json.JsonSerializer.Serialize(ld) + "</script>")
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var chemin = Context.Request.Path.Value ?? "/";
        var resolutions = Context.Request.Query["nature"] == "resolution";
        string Actif(string prefixe) => chemin.StartsWith(prefixe, StringComparison.OrdinalIgnoreCase) ? " aria-current=\"page\"" : "";
    }
    <header class="site-header">
        <div class="wrap">
            <a class="brand" href="@L.Lien("/")">@if (L.Pays is not null) { <text>They <em>voted</em></text> } else { <text>Ils ont <em>voté</em></text> }</a>
            <nav class="menu" id="menu-principal" aria-label="@L.T("Navigation principale", "Main navigation")">
                @if (chemin != "/" && chemin != "")
                {
                    <a href="@L.Lien("/")">@L.T("Accueil", "Home")</a>
                }
                @{
                    var textesActif = chemin.StartsWith("/lois", StringComparison.OrdinalIgnoreCase) || chemin.StartsWith("/texte", StringComparison.OrdinalIgnoreCase) || chemin.StartsWith("/scrutin", StringComparison.OrdinalIgnoreCase) || chemin.StartsWith("/petition", StringComparison.OrdinalIgnoreCase);
                    var elusActif = chemin.StartsWith("/depute", StringComparison.OrdinalIgnoreCase) || chemin.StartsWith("/senateur", StringComparison.OrdinalIgnoreCase) || chemin.StartsWith("/eurodepute", StringComparison.OrdinalIgnoreCase);
                }
                @if (L.Pays == "US")
                {
                    @* Congrès : votes nominaux, élus de chaque chambre, participation, statistiques, données. *@
                    <a href="@L.Lien("/textes")" @Html.Raw(Actif("/textes") + Actif("/scrutin"))>@L.T("Votes nominaux", "Roll call votes")</a>
                    <details class="plus" @Html.Raw(Actif("/representative") + Actif("/senator") + Actif("/elus") != "" ? "data-actif" : "")>
                        <summary>@L.T("Parlementaires", "Members")</summary>
                        <div class="plus-liste">
                            <a href="@L.Lien("/representatives")" @Html.Raw(Actif("/representative"))>@L.T("Représentants", "Representatives")</a>
                            <a href="@L.Lien("/senators")" @Html.Raw(Actif("/senator"))>@L.T("Sénateurs", "Senators")</a>
                            <a href="@L.Lien("/elus")" @Html.Raw(Actif("/elus"))>@L.T("Participation", "Participation")</a>
                        </div>
                    </details>
                    <a href="@L.Lien("/statistiques")" @Html.Raw(Actif("/statistiques"))>@L.T("Statistiques", "Statistics")</a>
                    <a href="@L.Lien("/donnees")" @Html.Raw(Actif("/donnees"))>@L.T("Données", "Data")</a>
                }
                else if (L.Pays == "IT")
                {
                    @* Italie : votes de la Chambre, députés, participation, statistiques, données. *@
                    <a href="@L.Lien("/textes")" @Html.Raw(Actif("/textes") + Actif("/scrutin"))>@L.T("Votes nominaux", "Roll call votes")</a>
                    <details class="plus" @Html.Raw(Actif("/deput") + Actif("/senator") + Actif("/elus") != "" ? "data-actif" : "")>
                        <summary>@L.T("Parlementaires", "Members")</summary>
                        <div class="plus-liste">
                            <a href="@L.Lien("/deputies")" @Html.Raw(Actif("/deput"))>@L.T("Députés", "Deputies")</a>
                            <a href="@L.Lien("/senatori")" @Html.Raw(Actif("/senator"))>@L.T("Sénateurs", "Senators")</a>
                            <a href="@L.Lien("/elus")" @Html.Raw(Actif("/elus"))>@L.T("Participation", "Participation")</a>
                        </div>
                    </details>
                    <a href="@L.Lien("/statistiques")" @Html.Raw(Actif("/statistiques"))>@L.T("Statistiques", "Statistics")</a>
                    <a href="@L.Lien("/donnees")" @Html.Raw(Actif("/donnees"))>@L.T("Données", "Data")</a>
                }
                else if (L.Pays is not null)
                {
                    @* Site d'un pays (Communes) : seulement ce qui existe pour lui. *@
                    @* Mêmes regroupements que le menu français : Textes / Parlementaires, puis Statistiques et Données. *@
                    <details class="plus" @Html.Raw(Actif("/textes") + Actif("/scrutin") + Actif("/bill") + Actif("/petition") != "" ? "data-actif" : "")>
                        <summary>@L.T("Textes", "Texts")</summary>
                        <div class="plus-liste">
                            @if (PaysSite.APetitionsEtProjets(L.Pays)) {
                            <a href="@L.Lien("/bills")" @Html.Raw(Actif("/bill"))>@L.T("Projets de loi", "Bills")</a> }
                            <a href="@L.Lien("/textes")" @Html.Raw(Actif("/textes") + Actif("/scrutin"))>@L.T("Scrutins (divisions)", "Divisions")</a>
                            @if (PaysSite.APetitionsEtProjets(L.Pays)) {
                            <a href="@L.Lien("/petitions")" @Html.Raw(Actif("/petition"))>@L.T("Pétitions", "Petitions")</a> }
                        </div>
                    </details>
                    <details class="plus" @Html.Raw(Actif("/member") + Actif("/lord") + Actif("/elus") != "" ? "data-actif" : "")>
                        <summary>@L.T("Parlementaires", "Members")</summary>
                        <div class="plus-liste">
                            <a href="@L.Lien("/members")" @Html.Raw(Actif("/member"))>@L.T("Députés", "MPs")</a>
                            <a href="@L.Lien("/lords")" @Html.Raw(Actif("/lord"))>@L.T("Pairs (Lords)", "Lords")</a>
                            <a href="@L.Lien("/elus")" @Html.Raw(Actif("/elus"))>@L.T("Présence", "Attendance")</a>
                        </div>
                    </details>
                    <a href="@L.Lien("/statistiques")" @Html.Raw(Actif("/statistiques"))>@L.T("Statistiques", "Statistics")</a>
                    <a href="@L.Lien("/donnees")" @Html.Raw(Actif("/donnees"))>@L.T("Données", "Data")</a>
                }
                else
                {
                @* Deux menus déroulants (<details> natif : clavier et sans JavaScript) ; à plat sur téléphone. *@
                <details class="plus" @Html.Raw(textesActif ? "data-actif" : "")>
                    <summary>@L.T("Textes", "Texts")</summary>
                    <div class="plus-liste">
                        <a href="@L.Lien("/lois")" @Html.Raw(Actif("/lois")) @Html.Raw(Actif("/texte/"))>@L.T("Lois", "Laws")</a>
                        <a href="@L.Lien("/textes")" @Html.Raw(Actif("/scrutin") + (chemin.StartsWith("/textes", StringComparison.OrdinalIgnoreCase) && !resolutions ? " aria-current=\"page\"" : ""))>@L.T("Scrutins", "Votes")</a>
                        <a href="@L.Lien("/textes")?nature=resolution" @Html.Raw(chemin.StartsWith("/textes", StringComparison.OrdinalIgnoreCase) && resolutions ? "aria-current=\"page\"" : "")>@L.T("Résolutions", "Resolutions")</a>
                        <a href="@L.Lien("/petitions")" @Html.Raw(Actif("/petitions"))>@L.T("Pétitions", "Petitions")</a>
                    </div>
                </details>
                <details class="plus" @Html.Raw(elusActif ? "data-actif" : "")>
                    <summary>@L.T("Parlementaires", "Members")</summary>
                    <div class="plus-liste">
                        <a href="@L.Lien("/deputes")" @Html.Raw(Actif("/depute"))>@L.T("Députés", "Deputies")</a>
                        <a href="@L.Lien("/senateurs")" @Html.Raw(Actif("/senateur"))>@L.T("Sénateurs", "Senators")</a>
                        <a href="@L.Lien("/eurodeputes")" @Html.Raw(Actif("/eurodepute"))>@L.T("Eurodéputés", "MEPs")</a>
                    </div>
                </details>
                <a href="@L.Lien("/statistiques")" @Html.Raw(Actif("/statistiques"))>@L.T("Statistiques", "Statistics")</a>
                <a href="@L.Lien("/donnees")" @Html.Raw(Actif("/donnees"))>@L.T("Données", "Data")</a>
                }
            </nav>
            @* Choix du pays : affiché seulement quand au moins un pays autre que la France est publié. ?pays= mémorise le choix (cookie) et mène à l'accueil du pays. *@
            @if (SitePays.Actifs.Count > 0)
            {
                @* Menu de pays avec drapeau (image : les émojis de drapeau s'affichent en lettres sous Windows). Fichier /img/flags/{iso}.svg ; absent : image retirée, le nom reste. *@
                var paysCode = (L.Pays ?? "FR").ToLowerInvariant();
                var paysNom = L.Pays is null ? "France" : L.T(SitePays.Actifs.FirstOrDefault(x => x.Code == L.Pays)?.NomFr ?? L.Pays, SitePays.Actifs.FirstOrDefault(x => x.Code == L.Pays)?.NomEn ?? L.Pays);
                <details class="pays-choix">
                    <summary aria-label="@L.T("Pays", "Country")"><img src="/img/flags/@(paysCode).svg" alt="" width="20" height="14" onerror="this.remove()" /> <span>@paysNom</span></summary>
                    <div class="pays-liste">
                        <a href="/?pays=fr" @Html.Raw(L.Pays is null ? "aria-current=\"true\"" : "")><img src="/img/flags/fr.svg" alt="" width="20" height="14" onerror="this.remove()" /> France</a>
                        @foreach (var p in SitePays.Actifs)
                        {
                            <a href="/?pays=@p.Prefixe" @Html.Raw(L.Pays == p.Code ? "aria-current=\"true\"" : "")><img src="/img/flags/@(p.Code.ToLowerInvariant()).svg" alt="" width="20" height="14" onerror="this.remove()" /> @L.T(p.NomFr, p.NomEn)</a>
                        }
                    </div>
                </details>
            }
            <nav class="langue" aria-label="@L.T("Langue", "Language")">
                @* hl= mémorise le choix explicite (cookie) : sinon la langue du navigateur reprendrait la main *@
                <a href="@L.Variante(false)@(L.Variante(false).Contains('?') ? "&" : "?")hl=fr" rel="nofollow" lang="fr" hreflang="fr" @Html.Raw(L.Anglais ? "" : "aria-current=\"true\"")>FR</a>
                <a href="@L.Variante(false)@(L.Variante(false).Contains('?') ? "&" : "?")hl=en" rel="nofollow" lang="en" hreflang="en" @Html.Raw(L.Anglais ? "aria-current=\"true\"" : "")>EN</a>
            </nav>
            <button type="button" class="theme-btn" id="theme-btn" title="@L.T("Thème clair / sombre", "Light / dark theme")" aria-label="@L.T("Basculer entre thème clair et sombre", "Switch between light and dark theme")">◐</button>
            <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu-principal">☰ @L.T("Menu", "Menu")</button>
        </div>
    </header>

    <main class="wrap">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="wrap">
            @if (L.Pays == "US")
            {
                <p>@L.TH("Sources : <a href=\"https://clerk.house.gov/Votes\">greffe de la Chambre</a> (officiel) ; Sénat via <a href=\"https://voteview.com/\">Voteview</a> (UCLA, Université de Géorgie) d'après les <a href=\"https://www.senate.gov/legislative/votes_new.htm\">enregistrements du Sénat</a>.", "Sources: <a href=\"https://clerk.house.gov/Votes\">Clerk of the House</a> (official); Senate via <a href=\"https://voteview.com/\">Voteview</a> (UCLA, University of Georgia) from the <a href=\"https://www.senate.gov/legislative/votes_new.htm\">Senate records</a>.")</p>
            }
            else if (L.Pays == "IT")
            {
                <p>@L.TH("Sources : <a href=\"https://dati.camera.it/\">dati.camera.it</a>, open data de la Chambre des députés (<a href=\"https://creativecommons.org/licenses/by-sa/4.0/deed.fr\">CC BY-SA 4.0</a>) ; <a href=\"https://dati.senato.it/\">dati.senato.it</a>, open data du Sénat.", "Sources: <a href=\"https://dati.camera.it/\">dati.camera.it</a>, open data of the Chamber of Deputies (<a href=\"https://creativecommons.org/licenses/by-sa/4.0/\">CC BY-SA 4.0</a>); <a href=\"https://dati.senato.it/\">dati.senato.it</a>, open data of the Senate.")</p>
            }
            else if (L.Pays == "GB")
            {
                <p>@L.TH("Sources : <a href=\"https://commonsvotes-api.parliament.uk/\">Parlement britannique, API Commons et Lords Votes</a> (<a href=\"https://www.parliament.uk/site-information/copyright-parliament/open-parliament-licence/\">Open Parliament Licence</a>).", "Source: <a href=\"https://commonsvotes-api.parliament.uk/\">UK Parliament, Commons and Lords Votes APIs</a> (<a href=\"https://www.parliament.uk/site-information/copyright-parliament/open-parliament-licence/\">Open Parliament Licence</a>).")</p>
            }
            else
            {
            <p>
                @L.TH("Sources : <a href=\"https://data.assemblee-nationale.fr/\">data.assemblee-nationale.fr</a>, <a href=\"https://data.senat.fr/\">data.senat.fr</a>, pétitions via <a href=\"https://www.data.gouv.fr/\">data.gouv.fr</a>, Parlement européen via <a href=\"https://howtheyvote.eu/\">HowTheyVote.eu</a> (<a href=\"https://opendatacommons.org/licenses/odbl/1-0/\">ODbL</a>).",
                      "Sources: <a href=\"https://data.assemblee-nationale.fr/\">data.assemblee-nationale.fr</a>, <a href=\"https://data.senat.fr/\">data.senat.fr</a>, petitions via <a href=\"https://www.data.gouv.fr/\">data.gouv.fr</a>, European Parliament via <a href=\"https://howtheyvote.eu/\">HowTheyVote.eu</a> (<a href=\"https://opendatacommons.org/licenses/odbl/1-0/\">ODbL</a>).")
            </p>
            }
            <p>
                © 2026 Thomas Gourgnier ·
                <a href="@L.Lien("/soutenir")">@L.T("Soutenir", "Support us")</a> ·
                <a href="@L.Lien("/methodologie")">@L.T("Méthodologie et limites", "Methodology and limits")</a> ·
                <a href="@L.Lien("/donnees")">@L.T("Données ouvertes", "Open data")</a> ·
                <a href="@L.Lien("/mentions-legales")">@L.T("Mentions légales et confidentialité", "Legal notice and privacy")</a> ·
                <a href="https://github.com/rebisway/ilsontvote">@L.T("Code source", "Source code")</a> @L.T("libre", "free software") (GPL-3.0) ·
                <a href="https://www.rebisway.com">@L.T("La Voie du Rébis", "The Rebis Way")</a> ·
                <a href="mailto:contact@rebisway.com">contact@rebisway.com</a> ·
                <a href="/Admin">Administration</a>
            </p>
        </div>
    </footer>
    <script>
        (function () {
            var racine = document.documentElement;
            var boutons = document.querySelectorAll(".ordre-nom button");
            function marquer() {
                var courant = racine.getAttribute("data-ordre") || "prenom-nom";
                boutons.forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.ordre === courant ? "true" : "false"); });
            }
            boutons.forEach(function (b) {
                b.addEventListener("click", function () {
                    if (b.dataset.ordre === "nom-prenom") racine.setAttribute("data-ordre", "nom-prenom");
                    else racine.removeAttribute("data-ordre");
                    try { localStorage.setItem("ordreNom", b.dataset.ordre); } catch (e) { }
                    marquer();
                });
            });
            marquer();
        })();
    </script>
<script>
    // Bascule clair/sombre : mémorisée dans le navigateur ; sans choix, le thème du système s'applique (CSS prefers-color-scheme).
    // Menu mobile : replié derrière le bouton « Menu » (sans JavaScript, il reste déployé).
    (function () {
        (function () { var mq = window.matchMedia("(max-width: 720px)"), ds = document.querySelectorAll("details.plus");
            function maj() { ds.forEach(function (d) { if (mq.matches) d.setAttribute("open", ""); else d.removeAttribute("open"); }); }
            maj(); if (mq.addEventListener) mq.addEventListener("change", maj); })();
        document.addEventListener("click", function (e) { document.querySelectorAll("details.pays-choix[open]").forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute("open"); }); });
        document.addEventListener("click", function (e) { if (window.matchMedia("(max-width: 720px)").matches) return; document.querySelectorAll("details.plus[open]").forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute("open"); }); });
        var b = document.getElementById("menu-btn"), m = document.getElementById("menu-principal");
        if (!b || !m) return;
        b.addEventListener("click", function () {
            var ouvert = m.classList.toggle("ouvert");
            b.setAttribute("aria-expanded", ouvert ? "true" : "false");
        });
    })();
    (function () {
        var b = document.getElementById("theme-btn"), r = document.documentElement;
        if (!b) return;
        b.addEventListener("click", function () {
            var sombre = (r.getAttribute("data-theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")) === "dark";
            var n = sombre ? "light" : "dark";
            r.setAttribute("data-theme", n);
            try { localStorage.setItem("theme", n); } catch (e) { }
        });
    })();
</script>
<script>
    // Filtres dynamiques (formulaires .filtres-auto) : liste, case et date envoient à chaque changement ; la recherche après une courte pause.
    // Le champ de recherche reprend le focus après rechargement. Sans JavaScript, le bouton « Filtrer » reste visible.
    (function () {
        document.documentElement.classList.add("js");
        document.querySelectorAll("form.filtres-auto").forEach(function (f) {
            var t;
            f.addEventListener("change", function (e) { if (e.target.type !== "search") f.submit(); });
            var q = f.querySelector('input[type="search"]');
            if (q) {
                q.addEventListener("input", function () {
                    clearTimeout(t);
                    t = setTimeout(function () { try { sessionStorage.setItem("refocus", "1"); } catch (e) { } f.submit(); }, 600);
                });
                try { if (sessionStorage.getItem("refocus")) { sessionStorage.removeItem("refocus"); q.focus(); q.setSelectionRange(q.value.length, q.value.length); } } catch (e) { }
            }
        });
    })();
</script>
</body>
</html>
