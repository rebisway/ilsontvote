@page
@using IlsOntVote.Web.Models
@using IlsOntVote.Web.Services
@model ParlementaireModel
@{
    var e = Model.Elu;
    var b = Model.Bilan;
    var fr = L.Culture;
    ViewData["Title"] = e.NomComplet;
    ViewData["Fil"] = new List<(string, string)> { (L.T("accueil"), L.Lien("/")), (L.Membres(e.Chambre), L.Lien("/" + Chambres.Liste(e.Chambre))), (e.NomComplet, L.Lien("/" + Chambres.Fiche(e.Chambre) + "/" + e.Slug)) };
    ViewData["JsonLd"] = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Person",
        ["name"] = e.NomComplet,
        ["jobTitle"] = L.Membre(e.Chambre),
        ["affiliation"] = new Dictionary<string, object> { ["@type"] = "GovernmentOrganization", ["name"] = Chambres.Nom(e.Chambre, true) },
    };
    ViewData["Description"] = L.Tf("elu-description", e.NomComplet, L.Membre(e.Chambre), string.IsNullOrEmpty(e.GroupeSigle) ? "" : " (" + e.GroupeSigle + ")");
    double Pct(int n) => b.Total == 0 ? 0 : 100.0 * n / b.Total;
}

<div class="retour retour-nav">
    <a href="@L.Lien("/" + Chambres.Liste(e.Chambre))">@L.T("tous-les-1315")@L.Membres(e.Chambre)</a>
    <partial name="_Voisins" model="Model.Voisins" />
</div>

<header class="fiche-tete">
    <h1>@Noms.Html(e.Prenom, e.Nom)</h1>
<partial name="_OrdreNom" />
    <p class="meta">
        @L.Chambre(e.Chambre)
        @if (!string.IsNullOrEmpty(e.GroupeSigle))
        {
            <text> · </text><span class="pastille" style="background:@(e.GroupeCouleur ?? "#8d949a")"></span><span title="@e.GroupeLibelle">@e.GroupeSigle</span>
        }
        @if (!string.IsNullOrEmpty(e.Departement)) { <text> · @Drapeaux.Avec(e.Chambre, e.Departement, L)</text> }
        @if (!e.EnExercice) { <text> · @L.T("ancien")@L.Membre(e.Chambre)</text> }
        @if (e.EnExercice && e.Statut is not null) { <text> · </text>@Doute.Html(NiveauDoute.Incertain, e.StatutLibelle(L)!, L.T("statut-du-jour-d-apres-l")) }
    </p>
    @if (Model.Mandats.Count > 0)
    {
        // Période(s) de mandat : le nombre de scrutins d'un élu récent est faible, ce qui peut étonner (100 % de 102 scrutins, par exemple).
        var periodes = Model.Mandats.Select(m => m.DateFin is null
            ? L.T("depuis-le") + m.DateDebut.ToString("d MMMM yyyy", fr)
            : L.T("du-87b6") + m.DateDebut.ToString("d MMMM yyyy", fr) + L.T("au-9fdd") + m.DateFin.Value.ToString("d MMMM yyyy", fr));
        <p class="meta">@(Model.Mandats.Count > 1 ? L.T("plur-mandat-pl") : L.T("plur-mandat-sg"))@string.Join(" ; ", periodes)@(e.Chambre == Chambres.AN ? L.T("prise-de-fonction") : "")</p>
    }
</header>

<section class="bilan" aria-labelledby="t-bilan">
    <h2 id="t-bilan">@L.T("participation-aux-scrutins-publics")</h2>
    @if (b.Total == 0)
    {
        <p class="vide">@L.T("aucun-scrutin-public-enregistre-pendant-son")</p>
    }
    else
    {
        <p class="bilan-chiffre"><strong>@b.TauxParticipation.ToString("0", fr) %</strong> <span>@L.T("des") @b.Total.ToString("N0", fr) @L.T("scrutins-publics-tenus-pendant-son-mandat")</span></p>
        @if (L.Pays == "IT") { <p class="note-source">@Doute.Html(NiveauDoute.Incertain, L.T("import-partiel"), L.T("seuls-les-votes-finaux-et-pour"))</p> }
        <div class="barre-empilee" role="img" aria-label="@L.T("repartition-de-ses-votes")">
            <span class="b-pour" style="width:@Pct(b.Pour).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
            <span class="b-contre" style="width:@Pct(b.Contre).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
            <span class="b-abstention" style="width:@Pct(b.Abstention).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
            <span class="b-non_votant" style="width:@Pct(b.NonVotant).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
            <span class="b-absent" style="width:@Pct(b.Absent).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
        </div>
        <ul class="legende">
            <li class="d-pour"><i></i> @L.T("pour-2ecc") <b>@b.Pour</b></li>
            <li class="d-contre"><i></i> @L.T("contre-b885") <b>@b.Contre</b></li>
            <li class="d-abstention"><i></i> @L.T("abstention") <b>@b.Abstention</b></li>
            <li class="d-nonvotant"><i></i> @L.T("non-votant") <b>@b.NonVotant</b></li>
            <li class="d-absent"><i></i> @L.T("absent") <b>@b.Absent</b></li>
            <li class="d-delegation"><i></i> @L.T("par-delegation") <b>@b.Delegation</b></li>
            <li class="d-rectifie"><i></i> @L.T("mise-au-point-rectifie") <b>@b.MiseAuPoint</b></li>
        </ul>
        @if (e.Chambre == Chambres.Senat)
        {
            <p class="note-source">@L.T("au-senat-absent-signifie-n-a")</p>
        }
    }
</section>

@if (Model.Mensuel.Count > 1)
{
    // Barres mensuelles : hauteur totale = participation (vote exprimé, délégation comprise), partie foncée = présence (vote exprimé par l'élu
    // lui-même). Une barre par mois ayant eu au moins un scrutin à sa charge ; l'infobulle donne les nombres exacts.
    var n = Model.Mensuel.Count;
    const double largeur = 720, hauteur = 130, marge = 22;
    var pas = largeur / n;
    var barre = Math.Max(1.5, pas * 0.72);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    <section class="courbe" aria-labelledby="t-courbe">
        <h2 id="t-courbe">@L.T("participation-mois-par-mois")</h2>
        <svg viewBox="0 0 @largeur.ToString(inv) @((hauteur + marge).ToString(inv))" class="courbe-svg" role="img" aria-label="@L.T("participation-mensuelle-de-l-elu-une")">
            @foreach (var pct in new[] { 0, 50, 100 })
            {
                var y = hauteur - hauteur * pct / 100.0;
                <line x1="0" x2="@largeur.ToString(inv)" y1="@y.ToString("0.#", inv)" y2="@y.ToString("0.#", inv)" class="courbe-grille" />
                @Html.Raw($"<text x=\"2\" y=\"{(y - 3).ToString("0.#", inv)}\" class=\"courbe-axe\">{pct} %</text>")   @* « <text> » est une balise réservée de Razor : on l'émet en brut *@
            }
            @for (var i = 0; i < n; i++)
            {
                var m = Model.Mensuel[i];
                var x = i * pas + (pas - barre) / 2;
                var hTotal = hauteur * m.ParticipationPct / 100.0;
                var hPres = hauteur * m.PresencePct / 100.0;
                <g class="courbe-mois">
                    <title>@m.Mois.ToString("MMMM yyyy", fr) : @L.T("participation") @m.ParticipationPct.ToString("0", fr) % (@m.Votants / @m.Scrutins), @L.T("presence-a874") @m.PresencePct.ToString("0", fr) % (@(m.Votants - m.Delegations) / @m.Scrutins)</title>
                    @* Barre = participation : le bas (présence, neutre) + le haut (votes par délégation, couleur de l'étiquette « par délégation »). *@
                    <rect x="@x.ToString("0.##", inv)" y="@((hauteur - hTotal).ToString("0.##", inv))" width="@barre.ToString("0.##", inv)" height="@((hTotal - hPres).ToString("0.##", inv))" class="courbe-delegation" />
                    <rect x="@x.ToString("0.##", inv)" y="@((hauteur - hPres).ToString("0.##", inv))" width="@barre.ToString("0.##", inv)" height="@hPres.ToString("0.##", inv)" class="courbe-presence" />
                </g>
                @if (i == 0 || Model.Mensuel[i].Mois.Year != Model.Mensuel[i - 1].Mois.Year)
                {
                    @Html.Raw($"<text x=\"{(i * pas).ToString("0.#", inv)}\" y=\"{(hauteur + 15).ToString(inv)}\" class=\"courbe-axe\">{m.Mois.Year}</text>")
                }
            }
        </svg>
        <ul class="legende legende-courbe">
            <li><i class="l-presence"></i> @L.T("presence-vote-exprime-par-l-elu")</li>
            <li><i class="l-delegation"></i> @L.T("votes-par-delegation-la-barre-entiere")</li>
        </ul>
    </section>
}

<section class="historique" aria-labelledby="t-hist">
    <h2 id="t-hist">@L.T("ses-votes")</h2>
    <form class="filtres filtres-auto" method="get" action="@L.Lien(e.Lien)">
        <input class="filtre" type="search" name="q" value="@Model.Q" maxlength="100" placeholder="@L.T("chercher-dans-les-titres-des-scrutins")" aria-label="@L.T("rechercher-dans-les-titres")" />
        <select name="vote" aria-label="@L.T("filtrer-sur-son-vote")">
                <option value="">@L.T("tous-les-votes")</option>
                @foreach (var c in ParlementaireModel.ChoixVote)
                {
                    <option value="@c" selected="@(Model.Vote == c)">@(c switch {
                        "pour" => L.T("pour-2ecc"), "contre" => L.T("contre-b885"), "abstention" => "Abstention",
                        "absent" => L.T("absent"), "non_votant" => L.T("non-votant"),
                        "delegation" => L.T("par-delegation"), _ => L.T("mise-au-point-rectifie") })</option>
                }
        </select>
        <span class="periode"><label class="champ-date">@L.T("du") <input type="date" name="du" value="@Model.Du" aria-label="@L.T("du-date-de-debut")" /></label>
            <label class="champ-date">@L.T("au") <input type="date" name="au" value="@Model.Au" aria-label="@L.T("au-date-de-fin")" /></label></span>
        @if (!Chambres.SansVoteSurEnsemble(Model.Chambre))
        {
        <label class="case"><input type="checkbox" name="portee" value="tout" checked="@Model.ToutAfficher" /> @(Model.Chambre == Chambres.Commons ? L.T("inclure-les-amendements-motions-et-autres") : Chambres.EstUs(Model.Chambre) ? L.T("inclure-les-amendements-la-cloture-des") : L.T("inclure-les-amendements-et-articles"))</label>
        }
        <button type="submit" class="sans-js">@L.T("filtrer")</button>
        @if (Model.FiltreActif) { <a class="effacer" href="@L.Lien(e.Lien)" title="@L.T("effacer-le-filtre")" aria-label="@L.T("effacer-le-filtre")"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></svg></a> }
        @if (Model.Lignes == "tous" || int.TryParse(Model.Lignes, out _)) { <input type="hidden" name="lignes" value="@Model.Lignes" /> }
    </form>

    <p class="compte">@Model.Votes.Total.ToString("N0", fr) @(Model.Votes.Total > 1 ? L.T("plur-scrutin-pl") : L.T("plur-scrutin-sg"))@(Model.FiltreActif ? L.T("correspondant-aux-filtres") : "")</p>

    @if (Model.Votes.Lignes.Count == 0)
    {
        <p class="vide">@L.T("aucun-scrutin-a-afficher")</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="liste-textes">
                <thead><tr><th>@L.T("date")</th><th>@L.T("texte")</th><th>@L.T("resultat")</th><th>@L.T("son-vote")</th></tr></thead>
                <tbody>
                @foreach (var v in Model.Votes.Lignes)
                {
                    <tr>
                        <td class="nowrap" data-label="@L.T("date")"><time datetime="@v.DateScrutin.ToString("yyyy-MM-dd")">@v.DateScrutin.ToString("d MMM yyyy", fr)</time></td>
                        <td><a href="@L.Lien("/scrutin/" + v.ScrutinId)" title="@Titres.Info(v.TitreLangue(L.Anglais), v.InfobulleTitre(L))">@Titres.Court(v.TitreLangue(L.Anglais))</a></td>
                        <td data-label="@L.T("resultat")">@if (v.Sort is not null) { <span class="sort @(v.Sort.StartsWith("adopt") ? "adopte" : "rejete")">@(v.Sort.StartsWith("adopt") ? L.T("adopte") : L.T("rejete"))</span> }</td>
                        <td data-label="@L.T("son-vote")">
                            <span class="badge b-@v.Position">@L.Position(v.Position)</span>
                            @if (v.Rectifie)
                            {
                                <span class="tag tag-rectifie">@(v.OrigineInconnue ? L.T("mise-au-point-ca20") : L.T("rectifie-a-l-origine") + (v.PositionOrigine is null ? "absent" : L.Position(v.PositionOrigine).ToLowerInvariant()) + ")")</span>
@if (v.OrigineInconnue) { @Doute.Html(NiveauDoute.Manquant, L.T("origine-inconnue"), L.T("la-position-publiee-au-scrutin-avant")) }
                            }
                            @if (v.ParDelegation) { <span class="tag tag-delegation">@L.T("par-delegation-ad67")</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <p class="lignes-page" aria-label="@L.T("nombre-de-lignes-par-page")">
            @L.T("lignes-par-page")
            @foreach (var n in ParlementaireModel.ChoixLignes)
            {
                if (n == Model.ParPageEff) { <strong aria-current="true">@n</strong> }
                else { <a href="@Model.LienPage(1, n)">@n</a> }
            }
            @if (Model.ParPageEff == ParlementaireModel.Toutes) { <strong aria-current="true">@L.T("tous")</strong> }
            else { <a href="@Model.LienPage(1, ParlementaireModel.Toutes)">@L.T("tous")</a> }
        </p>

        @if (Model.Votes.NbPages > 1)
        {
            <nav class="pagination" aria-label="@L.T("pagination")">
                @if (Model.Votes.Page > 1) { <a href="@Model.LienPage(Model.Votes.Page - 1)" rel="prev">@L.T("precedent")</a> }
                <span>@L.T("page") @Model.Votes.Page / @Model.Votes.NbPages</span>
                @if (Model.Votes.Page < Model.Votes.NbPages) { <a href="@Model.LienPage(Model.Votes.Page + 1)" rel="next">@L.T("suivant")</a> }
            </nav>
        }
    }
</section>
