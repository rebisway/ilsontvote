    {
        <p>@L.TH("sources-greffe-de-la-chambre-officiel")</p>
    }
    else if (L.Pays == "IT")
    {
        <p>@L.TH("sources-dati-camera-it-open-data")</p>
    }
    else if (L.Pays == "CH")
    {
        <p>@L.TH("source-parlament-ch")</p>
    }
    else if (L.Pays == "CA")
    {
        <p>@L.TH("source-ourcommons-ca")</p>
        <p>@L.TH("source-sencanada-ca")</p>
    }
    else if (L.Pays == "IE")
    {
        <p>@L.TH("source-oireachtas-donnees-ouvertes-licence-c")</p>
