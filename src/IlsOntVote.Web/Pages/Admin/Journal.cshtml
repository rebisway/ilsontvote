@page
@model IlsOntVote.Web.Pages.Admin.JournalModel
@using IlsOntVote.Web.Pages.Admin
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = "Journal du site";
    ViewData["NoIndex"] = true;
}
<partial name="_AdminNav" />
<h1 class="titre-page">Journal du site</h1>
<p class="chapo">Appels d'outils MCP, avertissements et erreurs de l'application, gardés @EcritureJournalService.JoursConservation jours. Les journaux du serveur web, un arrêt au démarrage ou une panne de la base n'apparaissent pas ici. Sortie des imports : <a href="/Admin/ImportsJournal">journal des imports</a>.</p>

<form class="filtres filtres-auto filtres-liste" method="get">
    <input class="filtre" type="search" name="q" value="@Model.Recherche" maxlength="100" placeholder="Chercher dans les messages…" aria-label="Chercher dans les messages" />
    <select name="niveau" aria-label="Niveau">
        <option value="">Tous les niveaux</option>
        <option value="info" selected="@(Model.Niveau == "info")">Information (MCP)</option>
        <option value="avertissement" selected="@(Model.Niveau == "avertissement")">Avertissements</option>
        <option value="erreur" selected="@(Model.Niveau == "erreur")">Erreurs</option>
    </select>
    <select name="periode" aria-label="Période">
        <option value="">24 dernières heures</option>
        <option value="heure" selected="@(Model.Periode == "heure")">Dernière heure</option>
        <option value="semaine" selected="@(Model.Periode == "semaine")">7 derniers jours</option>
        <option value="tout" selected="@(Model.Periode == "tout")">Tout</option>
    </select>
    <button type="submit" class="sans-js">Filtrer</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@Model.LienSansFiltre" title="Effacer le filtre" aria-label="Effacer le filtre">✕</a> }
</form>

<div class="barre-liste">
    <p class="compte">@Model.Resultats.Total.ToString("N0", ImportAffichage.Fr) message@(Model.Resultats.Total > 1 ? "s" : "")</p>
    <p class="export">Exporter ce tableau :
        @foreach (var f in Exporteur.Formats) { <a href="@Model.Lien(format: f)" download>@f.ToUpperInvariant()</a> }
    </p>
</div>

@if (Model.Resultats.Lignes.Count == 0)
{
    <p class="vide">@(Model.FiltreActif ? "Aucun message ne correspond à ces critères." : "Aucun message sur les dernières 24 heures.")</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    @Model.Th("date", "Date", "nowrap")
                    @Model.Th("niveau", "Niveau")
                    @Model.Th("source", "Source")
                    <th scope="col">Message</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var l in Model.Resultats.Lignes)
            {
                var premiere = l.Message.Split('\n', 2)[0].Trim();
                var court = l.Source[(l.Source.LastIndexOf('.') + 1)..];
                <tr>
                    <td class="nowrap">@ImportAffichage.Date(l.Le)</td>
                    <td>@JournalModel.Libelle(l.Niveau)</td>
                    <td><span title="@l.Source">@court</span></td>
                    <td>
                        @* Message long ou pile d'appels : première ligne visible, le reste replié. *@
                        @if (premiere.Length == l.Message.Length && premiere.Length <= 200) { @premiere }
                        else
                        {
                            <details><summary>@(premiere.Length > 200 ? premiere[..200] + "…" : premiere)</summary><pre class="journal-detail">@l.Message</pre></details>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Resultats.NbPages > 1)
    {
        <nav class="pagination" aria-label="Pagination">
            @if (Model.Resultats.Page > 1) { <a href="@Model.Lien(page: Model.Resultats.Page - 1)" rel="prev">← Précédent</a> }
            <span>Page @Model.Resultats.Page / @Model.Resultats.NbPages</span>
            @if (Model.Resultats.Page < Model.Resultats.NbPages) { <a href="@Model.Lien(page: Model.Resultats.Page + 1)" rel="next">Suivant →</a> }
        </nav>
    }
    <partial name="_LignesParPage" model="Model" />
}
