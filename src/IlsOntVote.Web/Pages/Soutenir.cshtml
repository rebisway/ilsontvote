@page "/soutenir"
@{
    ViewData["Title"] = L.T("soutenir-le-projet", "Soutenir le projet", "Support the project");
    ViewData["Description"] = L.T("ils-ont-vote-est-gratuit-sans", "Ils ont voté est gratuit, sans publicité ni pistage. Les dons financent la maintenance, l'hébergement et le développement.", "Ils ont voté is free, with no ads and no tracking. Donations pay for maintenance, hosting and development.");
}

<h1 class="titre-page">@L.T("soutenir-le-projet", "Soutenir le projet", "Support the project")</h1>
<p class="chapo">@L.T("ils-ont-vote-est-gratuit-sans-e6a9", "Ils ont voté est gratuit, sans publicité ni pistage. Les dons financent la maintenance, l'hébergement des serveurs et la suite du développement (nouvelles sources, meilleure qualité des données, historique plus ancien).", "Ils ont voté is free, with no ads and no tracking. Donations pay for maintenance, server hosting and further development (new sources, better data quality, older history).")</p>

<section class="bloc-texte">
    <div class="dons">
        <a class="bouton-don" href="https://liberapay.com/Rebisway" rel="noopener">@L.T("don-regulier-liberapay", "Don régulier (Liberapay)", "Monthly donation (Liberapay)")</a>
        <a class="bouton-don" href="https://buy.stripe.com/28E28r5NraZv6dH3rvg3602" rel="noopener">@L.T("don-unique-stripe", "Don unique (Stripe)", "One-time donation (Stripe)")</a>
    </div>
    <p class="note-source">@L.T("ces-liens-quittent-ce-site-aucun", "Ces liens quittent ce site ; aucun script de paiement n'est chargé ici. Les dons réguliers passent par Liberapay (plateforme à but non lucratif), les dons uniques par Stripe. Aucune de ces plateformes ne nous donne accès à vos données bancaires.", "These links leave this site; no payment script is loaded here. Monthly donations go through Liberapay (a non-profit platform), one-time donations through Stripe. Neither platform gives us access to your banking details.")
    @L.TH("une-question-contact-rebisway-com", "Une question : <a href=\"mailto:contact@rebisway.com\">contact@rebisway.com</a>.", "A question: <a href=\"mailto:contact@rebisway.com\">contact@rebisway.com</a>.")</p>
</section>

<p>@L.TH("vous-pouvez-aussi-aider-sans-argent", "Vous pouvez aussi aider sans argent : signaler une erreur de données (avec le lien vers la source officielle) ou contribuer au <a href=\"https://github.com/rebisway/ilsontvote\">code libre</a>.", "You can also help without money: report a data error (with a link to the official source) or contribute to the <a href=\"https://github.com/rebisway/ilsontvote\">free software code</a>.")</p>
