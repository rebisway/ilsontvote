@page "/statistiques"
@model StatistiquesModel
@using IlsOntVote.Web.Models
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = L.T("statistiques");
    ViewData["Description"] = L.T("nombre-de-textes-votes-lois-promulguees");
    var fr = L.Culture;
    string Pct(double? v) => v is null ? "—" : v.Value.ToString("0.0", fr) + (L.T("suffixe-pourcent"));
}

<h1 class="titre-page">@L.T("statistiques")</h1>
<p class="chapo">@L.TH("combien-de-textes-votes-et-qui")</p>

<form class="filtres filtres-auto filtres-liste" method="get" action="@L.Lien("/statistiques")">
    @if (L.Pays is not null && Model.ChambresSite.Length > 1)
    {
    <select name="chambre" aria-label="@L.T("chambre")">
        @foreach (var ch in Model.ChambresSite)
        {
            <option value="@Chambres.Filtre(ch)" selected="@(Model.ChambreCode == ch)">@L.Chambre(ch)</option>
        }
    </select>
    }
    @if (L.Pays is null)
    {
    <select name="chambre" aria-label="@L.T("chambre-accd")">
        <option value="an" selected="@(Model.ChambreCle == "an")">@L.T("assemblee-nationale")</option>
        <option value="senat" selected="@(Model.ChambreCle == "senat")">@L.T("senat")</option>
        <option value="ue" selected="@(Model.ChambreCle == "ue")">@L.T("parlement-europeen")</option>
    </select>
    }
    <select name="periode" aria-label="@L.T("periode")">
        <option value="12m" selected="@(Model.PeriodeCle == "12m")">@L.T("12-derniers-mois")</option>
        <option value="annee" selected="@(Model.PeriodeCle == "annee")">@L.T("annee-en-cours")</option>
        <option value="tout" selected="@(Model.PeriodeCle == "tout")">@L.T("depuis-le-debut-des-donnees")</option>
        @if (Model.PeriodeCle == "perso") { <option value="12m" selected>@L.T("dates-choisies")</option> }
    </select>
    <span class="periode" title="@L.T("dates-precises-elles-remplacent-la-periode")">
        <label class="champ-date">@L.T("du") <input type="date" name="du" value="@Model.Du" aria-label="@L.T("du-date-de-debut")" /></label>
        <label class="champ-date">@L.T("au") <input type="date" name="au" value="@Model.Au" aria-label="@L.T("au-date-de-fin")" /></label>
    </span>
    <label class="case"><input type="checkbox" name="ensemble" value="1" checked="@Model.EnsembleSeul" /> @L.T("votes-sur-l-ensemble-d-un")</label>
    <button type="submit" class="sans-js">@L.T("afficher")</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@L.Lien("/statistiques")" title="@L.T("effacer-le-filtre")" aria-label="@L.T("effacer-le-filtre")"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></svg></a> }
</form>

<p class="periode-rappel">@L.Chambre(Model.ChambreCode) · <strong>@Model.PeriodeLibelle</strong>@(Model.EnsembleSeul ? L.T("votes-sur-l-ensemble-seulement") : "")</p>
@if (Model.ChambreCode == Chambres.Lords)
{
    <p class="note-source">@Doute.Html(NiveauDoute.Incertain, L.T("absences-surestimees"), L.T("seuls-les-pairs-ayant-vote-sont")) @L.T("les-taux-des-lords-sont-a") @L.T("ces-taux-comptent-les-votes-exprimes")</p>
}

<section class="cartes-stats" aria-label="@L.T("chiffres-cles")">
    <div class="carte-stat"><b>@Model.Chiffres.Scrutins.ToString("N0", fr)</b><span>@L.T("scrutins-publics")</span></div>
    @if (!Chambres.SansVoteSurEnsemble(Model.ChambreCode))
    {
    <div class="carte-stat"><b>@Model.Chiffres.VotesEnsemble.ToString("N0", fr)</b><span>@L.T("votes-sur-l-ensemble-d-un-7cf6")</span>
        <small>@Model.Chiffres.Adoptes.ToString("N0", fr) @L.T("adoptes") · @Model.Chiffres.Rejetes.ToString("N0", fr) @L.T("rejetes")</small></div>
    }
    @if (L.Pays is null && Model.ChambreCode != Chambres.UE)
    {
        <div class="carte-stat"><b>@Model.Chiffres.LoisPromulguees.ToString("N0", fr)</b><span>@L.T("lois-promulguees")</span><small>@L.T("sur-la-periode-lois-francaises-parlement")</small></div>
    }
    <div class="carte-stat"><b>@Pct(Model.Chiffres.ParticipationPct)</b><span>@L.T("participation-moyenne")</span>
        <small>@Doute.Html(NiveauDoute.Calcule, L.T("calcule-3201"), L.T("calcule-par-le-site-a-partir"))</small></div>
</section>

<h2>@L.T("participation-par-groupe")</h2>
@if (Model.Groupes.Count == 0)
{
    <p class="vide">@L.T("aucune-donnee-pour-ce-filtre")@(Model.Chiffres.Scrutins > 0 ? L.T("les-statistiques-de-participation-sont-en") : ".")</p>
}
else
{
    <div class="barre-liste">
        <p class="compte">@Model.Groupes.Count @(Model.Groupes.Count > 1 ? L.T("plur-groupe-pl") : L.T("plur-groupe-sg"))</p>
        <p class="export">@L.T("exporter-ce-tableau")
            @foreach (var f in Exporteur.Formats) { <a href="@Model.Lien(f)" download>@f.ToUpperInvariant()</a> }
        </p>
    </div>
    <div class="table-wrap">
        <table class="liste-textes">
            <thead>
                <tr><th scope="col">@L.T("groupe")</th><th scope="col" class="num">@L.T("effectif-moyen")</th><th scope="col">@L.T("participation-titre")</th>
                    <th scope="col" class="num">@L.T("pour-2ecc")</th><th scope="col" class="num">@L.T("contre-b885")</th><th scope="col" class="num">@L.T("abst-29c5")</th>
                    <th scope="col" class="num" title="@L.T("part-des-presents-du-groupe-qui")">@L.T("cohesion")</th></tr>
            </thead>
            <tbody>
            @foreach (var g in Model.Groupes)
            {
                <tr>
                    <td data-label="@L.T("groupe")" title="@g.Libelle"><span class="pastille" style="background:@(g.Couleur ?? "#8d949a")"></span> <strong>@g.Sigle</strong></td>
                    <td data-label="@L.T("effectif-moyen")" class="num">@g.EffectifMoyen.ToString("0.#", fr)</td>
                    <td data-label="@L.T("participation-titre")">
                        <span class="jauge" role="img" aria-label="Participation @Pct(g.ParticipationPct)"><span style="width:@((g.ParticipationPct ?? 0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                        <span class="jauge-val">@Pct(g.ParticipationPct)</span>
                    </td>
                    <td data-label="@L.T("pour-2ecc")" class="num c-pour">@Pct(g.PourPct)</td>
                    <td data-label="@L.T("contre-b885")" class="num c-contre">@Pct(g.ContrePct)</td>
                    <td data-label="@L.T("abstention")" class="num c-abstention">@Pct(g.AbstentionPct)</td>
                    <td data-label="@L.T("cohesion")" class="num">@Pct(g.CohesionPct)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="note-source">@L.TH("pour-contre-et-abstention-part-des")</p>
}

<h2>@L.T("presence-des-elus")</h2>
<p class="note-source">@L.T("participation-presence-delegations-et-mises")</p>
<p><a class="bouton-lien" href="@Model.LienElus()">@L.T("voir-tous-les-elus-et-leurs")</a></p>

@* Pétitions : France et Royaume-Uni seulement (les autres pays n'en ont pas : leurs pages répondent 404). *@
@if (L.Pays is null || PaysSite.APetitionsEtProjets(L.Pays))
{
<h2>@L.T("petitions")</h2>
<p class="note-source">@L.T("petitions-du-senat-et-de-l")</p>
<p><a class="bouton-lien" href="@L.Lien("/petitions")">@L.T("toutes-les-petitions")</a> <a class="bouton-lien" href="@L.Lien("/petitions/anomalies")">@L.T("anomalies-des-petitions")</a></p>
}

<h2>@L.T("activite-par-annee")</h2>
@if (Model.Annees.Count == 0)
{
    <p class="vide">@L.T("aucun-scrutin-pour-cette-chambre")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead>
                <tr><th scope="col">@L.T("annee")</th><th scope="col" class="num">@L.T("scrutins-publics-0ef4")</th><th scope="col" class="num">@L.T("votes-sur-l-ensemble")</th>
                    <th scope="col" class="num">@L.T("adoptes-4f8e")</th><th scope="col" class="num">@L.T("rejetes-09fa")</th><th scope="col" class="num">@L.T("participation-titre")</th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model.Annees)
            {
                <tr>
                    <td data-label="@L.T("annee")"><strong>@a.Annee</strong></td>
                    <td data-label="@L.T("scrutins-publics-0ef4")" class="num">@a.Scrutins.ToString("N0", fr)</td>
                    <td data-label="@L.T("votes-sur-l-ensemble")" class="num">@a.VotesEnsemble.ToString("N0", fr)</td>
                    <td data-label="@L.T("adoptes-4f8e")" class="num">@a.Adoptes.ToString("N0", fr)</td>
                    <td data-label="@L.T("rejetes-09fa")" class="num">@a.Rejetes.ToString("N0", fr)</td>
                    <td data-label="@L.T("participation-titre")" class="num">@Pct(a.ParticipationPct)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
