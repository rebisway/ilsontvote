@page "/donnees"
@inject IlsOntVote.Web.Services.DonneesOuvertes Donnees
@{
    ViewData["Title"] = L.T("Données ouvertes", "Open data");
    ViewData["Description"] = L.T("Téléchargez toutes les données du site : scrutins, vote de chaque élu, élus, textes de loi (CSV compressés, mis à jour chaque nuit).", "Download all the site's data: votes, each official's vote, officials, laws (compressed CSV, updated every night).");
    var fr = L.Culture;
    var fichiers = Donnees.Lire();
    string Taille(long o) => o >= 1_048_576 ? (o / 1_048_576.0).ToString("0.#", fr) + " Mo" : Math.Max(1, o / 1024).ToString("N0", fr) + " Ko";
}

<h1 class="titre-page">@L.T("Données ouvertes", "Open data")</h1>
<p class="chapo">@L.TH("Toutes les données affichées sur le site, en fichiers <strong>CSV compressés (gzip)</strong>, régénérés chaque nuit. Séparateur virgule, encodage UTF-8, une ligne d'en-tête ; les dates sont au format AAAA-MM-JJ et les booléens valent <code>t</code> ou <code>f</code>.", "All the data shown on the site, as <strong>compressed CSV files (gzip)</strong>, regenerated every night. Comma-separated, UTF-8, one header row; dates are YYYY-MM-DD and booleans are <code>t</code> or <code>f</code>.")</p>

@if (fichiers.Count == 0)
{
    <p class="vide">@L.T("Les fichiers ne sont pas encore générés.", "The files have not been generated yet.")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>@L.T("Fichier", "File")</th><th>@L.T("Contenu", "Content")</th><th class="num">@L.T("Lignes", "Rows")</th><th class="num">@L.T("Taille", "Size")</th><th>@L.T("Mis à jour", "Updated")</th></tr></thead>
            <tbody>
            @foreach (var f in fichiers)
            {
                <tr>
                    <td data-label="@L.T("Fichier", "File")"><a href="@L.Lien("/donnees/fichier/" + f.Fichier)" download>@f.Fichier</a><br /><span class="note-source" title="SHA-256">@(f.Sha256[..Math.Min(16, f.Sha256.Length)])…</span></td>
                    <td data-label="@L.T("Contenu", "Content")">@f.Description</td>
                    <td class="num" data-label="@L.T("Lignes", "Rows")">@f.Lignes.ToString("N0", fr)</td>
                    <td class="num" data-label="@L.T("Taille", "Size")">@Taille(f.Octets)</td>
                    <td class="nowrap" data-label="@L.T("Mis à jour", "Updated")">@f.GenereLe.ToString("d MMM yyyy", fr)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<section class="definitions" aria-label="@L.T("Lire les fichiers", "Reading the files")">
    <h2>@L.T("Comment lire les fichiers", "How to read the files")</h2>
    <dl>
        <div><dt>votes</dt><dd>@L.TH("une ligne par élu et par scrutin public où il a une position : <code>position</code> = pour, contre, abstention ou non_votant. <code>par_delegation</code> : un collègue a voté pour lui. <code>rectifie</code> : position corrigée après le scrutin (<code>position_origine</code> = position publiée au scrutin, vide si absent à l'origine ; <code>origine_inconnue</code> au Sénat).", "one row per official and public vote where they have a position: <code>position</code> = pour, contre, abstention or non_votant. <code>par_delegation</code>: a colleague voted for them. <code>rectifie</code>: position corrected after the vote (<code>position_origine</code> = position published at the vote, empty if absent originally; <code>origine_inconnue</code> in the Senate).")</dd></div>
        <div><dt>@L.T("absents", "absentees")</dt><dd>@L.TH("<strong>Les absents ne sont pas dans <code>votes</code></strong> : ils se déduisent. Un élu est absent à un scrutin s'il avait un mandat en cours à sa date (fichier <code>mandats</code> ; pour l'Assemblée et le Parlement européen, la législature du scrutin doit être celle du mandat) et n'a pas de ligne dans <code>votes</code>. Les scrutins où <code>nominatif_incomplet</code> vaut <code>t</code> ont un décompte nominatif plus court que le total officiel : n'en déduisez pas d'absents.", "<strong>Absentees are not in <code>votes</code></strong>: they are deduced. An official is absent from a vote if they held a mandate on its date (file <code>mandats</code>; for the Assembly and the European Parliament the vote's legislature must match the mandate's) and have no row in <code>votes</code>. Votes where <code>nominatif_incomplet</code> is <code>t</code> have a shorter individual count than the official total: do not deduce absentees from them.")</dd></div>
        <div><dt>scrutins</dt><dd>@L.TH("<code>sur_ensemble</code> : vote sur l'ensemble d'un texte (sinon amendement, article…). <code>texte_id</code> : texte de loi dont c'est le vote sur l'ensemble ; <code>texte_lie_id</code> : texte cité par un amendement ou un article. <strong>Ces rattachements sont calculés par le site</strong> d'après les titres et les dates : ils peuvent manquer ou se tromper. <code>titre_fr_auto</code> / <code>titre_en_auto</code> : le titre est une traduction automatique.", "<code>sur_ensemble</code>: vote on the whole text (otherwise amendment, article…). <code>texte_id</code>: law whose vote on the whole text this is; <code>texte_lie_id</code>: law cited by an amendment or an article. <strong>These links are computed by the site</strong> from titles and dates: they may be missing or wrong. <code>titre_fr_auto</code> / <code>titre_en_auto</code>: the title is a machine translation.")</dd></div>
        <div><dt>texte_etapes</dt><dd>@L.TH("décisions de séance publique sur un texte, à l'Assemblée et au Sénat, <strong>avec ou sans scrutin public</strong> (<code>sans_scrutin_public</code> = vote à main levée : le détail nominatif n'existe pas). <code>article_49_3</code> : adopté sans vote par l'article 49, alinéa 3.", "public-session decisions on a text, in the Assembly and the Senate, <strong>with or without a roll-call vote</strong> (<code>sans_scrutin_public</code> = show of hands: no individual detail exists). <code>article_49_3</code>: adopted without a vote under article 49, paragraph 3.")</dd></div>
        <div><dt>petitions</dt><dd>@L.TH("pétitions déposées sur petitions.senat.fr, telles que publiées (statut et nombre de soutiens de citoyens ; ce ne sont pas des votes d'élus). <code>petitions_historique</code> : un relevé (date, soutiens, statut) par import, jamais effacé. <code>petitions_anomalies</code> : constats entre deux relevés (<code>baisse</code>, <code>disparition</code>, <code>reapparition</code>), sans cause connue.", "petitions filed on petitions.senat.fr, as published (status and number of citizen supporters; they are not officials' votes). <code>petitions_historique</code>: one snapshot (date, supporters, status) per import, never deleted. <code>petitions_anomalies</code>: findings between two snapshots (<code>baisse</code> = drop, <code>disparition</code> = missing, <code>reapparition</code> = back), no known cause.")</dd></div>
        <div><dt>chambre</dt><dd>AN (@L.T("Assemblée nationale", "National Assembly")), SENAT (@L.T("Sénat", "Senate")), UE (@L.T("Parlement européen", "European Parliament")).</dd></div>
    </dl>
    <p class="note-source">@L.TH("Un fichier se lit avec n'importe quel tableur après décompression, ou directement par exemple avec Python : <code>pandas.read_csv(\"votes.csv.gz\")</code>. Les empreintes SHA-256 permettent de vérifier un téléchargement.", "A file can be opened in any spreadsheet after decompression, or directly for example with Python: <code>pandas.read_csv(\"votes.csv.gz\")</code>. The SHA-256 fingerprints let you check a download.")</p>
</section>

<section class="definitions" aria-label="@L.T("Sources et licences", "Sources and licences")">
    <h2>@L.T("Sources et conditions de réutilisation", "Sources and terms of reuse")</h2>
    <p>@L.TH("Les données viennent des sources officielles : <strong>Assemblée nationale</strong> (data.assemblee-nationale.fr), <strong>Sénat</strong> (data.senat.fr), et, pour le <strong>Parlement européen</strong>, du projet indépendant HowTheyVote.eu, sous Open Database License (attribution et partage à l'identique). La réutilisation de chaque ligne est soumise aux conditions publiées par sa source : citez la source d'origine. Les rattachements, taux et traductions calculés par le site sont fournis sans garantie ; voir la page <a href=\"/methodologie\">Méthodologie et limites</a>. Aucune photo n'est incluse.", "The data comes from official sources: the <strong>National Assembly</strong> (data.assemblee-nationale.fr), the <strong>Senate</strong> (data.senat.fr), and, for the <strong>European Parliament</strong>, from the independent HowTheyVote.eu project, under the Open Database License (attribution and share-alike). Reuse of each row is subject to the terms published by its source: cite the original source. Links, rates and translations computed by the site are provided without warranty; see the <a href=\"/methodologie\">Methodology and limits</a> page. No photo is included.")</p>
</section>
