@page "/textes"
@model TextesModel
@using IlsOntVote.Web.Models
@using IlsOntVote.Web.Services
@{
    ViewData["Title"] = Model.Resolutions ? L.T("Résolutions", "Resolutions") : Model.SitePays ? "Divisions" : L.T("Scrutins", "Votes");
    ViewData["Description"] = L.T("Tous les scrutins publics de l'Assemblée nationale et du Sénat : cherchez un texte, triez, exportez, et voyez qui a voté quoi.", "All roll-call votes of the French National Assembly and Senate: search a text, sort, export, and see who voted what.");
    var fr = L.Culture;
}

@if (Model.Resolutions)
{
    <h1 class="titre-page">@L.T("Résolutions", "Resolutions")</h1>
    <p class="chapo">@L.TH("Votes sur des propositions de <strong>résolution</strong> : une assemblée y exprime une position (article 34-1 de la Constitution), donne son avis sur un projet de texte européen, ou décide de sa propre organisation (commission d'enquête, règlement). Une résolution <strong>n'a pas force de loi</strong> : elle n'est pas promulguée et ne lie pas le Gouvernement. Pour les lois, voir <a href=\"/lois\">les lois</a>.", "Votes on proposals for a <strong>resolution</strong>: an assembly states a position (article 34-1 of the Constitution), gives its opinion on a draft European text, or decides on its own organisation (inquiry committee, rules of procedure). A resolution <strong>has no force of law</strong>: it is not promulgated and does not bind the Government. For laws, see <a href=\"/lois\">the laws</a>.")</p>
}
else
{
    <h1 class="titre-page">@(Model.SitePays ? "Divisions" : L.T("Scrutins", "Votes"))</h1>
@* chapô des scrutins : voir plus bas *@
@if (Model.SitePays)
{
    <p class="chapo">Every recorded vote (division) of the House of Commons since July 2024, most recent first. Click a column title to sort; export the table in CSV or JSON. Members who did not vote are shown as absent only when the published lists are complete.</p>
}
else
{
<p class="chapo">@L.TH("Les votes sur l'ensemble d'un texte, du plus récent au plus ancien. Cochez « amendements et articles » pour voir aussi les votes intermédiaires. Cliquez sur un titre de colonne pour trier. Pour suivre le parcours complet d'une loi (promulgation, Journal officiel, Conseil constitutionnel), voir <a href=\"/lois\">les lois</a>.", "Votes on the whole text, most recent first. Tick “amendments and articles” to also see intermediate votes. Click a column title to sort. To follow a law's full journey (promulgation, Official Journal, Constitutional Council), see <a href=\"/en/lois\">the laws</a>.")</p>
}
}

<form class="filtres filtres-auto filtres-liste" method="get" action="@L.Lien("/textes")">
    <input class="filtre" type="search" name="q" value="@Model.Recherche" placeholder="@L.T("Chercher un texte (ex. retraites, finances, immigration…)", "Search a text (e.g. pensions, finance, immigration…)")" aria-label="@L.T("Chercher un texte", "Search a text")" />
    @if (!string.IsNullOrEmpty(Model.TexteId)) { <input type="hidden" name="texte" value="@Model.TexteId" /> }
    @if (Model.Resolutions) { <input type="hidden" name="nature" value="resolution" /> }
    @if (!Model.SitePays)
    {
    <select name="chambre" aria-label="@L.T("Chambre", "Chamber")">
        <option value="" selected="@string.IsNullOrEmpty(Model.Chambre)">@L.T("Assemblée et Sénat", "National Assembly and Senate")</option>
        <option value="an" selected="@(Model.Chambre == "an")">@L.T("Assemblée nationale", "National Assembly")</option>
        <option value="senat" selected="@(Model.Chambre == "senat")">@L.T("Sénat", "Senate")</option>
        <option value="ue" selected="@(Model.Chambre == "ue")">@L.T("Parlement européen", "European Parliament")</option>
    </select>
    }
    <span class="periode"><label class="champ-date">@L.T("Du", "From") <input type="date" name="du" value="@Model.Du" aria-label="@L.T("Du (date de début)", "From (start date)")" /></label>
        <label class="champ-date">@L.T("au", "to") <input type="date" name="au" value="@Model.Au" aria-label="@L.T("Au (date de fin)", "To (end date)")" /></label></span>
    @if (!Model.SitePays)
    {
        <label class="case"><input type="checkbox" name="portee" value="tout" checked="@Model.ToutAfficher" /> @L.T("amendements et articles", "amendments and articles")</label>
    }
    @* Tri : en-têtes de colonne (écran large) ou ces listes (téléphone). *@
    <select name="tri" class="tri-mobile" aria-label="@L.T("Trier par", "Sort by")">
        <option value="date" selected="@(Model.TriEffectif == "date")">@L.T("Trier : date", "Sort: date")</option>
        <option value="chambre" selected="@(Model.TriEffectif == "chambre")">@L.T("Trier : chambre", "Sort: chamber")</option>
        <option value="titre" selected="@(Model.TriEffectif == "titre")">@L.T("Trier : texte", "Sort: text")</option>
        <option value="resultat" selected="@(Model.TriEffectif == "resultat")">@L.T("Trier : résultat", "Sort: result")</option>
        <option value="pour" selected="@(Model.TriEffectif == "pour")">@L.T("Trier : pour", "Sort: for")</option>
        <option value="contre" selected="@(Model.TriEffectif == "contre")">@L.T("Trier : contre", "Sort: against")</option>
        <option value="abst" selected="@(Model.TriEffectif == "abst")">@L.T("Trier : abstentions", "Sort: abstentions")</option>
    </select>
    <select name="sens" class="tri-mobile" aria-label="@L.T("Sens du tri", "Sort order")">
        <option value="desc" selected="@Model.Decroissant">@L.T("Décroissant", "Descending")</option>
        <option value="asc" selected="@(!Model.Decroissant)">@L.T("Croissant", "Ascending")</option>
    </select>
    <button type="submit" class="sans-js">@L.T("Filtrer", "Filter")</button>
    @if (Model.FiltreActif) { <a class="effacer" href="@Model.LienSansFiltre" title="@L.T("Effacer le filtre", "Clear filter")" aria-label="@L.T("Effacer le filtre", "Clear filter")"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></svg></a> }
</form>

<div class="barre-liste">
    <p class="compte">@Model.Resultats.Total.ToString("N0", fr) @L.T(Model.Resultats.Total > 1 ? " scrutins" : " scrutin", Model.Resultats.Total > 1 ? " votes" : " vote")</p>
    <p class="export">@L.T("Exporter ce tableau :", "Export this table:")
        @foreach (var f in Exporteur.Formats)
        {
            <a href="@Model.Lien(format: f)" download>@f.ToUpperInvariant()</a>
        }
    </p>
</div>

@if (Model.Resultats.Lignes.Count == 0)
{
    <p class="vide">@L.T("Aucun résultat.", "No results.")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead>
                <tr>
                    @Model.Th("date", L.T("Date", "Date"))
                    @Model.Th("chambre", L.T("Chambre", "Chamber"))
                    @Model.Th("titre", L.T("Texte", "Text"))
                    @Model.Th("resultat", L.T("Résultat", "Result"))
                    @Model.Th("pour", L.T("Pour", "For"), "num")
                    @Model.Th("contre", L.T("Contre", "Against"), "num")
                    @Model.Th("abst", L.T("Abst.", "Abst."), "num")
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Resultats.Lignes)
            {
                <tr>
                    <td class="nowrap" data-label="@L.T("Date", "Date")"><time datetime="@s.DateScrutin.ToString("yyyy-MM-dd")">@s.DateScrutin.ToString("d MMM yyyy", fr)</time></td>
                    <td data-label="@L.T("Chambre", "Chamber")"><span class="chambre-tag @Chambres.ClasseTag(s.Chambre)">@Chambres.Court(s.Chambre, L.Anglais)</span></td>
                    <td><a href="@L.Lien("/scrutin/" + s.Id)" title="@s.InfobulleTitre(L.Anglais)">@s.TitreLangue(L.Anglais)</a></td>
                    <td data-label="@L.T("Résultat", "Result")"><span class="sort @(s.Adopte ? "adopte" : "rejete")">@(s.Adopte ? L.T("✓ Adopté", "✓ Adopted") : L.T("✗ Rejeté", "✗ Rejected"))</span></td>
                    <td class="num" data-label="@L.T("Pour", "For")">@s.NbPour</td><td class="num" data-label="@L.T("Contre", "Against")">@s.NbContre</td><td class="num" data-label="@L.T("Abstentions", "Abstentions")">@s.NbAbstentions</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Resultats.NbPages > 1)
    {
        <nav class="pagination" aria-label="@L.T("Pagination", "Pagination")">
            @if (Model.Resultats.Page > 1) { <a href="@Model.Lien(page: Model.Resultats.Page - 1)" rel="prev">@L.T("← Précédent", "← Previous")</a> }
            <span>@L.T("Page", "Page") @Model.Resultats.Page / @Model.Resultats.NbPages</span>
            @if (Model.Resultats.Page < Model.Resultats.NbPages) { <a href="@Model.Lien(page: Model.Resultats.Page + 1)" rel="next">@L.T("Suivant →", "Next →")</a> }
        </nav>
    }
    <partial name="_LignesParPage" model="Model" />
}
