@page "/texte/{id}"
@model TexteModel
@using IlsOntVote.Web.Models
@using IlsOntVote.Web.Services
@{
    var t = Model.Loi;
    var st = t.Statut.Traduit(L);
    var fr = L.Culture;
    var titre = t.TitreLangue(L.Anglais);
    ViewData["Title"] = titre.Length > 60 ? titre[..60] + "…" : titre;
    ViewData["Fil"] = new List<(string, string)> { (L.T("accueil"), L.Lien("/")), (L.T("lois-b08d"), L.Lien("/lois")), (Titres.Court(titre, 110), L.Lien("/texte/" + t.Id)) };
    // Phrase visible (texte indexable) : statut + dates publiées ; une date absente n'est pas écrite.
    var phrase = L.Tf("texte-phrase", st.Libelle)
        + (t.DatePromulgation is { } dp ? " " + L.Tf("texte-phrase-promulgue", dp.ToString("d MMMM yyyy", L.Culture)) : "")
        + (t.DateJo is { } dj ? " " + L.Tf("texte-phrase-jo", dj.ToString("d MMMM yyyy", L.Culture)) : "");
    ViewData["JsonLd"] = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Legislation",
        ["name"] = t.TitreAffiche,   // données structurées : toujours le titre officiel (français)
        ["inLanguage"] = "fr",
        ["legislationJurisdiction"] = "FR",
        ["legislationType"] = t.TypeLibelle,
        ["legislationIdentifier"] = string.IsNullOrEmpty(t.NumeroLoi) ? null : t.NumeroLoi,
        ["legislationDate"] = t.DatePromulgation?.ToString("yyyy-MM-dd"),
        ["datePublished"] = t.DateJo?.ToString("yyyy-MM-dd"),
    }.Where(kv => kv.Value is not null).ToDictionary(kv => kv.Key, kv => kv.Value!);
    ViewData["Description"] = L.Tf("loi-description", L.Anglais ? titre : t.TitreAffiche, st.Libelle);
}

<div class="retour retour-nav">
    <a href="@L.Lien("/lois")">@L.T("toutes-les-lois")</a>
    <partial name="_Voisins" model="Model.Voisins" />
</div>

<header class="scrutin-tete">
    <p class="meta">@(t.TypeLibelle is null ? L.T("texte") : char.ToUpperInvariant(LibellesEn.TypeTexte(t.TypeLibelle, L)[0]) + LibellesEn.TypeTexte(t.TypeLibelle, L)[1..])@(string.IsNullOrEmpty(t.NumeroLoi) ? "" : L.Tf("loi-numero", t.NumeroLoi))</p>
    <h1>@Titres.Court(titre, 400)</h1>
    @if (titre.Length > 400) { <details class="titre-complet"><summary>@L.T("titre-complet")</summary><p>@titre</p></details> }
    <p><span class="statut @st.Classe">@st.Libelle</span></p>
    <p class="resume-vote">@phrase</p>
</header>
@if (t.TitreTraduitAuto(L.Anglais))
{
    <p class="note-source">@Doute.Html(NiveauDoute.Calcule, L.T("trad-auto-court"), L.T("trad-auto-info-fr")) @L.T("trad-titre-officiel") <span lang="fr">@t.TitreAffiche</span></p>
}

<section class="fiche-vote" aria-label="@L.T("parcours-du-texte")">
    <dl>
        <div><dt>@L.T("promulgation")</dt><dd>@(t.DatePromulgation?.ToString("d MMMM yyyy", fr) ?? L.T("pas-de-promulgation"))</dd></div>
        <div>
            <dt>@L.T("parution-au-journal-officiel")</dt>
            <dd>@(t.DateJo?.ToString("d MMMM yyyy", fr) ?? "—")</dd>
            @if (!string.IsNullOrEmpty(t.NumeroJo)) { <dd class="detail">@L.T("jo-n") @t.NumeroJo</dd> }
        </div>
        <div><dt>@L.T("votes-sur-l-ensemble")</dt><dd>@t.NbScrutins</dd><dd class="detail">@(t.AdopteAn ? L.T("adopte-a-l-assemblee") : "")@(t.AdopteAn && t.AdopteSenat ? " · " : "")@(t.AdopteSenat ? L.T("adopte-au-senat") : "")</dd></div>
    </dl>
    @* <div> et non <p> : <details> (bouton IA) ferme un paragraphe en HTML. *@
    <div class="liens-externes">
        @if (!string.IsNullOrEmpty(t.UrlLegifrance)) { <a class="raccourci" href="@t.UrlLegifrance" rel="noopener" target="_blank">@L.T("texte-sur-legifrance") ↗</a> }
        @if (!string.IsNullOrEmpty(t.UrlDossierSenat)) { <a class="raccourci" href="@t.UrlDossierSenat" rel="noopener" target="_blank">@L.T("dossier-legislatif-du-senat") ↗</a> }
        @if (!string.IsNullOrEmpty(t.UrlDossierAn)) { <a class="raccourci" href="@t.UrlDossierAn" rel="noopener" target="_blank">@L.T("dossier-de-l-assemblee") ↗</a> }
        @{ var promptIA = PromptResume.Construire(L, titre, new[] { t.UrlLegifrance ?? "", t.UrlDossierAn ?? "", t.UrlDossierSenat ?? "" }); }
        <partial name="_ResumeIA" model="promptIA" />
    </div>
</section>

@if (t.DecisionCcCode is not null || t.SaisineCcDate is not null)
{
    var cc = t.DecisionCcCode switch { "01" => "cc-conforme", "02" => "cc-partiel", "03" => "cc-censure", _ => "" };
    <section class="bloc-cc" aria-labelledby="t-cc">
        <h2 id="t-cc">@L.T("conseil-constitutionnel-095a")</h2>
        <dl class="liste-def">
            @if (t.SaisineCcDate is not null)
            {
                <div><dt>@L.T("saisine")</dt><dd>@t.SaisineCcDate.Value.ToString("d MMMM yyyy", fr)@(string.IsNullOrEmpty(t.SaisineCcPar) ? "" : L.Tf("saisine-par", t.SaisineCcPar))</dd></div>
            }
            @if (t.DecisionCcCode is not null)
            {
                <div>
                    <dt>@L.T("decision-0c11")</dt>
                    <dd>
                        <span class="statut @cc">@(char.ToUpperInvariant(LibellesEn.DecisionCc(t.DecisionCcLibelle, L)[0]) + LibellesEn.DecisionCc(t.DecisionCcLibelle, L)[1..])</span>
                        @if (!string.IsNullOrEmpty(t.DecisionCcNumero)) { <span class="note"> @L.T("decision-n") @t.DecisionCcNumero</span> }
                        @if (t.DecisionCcDate is not null) { <span class="note"> @L.T("du-0f68") @t.DecisionCcDate.Value.ToString("d MMMM yyyy", fr)</span> }
                        @if (!string.IsNullOrEmpty(t.DecisionCcUrl)) { <a href="@t.DecisionCcUrl" rel="noopener" target="_blank" class="note">@L.T("texte-de-la-decision") ↗</a> }
                    </dd>
                </div>
            }
        </dl>
    </section>
}

@if (Model.Etapes.Count > 0)
{
    <h2>@L.T("etapes-a-l-assemblee-nationale")</h2>
    <p class="note-source">@L.TH("chaque-lecture-en-seance-publique-quand")</p>
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th scope="col">@L.T("date")</th><th scope="col">@L.T("lecture")</th><th scope="col">@L.T("decision-0c11")</th><th scope="col">@L.T("vote-des-elus")</th></tr></thead>
            <tbody>
            @foreach (var e in Model.Etapes)
            {
                <tr>
                    <td data-label="@L.T("date")" class="col-date">@e.DateActe.ToString("d MMM yyyy", fr)</td>
                    <td data-label="@L.T("lecture")"><span class="chambre-tag @Chambres.ClasseTag(e.Chambre)">@L.ChambreCourt(e.Chambre)</span> @e.LectureEn(L)</td>
                    <td data-label="@L.T("decision-0c11")">@(e.EstMotion ? L.T("votee-par-scrutin-public") : string.IsNullOrWhiteSpace(e.Resultat) ? "—" : char.ToUpper(LibellesEn.ResultatLecture(e.Resultat, L)[0]) + LibellesEn.ResultatLecture(e.Resultat, L)[1..])</td>
                    <td data-label="@L.T("vote-des-elus")">
                        @if (e.ScrutinId is not null)
                        {
                            <a href="@L.Lien("/scrutin/" + e.ScrutinId)">@L.T("voir-qui-a-vote-quoi")</a>
                        }
                        else if (e.EstMotion)
                        {
                            @* La source ne cite pas toujours le scrutin d'une motion de censure : on renvoie vers les scrutins « motion de censure » de ce jour-là. *@
                            var jour = e.DateActe.ToString("yyyy-MM-dd");
                            <a href="@L.Lien("/textes")?q=motion+de+censure&du=@jour&au=@jour&portee=tout">@L.T("voir-les-scrutins-de-ce-jour")</a>
                        }
                        else if (e.Article493)
                        {
                            <span class="tag tag-493" tabindex="0" title="@L.T("le-gouvernement-a-engage-sa-responsabilite")">@L.T("sans-vote-art-49-3")</span>
                        }
                        else if (e.SansScrutinPublic)
                        {
                            @Doute.Html(NiveauDoute.Manquant, L.T("detail-non-disponible"), L.T("decision-prise-sans-scrutin-public-a"))
                        }
                        else
                        {
                            @Doute.Html(NiveauDoute.Incertain, L.T("scrutin-non-retrouve"), L.T("un-scrutin-public-est-cite-par"))
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h2>@L.T("les-votes-sur-ce-texte")</h2>
@if (Model.Scrutins.Count == 0)
{
    <p class="vide">@L.T("aucun-vote-nominatif-enregistre-pour-ce")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>@L.T("date")</th><th>@L.T("chambre-accd")</th><th>@L.T("scrutin")</th><th>@L.T("resultat")</th><th class="num">@L.T("pour-2ecc")</th><th class="num">@L.T("contre-b885")</th><th class="num">@L.T("abst-29c5")</th></tr></thead>
            <tbody>
            @foreach (var s in Model.Scrutins)
            {
                <tr>
                    <td class="nowrap" data-label="@L.T("date")">@s.DateScrutin.ToString("d MMM yyyy", fr)</td>
                    <td data-label="@L.T("chambre-accd")"><span class="chambre-tag @Chambres.ClasseTag(s.Chambre)">@L.ChambreCourt(s.Chambre)</span></td>
                    <td><a href="@L.Lien("/scrutin/" + s.Id)" title="@Titres.Info(s.TitreLangue(L.Anglais), s.InfobulleTitre(L))">@Titres.Court(s.TitreLangue(L.Anglais))</a></td>
                    <td data-label="@L.T("resultat")"><span class="sort @(s.Adopte ? "adopte" : "rejete")">@(s.Adopte ? L.T("adopte") : L.T("rejete"))</span></td>
                    <td class="num" data-label="@L.T("pour-2ecc")">@s.NbPour</td><td class="num" data-label="@L.T("contre-b885")">@s.NbContre</td><td class="num" data-label="@L.T("abstentions")">@s.NbAbstentions</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (Model.NbLies > 0)
{
    <h2>@L.T("amendements-articles-et-autres-votes")</h2>
    <p class="note-source">@L.Tf("loi-autres-scrutins-citent", Model.NbLies)</p>
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>@L.T("date")</th><th>@L.T("chambre-accd")</th><th>@L.T("scrutin")</th><th>@L.T("resultat")</th></tr></thead>
            <tbody>
            @foreach (var s in Model.Lies)
            {
                <tr>
                    <td class="nowrap" data-label="@L.T("date")">@s.DateScrutin.ToString("d MMM yyyy", fr)</td>
                    <td data-label="@L.T("chambre-accd")"><span class="chambre-tag @Chambres.ClasseTag(s.Chambre)">@L.ChambreCourt(s.Chambre)</span></td>
                    <td><a href="@L.Lien("/scrutin/" + s.Id)" title="@Titres.Info(s.TitreLangue(L.Anglais), s.InfobulleTitre(L))">@Titres.Court(s.TitreLangue(L.Anglais))</a></td>
                    <td data-label="@L.T("resultat")"><span class="sort @(s.Adopte ? "adopte" : "rejete")">@(s.Adopte ? L.T("adopte") : L.T("rejete"))</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.NbLies > Model.Lies.Count)
    {
        <p><a class="bouton-lien" href="@L.Lien("/textes")?texte=@Model.Loi.Id&portee=tout">@L.T("voir-les")@Model.NbLies.ToString("N0", fr)@L.T("votes")</a></p>
    }
}
