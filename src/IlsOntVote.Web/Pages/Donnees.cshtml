@page "/donnees"
@inject IlsOntVote.Web.Services.DonneesOuvertes Donnees
@{
    ViewData["Title"] = L.T("donnees-ouvertes");
    ViewData["Description"] = L.T("telechargez-toutes-les-donnees-du-site");
    var fr = L.Culture;
    // Chaque site ne propose que les fichiers de SON pays (manifeste : « FR » = France et Union européenne, « GB » = fichiers gb_…).
    var paysSite = L.Pays ?? "FR";
    var fichiers = Donnees.Lire().Where(f => f.Pays == paysSite).ToList();
    var royaumeUni = L.Pays == "GB";
    // Nom de fichier cité dans « Comment lire les fichiers » : lien de téléchargement quand le fichier existe au manifeste (sinon simple texte, p. ex. « chambre »).
    Microsoft.AspNetCore.Html.IHtmlContent Fichier(string nom)
    {
        var f = fichiers.FirstOrDefault(x => x.Fichier == nom + ".csv.gz");
        return f is null ? new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(nom))
            : new Microsoft.AspNetCore.Html.HtmlString("<a href=\"" + System.Net.WebUtility.HtmlEncode(L.Lien("/donnees/fichier/" + f.Fichier)) + "\" download>" + System.Net.WebUtility.HtmlEncode(nom) + "</a>");
    }
    string Taille(long o) => o >= 1_048_576 ? (o / 1_048_576.0).ToString("0.#", fr) + " Mo" : Math.Max(1, o / 1024).ToString("N0", fr) + " Ko";
}

<h1 class="titre-page">@L.T("donnees-ouvertes")</h1>
<p class="chapo">@L.TH("toutes-les-donnees-affichees-sur-le")</p>
<p><a class="bouton-lien" href="@L.Lien("/anomalies")">⚠ @L.T("anom-titre")</a></p>

@if (L.Pays == "US")
{
    <p class="note-source">@L.TH("ces-fichiers-ne-contiennent-que-les")</p>
}
else if (L.Pays == "CH")
{
    <p class="note-source">@L.TH("ces-fichiers-ne-contiennent-que-les-4")</p>
}
else if (L.Pays == "IE")
{
    <p class="note-source">@L.TH("ces-fichiers-ne-contiennent-que-les-c717")</p>
}
else if (L.Pays == "CA")
{
    <p class="note-source">@L.TH("donnees-ca-fichiers-note")</p>
    <p class="note-source">@L.TH("donnees-ca-senat-note")</p>
}
else if (L.Pays == "IT")
{
    <p class="note-source">@L.TH("ces-fichiers-ne-contiennent-que-les-6b92")</p>
}
else if (royaumeUni)
{
    <p class="note-source">@L.TH("ces-fichiers-ne-contiennent-que-les-1f99")</p>
}

@if (fichiers.Count == 0)
{
    <p class="vide">@L.T("les-fichiers-ne-sont-pas-encore")</p>
}
else
{
    <div class="table-wrap">
        <table class="liste-textes">
            <thead><tr><th>@L.T("fichier")</th><th>@L.T("contenu")</th><th class="num">@L.T("lignes")</th><th class="num">@L.T("taille")</th><th>@L.T("mis-a-jour")</th></tr></thead>
            <tbody>
            @foreach (var f in fichiers)
            {
                <tr>
                    <td data-label="@L.T("fichier")"><a href="@L.Lien("/donnees/fichier/" + f.Fichier)" download>@f.Fichier</a><br /><span class="note-source" title="SHA-256">@(f.Sha256[..Math.Min(16, f.Sha256.Length)])…</span></td>
                    <td data-label="@L.T("contenu")">@(L.Code == "fr" ? f.Description : L.TexteOuNull(DescriptionsDonnees.Cle(f.Fichier)) ?? f.Description)</td>
                    <td class="num" data-label="@L.T("lignes")">@f.Lignes.ToString("N0", fr)</td>
                    <td class="num" data-label="@L.T("taille")">@Taille(f.Octets)</td>
                    <td class="nowrap" data-label="@L.T("mis-a-jour")">@f.GenereLe.ToString("d MMM yyyy", fr)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

