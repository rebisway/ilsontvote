@page "/scrutin/{id}"
@using IlsOntVote.Web.Models
@using IlsOntVote.Web.Services
@model ScrutinModel
@{
    var s = Model.Scrutin;
    ViewData["OgImage"] = L.Lien("/apercu/scrutin/" + s.Id + ".png");
    // Description (méta) : résultat et décomptes, textes en base (un modèle par résultat).
    ViewData["Description"] = s.Adopte
        ? L.Tf("scrutin-desc-adopte", s.NbPour, s.NbContre, s.NbAbstentions, s.DateScrutin.ToString("d MMMM yyyy", L.Culture), L.Chambre(s.Chambre))
        : L.Tf("scrutin-desc-rejete", s.NbPour, s.NbContre, s.NbAbstentions, s.DateScrutin.ToString("d MMMM yyyy", L.Culture), L.Chambre(s.Chambre));
    var titre = s.TitreLangue(L.Anglais);
    ViewData["Title"] = titre.Length > 60 ? titre[..60] + "…" : titre;
    var fr = L.Culture;
    ViewData["Fil"] = new List<(string, string)> { (L.T("accueil"), L.Lien("/")), (L.T("votes-nominaux"), L.Lien("/textes")), (Titres.Court(titre, 110), L.Lien("/scrutin/" + s.Id)) };
    // Lieu : pays de la chambre (code ISO ; pas pour le Parlement européen, siégeant dans plusieurs pays). Organisateur : site d'origine de la fiche officielle.
    var codePays = s.Chambre switch
    {
        "AN" or "SENAT" => "FR", "COMMONS" or "LORDS" => "GB", "USHOUSE" or "USSENATE" => "US", "ITCAMERA" or "ITSENATE" => "IT",
        "IEDAIL" or "IESEANAD" => "IE", "CHNR" or "CHSR" => "CH", "CACOMMONS" or "CASENATE" => "CA", _ => null,
    };
    var lieu = new Dictionary<string, object> { ["@type"] = "Place", ["name"] = L.Chambre(s.Chambre) };
    if (codePays is not null) lieu["address"] = new Dictionary<string, object> { ["@type"] = "PostalAddress", ["addressCountry"] = codePays };
    var organisateur = new Dictionary<string, object> { ["@type"] = "GovernmentOrganization", ["name"] = L.Chambre(s.Chambre) };
    if (Uri.TryCreate(s.UrlOfficielle, UriKind.Absolute, out var uriOrg)) organisateur["url"] = uriOrg.GetLeftPart(UriPartial.Authority);
    // Données structurées : un vote est un événement daté d'une assemblée (le résultat est dans la description, pas dans un champ inventé).
    ViewData["JsonLd"] = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Event",
        ["name"] = Titres.Court(titre, 200),
        ["startDate"] = s.DateScrutin.ToString("yyyy-MM-dd"),
        ["eventAttendanceMode"] = "https://schema.org/OfflineEventAttendanceMode",
        ["eventStatus"] = "https://schema.org/EventScheduled",
        ["endDate"] = s.DateScrutin.ToString("yyyy-MM-dd"),   // un vote est ponctuel : même jour (l'heure n'est pas dans les données)
        ["image"] = new[] { "https://www.ilsontvote.org" + L.Lien("/apercu/scrutin/" + s.Id + ".png") + "?v=3" },   // adresse absolue, même version que og:image
        ["location"] = lieu,
        ["organizer"] = organisateur,
        ["description"] = (string)ViewData["Description"]!,
    };
    // « offers » et « performer » ne sont volontairement PAS fournis : un vote n'a ni billet ni artiste, les inventer serait faux.
    // Phrase visible de résultat (texte indexable, calculée d'après les décomptes publiés ; rien n'est inventé).
    var phrase = s.Sort is null
        ? L.Tf("scrutin-phrase-neutre", s.DateScrutin.ToString("d MMMM yyyy", L.Culture), L.Chambre(s.Chambre), s.NbPour ?? 0, s.NbContre ?? 0, s.NbAbstentions ?? 0)
        : s.Adopte
            ? L.Tf("scrutin-phrase-adopte", s.DateScrutin.ToString("d MMMM yyyy", L.Culture), L.Chambre(s.Chambre), s.NbPour ?? 0, s.NbContre ?? 0, s.NbAbstentions ?? 0)
            : L.Tf("scrutin-phrase-rejete", s.DateScrutin.ToString("d MMMM yyyy", L.Culture), L.Chambre(s.Chambre), s.NbPour ?? 0, s.NbContre ?? 0, s.NbAbstentions ?? 0);
    string Libelle(string p) => L.Position(p);
    // Types de vote publiés par les assemblées (données françaises) : traduits quand on les connaît, sinon laissés tels quels.
    string TypeVoteLangue(string t) => L.Code == "fr" ? t : t.ToLowerInvariant() switch
    {
        "scrutin public" or "scrutin public (appel nominal)" => L.T("type-vote-nominal"),
        "scrutin public ordinaire" => L.T("type-vote-ordinaire"),
        "scrutin public solennel" => L.T("type-vote-solennel"),
        _ => t,
    };
}

<div class="retour retour-nav">
    <a href="@L.Lien("/textes")">@L.T("tous-les-textes-a316")</a>
    <nav class="voisins" aria-label="@L.T("scrutin-precedent-et-suivant")">
        @if (Model.Voisins.Precedent is { } prec)
        {
            <a rel="prev" href="@L.Lien("/scrutin/" + prec.Id)" title="@prec.DateScrutin.ToString("d MMM yyyy", fr) — @Titres.Court(prec.TitreLangue(L.Anglais), 120)">← @L.T("precedent-fcf3")</a>
        }
        @if (Model.Voisins.Suivant is { } suiv)
        {
            <a rel="next" href="@L.Lien("/scrutin/" + suiv.Id)" title="@suiv.DateScrutin.ToString("d MMM yyyy", fr) — @Titres.Court(suiv.TitreLangue(L.Anglais), 120)">@L.T("suivant-78a0") →</a>
        }
    </nav>
</div>

<header class="scrutin-tete">
    <p class="meta">
        @L.Chambre(s.Chambre) · @if (s.Chambre is Chambres.IeDail or Chambres.IeSeanad) { <text>@L.T("division") · </text> } else { <text>@(s.Chambre is Chambres.Commons or Chambres.Lords or Chambres.CaCommons ? L.T("division-n") : Chambres.EstNominal(s.Chambre) ? L.T("vote-nominal-n") : L.T("scrutin-n")) @s.Numero · </text> }<time datetime="@s.DateScrutin.ToString("yyyy-MM-dd")">@s.DateScrutin.ToString("d MMMM yyyy", fr)</time>
        @if (s.Sort is not null) { <text>· </text><span class="sort @(s.Adopte ? "adopte" : "rejete")">@(s.Adopte ? L.T("adopte") : L.T("rejete"))</span> }
        @if (s.Confiance) { <span class="tag-493" title="@L.T("confiance-infobulle")" tabindex="0">@L.T("confiance-etiquette")</span> }
    </p>
    <h1>@Titres.Court(titre, 400)</h1>
    @if (titre.Length > 400) { <details class="titre-complet"><summary>@L.T("titre-complet")</summary><p>@titre</p></details> }
<p class="resume-vote">@phrase</p>
<partial name="_OrdreNom" />
</header>
@if (s.TitreTraduitAuto(L.Anglais))
{
    @if (L.Anglais)
    {
        <p class="note-source">@Doute.Html(NiveauDoute.Calcule, L.T("trad-auto-court"), L.T("trad-auto-info-fr")) @L.T("trad-titre-officiel") <span lang="fr">@s.TitreAffiche</span></p>
    }
    else
    {
        <p class="note-source">@Doute.Html(NiveauDoute.Calcule, L.T("trad-auto-court"), L.T("trad-auto-info-en")) @L.T("trad-titre-original") <span lang="en">@s.TitreEn</span></p>
    }
}

@{
    // Jauge de majorité : pour (bleu) puis contre (rouge), sur une échelle qui inclut le seuil requis.
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var exprimes = s.SuffragesExprimes ?? ((s.NbPour ?? 0) + (s.NbContre ?? 0));
    var base100 = Math.Max(1, Math.Max(exprimes, s.SuffragesRequis ?? 0));
    string Pc(int? n) => (100.0 * (n ?? 0) / base100).ToString("0.##", inv);
    var typeVote = TypeVoteLangue(string.IsNullOrWhiteSpace(s.TypeVoteLibelle) ? "scrutin public" : s.TypeVoteLibelle!.Trim());
    typeVote = char.ToUpperInvariant(typeVote[0]) + typeVote[1..];
}

@{
    // Prompt « Résumer avec une IA » : le CONTENU du texte (voir PromptResume) ; sources = projet britannique, Légifrance, dossiers de l'Assemblée et du Sénat.
    var liensPrompt = new List<string>();
    if (s.UrlOfficielle is { } uo) liensPrompt.Add(uo);
    if (Model.Bill is { } b0) liensPrompt.Add("https://bills.parliament.uk/bills/" + b0.Id);
    if (Model.Loi is { } l0) { liensPrompt.Add(l0.UrlLegifrance ?? ""); liensPrompt.Add(l0.UrlDossierAn ?? ""); liensPrompt.Add(l0.UrlDossierSenat ?? ""); }
    var promptIA = PromptResume.Construire(L, titre, liensPrompt);
}
@* Sans bloc « texte » (UE, vote isolé) : le bouton reste seul ; sinon il est dans la rangée des raccourcis du bloc. *@
@if (Model.Loi is null && Model.Bill is null && !Chambres.EstNominal(s.Chambre))
{
    <section class="bloc-texte" aria-label="@L.T("resume-par-ia")"><div class="bloc-texte-titre"><partial name="_ResumeIA" model="promptIA" /></div></section>
}
@if (Chambres.EstNominal(s.Chambre))
{
    <section class="bloc-texte" aria-label="@L.T("source")">
        <div class="bloc-texte-titre">@if (s.Chambre == Chambres.UsSenate) { @Doute.Html(NiveauDoute.Calcule, L.T("source-tierce"), L.T("votes-du-senat-retraites-par-voteview")) }
            @if (s.UrlOfficielle is { } urlOff) { <a class="raccourci" href="@urlOff" rel="noopener" target="_blank">@L.T("enregistrement-officiel") ↗</a> }
            @if (s.SurEnsemble && s.Chambre is not (Chambres.ItCamera or Chambres.ItSenate)) { @Doute.Html(NiveauDoute.Calcule, L.T("vote-sur-l-ensemble"), L.T("repere-par-ce-site-d-apres")) }
            <partial name="_ResumeIA" model="promptIA" />
        </div>
    </section>
}
@if (Model.Bill is { } bill)
{
    <section class="bloc-texte" aria-label="@L.T("projet-de-loi")">
        <div class="bloc-texte-titre"><span class="statut">@L.T("projet-de-loi")</span>
            <a href="@L.Lien("/bill/" + bill.Id)">@bill.Titre</a>
            @if (bill.Etape is not null) { <span class="note-source">· @bill.Etape</span> }
            @Doute.Html(NiveauDoute.Calcule, L.T("calcule"), L.T("rattache-par-ce-site-d-apres"))
            <a class="raccourci" href="https://bills.parliament.uk/bills/@bill.Id" rel="noopener" target="_blank">@L.T("texte-du-projet") ↗</a>
            <partial name="_ResumeIA" model="promptIA" /></div>
    </section>
}
@if (Model.Loi is { } loi)
{
    var statutLoi = loi.Statut.Traduit(L);
    <section class="bloc-texte" aria-label="@L.T("le-texte-vote")">
        <div class="bloc-texte-titre"><span class="statut @statutLoi.Classe">@statutLoi.Libelle</span>
            <a class="raccourci" href="@L.Lien("/texte/" + loi.Id)">@L.T("voir-tout-le-parcours-de-ce")</a>
            @if (!string.IsNullOrEmpty(loi.UrlLegifrance)) { <a class="raccourci" href="@loi.UrlLegifrance" rel="noopener" target="_blank">@L.T("texte-sur-legifrance") ↗</a> }
            @if (!string.IsNullOrEmpty(loi.UrlDossierSenat)) { <a class="raccourci" href="@loi.UrlDossierSenat" rel="noopener" target="_blank">@L.T("dossier-legislatif") ↗</a> }
            <partial name="_ResumeIA" model="promptIA" />
        </div>
        <p class="bloc-texte-faits">
            @if (loi.DatePromulgation is not null) { <span>@L.T("promulgue-le") <b>@loi.DatePromulgation.Value.ToString("d MMMM yyyy", fr)</b></span> }
            @if (loi.DateJo is not null) { <span>@L.T("paru-au-journal-officiel-le") <b>@loi.DateJo.Value.ToString("d MMMM yyyy", fr)</b></span> }
            @if (!string.IsNullOrEmpty(loi.NumeroLoi)) { <span>@L.T("loi-n-ecbf") <b>@loi.NumeroLoi</b></span> }
            @if (loi.DecisionCcLibelle is not null) { <span>@L.T("conseil-constitutionnel") <b>@loi.DecisionCcLibelle</b></span> }
        </p>
    </section>
}

<section class="fiche-vote" aria-label="@L.T("caracteristiques-du-vote")">
    <dl>
        <div><dt>@L.T("type-de-vote")</dt><dd>@typeVote</dd></div>
        <div><dt>@L.T("votants")</dt><dd>@(s.NbVotants?.ToString("N0", fr) ?? "—")</dd><dd class="detail">@(s.NbNonVotants is > 0 ? (s.NbNonVotants > 1 ? L.Tf("non-votants-pl", s.NbNonVotants) : L.Tf("non-votants-sg", s.NbNonVotants)) : "")</dd></div>
        <div><dt>@L.T("suffrages-exprimes")</dt><dd>@exprimes.ToString("N0", fr)</dd><dd class="detail">@L.T("pour-contre-hors-abstentions")</dd></div>
        @if (s.SuffragesRequis is not null)
        {
            <div>
                <dt>@L.T("majorite-requise")</dt>
                <dd>@s.SuffragesRequis.Value.ToString("N0", fr) @L.T("voix")</dd>
                <dd class="detail">@(string.IsNullOrWhiteSpace(s.TypeMajorite) ? L.T("pour-etre-adopte") : char.ToUpperInvariant(s.TypeMajorite.Trim()[0]) + s.TypeMajorite.Trim()[1..])</dd>
            </div>
        }
    </dl>

    <div class="jauge" role="img" aria-label="@L.T("pour-2ecc") @s.NbPour, @L.T("contre-6505") @s.NbContre@(s.SuffragesRequis is null ? "" : L.Tf("jauge-majorite-requise", s.SuffragesRequis))">
        <span class="j-pour" style="width:@(Pc(s.NbPour))%"></span>
        <span class="j-contre" style="width:@(Pc(s.NbContre))%"></span>
        @if (s.SuffragesRequis is not null)
        {
            <i class="j-seuil" style="left:@(Pc(s.SuffragesRequis))%" title="@L.T("majorite-requise") : @s.SuffragesRequis @L.T("voix")"></i>
        }
    </div>
    <p class="jauge-legende">
        <span class="c-pour"><b>@s.NbPour</b> @L.T("pour-081c")</span>
        <span class="c-contre"><b>@s.NbContre</b> @L.T("contre-6505")</span>
        <span class="c-abstention"><b>@s.NbAbstentions</b> @L.T("abstention-8420")@(s.NbAbstentions > 1 ? "s" : "")</span>
    </p>
</section>

@if (s.NominatifIncomplet)
{
    <p class="alerte" role="note">
        @Doute.Html(NiveauDoute.Incertain, L.T("decompte-incomplet"), L.T("la-source-ne-detaille-pas-tous"))
        <text>@L.Tf("alerte-donnees-incompletes", L.Chambre(s.Chambre), s.NbVotesManquants, s.NbVotesManquants > 1 ? L.Membres(s.Chambre) : L.Membre(s.Chambre))</text>
    </p>
}

@if (s.Chambre == Chambres.Senat)
{
    <p class="note-source">@L.T("au-senat-absent-signifie-n-a")</p>
}

<div class="bascule" role="group" aria-label="@L.T("colorer-les-points")">
    <span>@L.T("colorer-par")</span>
    <button type="button" class="actif" data-mode="vote">@L.T("vote")</button>
    <button type="button" data-mode="groupe">@L.T("groupe")</button>
    <label class="case anneau-case"><input type="checkbox" id="anneau" /> @L.T("cercle-de-groupe")</label>
</div>

<div class="hemicycle-grand" id="hemicycle">
    <partial name="_Hemicycle" model="(Model.Vue, true)" />
</div>

<ul class="legende" id="legende-vote">
    <li class="d-pour"><i></i> @L.T("pour-2ecc") <b>@Model.Sieges.Count(x => x.Position == Pos.Pour)</b></li>
    <li class="d-contre"><i></i> @L.T("contre-b885") <b>@Model.Sieges.Count(x => x.Position == Pos.Contre)</b></li>
    <li class="d-abstention"><i></i> @L.T("abstention") <b>@Model.Sieges.Count(x => x.Position == Pos.Abstention)</b></li>
    <li class="d-nonvotant"><i></i> @L.T("non-votant") <b>@Model.Sieges.Count(x => x.Position == Pos.NonVotant)</b></li>
    <li class="d-absent"><i></i> @L.T("absent") <b>@Model.Sieges.Count(x => x.Position == Pos.Absent)</b></li>
</ul>

<ul class="legende" id="legende-groupe" hidden>
    @foreach (var g in Model.Groupes)
    {
        <li><span class="pastille" style="background:@(g.Couleur ?? "#8d949a")"></span> @g.Sigle <b>@g.Total</b></li>
    }
</ul>

@{
    // Communes : le décompte officiel est le nombre de noms des listes « ayes » / « noes » ; les scrutateurs (tellers) sont listés à part par la source. Ils ont voté et figurent dans les
    // points, la légende et les totaux par groupe : l'écart avec l'en-tête (ex. 290 / 94 contre 292 / 96) est EXPLIQUÉ ici, et non laissé à deviner (ce n'est pas un effet des procurations).
    var pourListe = Model.Sieges.Count(x => x.Position == Pos.Pour);
    var contreListe = Model.Sieges.Count(x => x.Position == Pos.Contre);
    var ecartPour = pourListe - (s.NbPour ?? 0);
    var ecartContre = contreListe - (s.NbContre ?? 0);
    var procurations = Model.Sieges.Count(x => x.ParDelegation && (x.Position == Pos.Pour || x.Position == Pos.Contre));
}
@if (s.Chambre == Chambres.Commons && (ecartPour > 0 || ecartContre > 0))
{
    <p class="note-source">@Doute.Html(NiveauDoute.Calcule, L.T("scrutateurs"), L.T("ecart-calcule-par-le-site-entre"))
        @L.Tf("scrutateurs-decompte-officiel", s.NbPour, s.NbContre, ecartPour, ecartContre, pourListe, contreListe, procurations)</p>
}
@if (!string.IsNullOrWhiteSpace(s.Note))
{
    @if (s.Chambre == Chambres.UE)
    {
        <p class="note-source">@Doute.Html(NiveauDoute.Calcule, L.T("source-tierce"), L.T("donnees-du-parlement-europeen-retraitees-par")) @(L.Code == "fr" ? (s.Note ?? "") : L.T("note-source-tierce-ue"))</p>
    }
    else
    {
        <p class="note-source"><strong>@L.T("note-officielle")</strong> @s.Note</p>
    }
}

<h2>@L.T("par-groupe")</h2>
<div class="table-wrap">
    <table class="groupes">
        <thead>
            <tr>
                <th>@L.T("groupe")</th>
                <th class="th-pour">@L.T("pour-2ecc")</th><th class="th-contre">@L.T("contre-b885")</th><th class="th-abstention">@L.T("abst-29c5")</th>
                <th>@L.T("non-votant")</th><th>@L.T("absents-fe06")</th><th>@L.T("total")</th><th class="col-barre">@L.T("repartition")</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var g in Model.Groupes)
        {
            string W(int n) => g.Total == 0 ? "0" : (100.0 * n / g.Total).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            <tr>
                <th scope="row"><span class="pastille" style="background:@(g.Couleur ?? "#8d949a")"></span>@g.Sigle</th>
                <td class="c-pour">@g.Pour</td><td class="c-contre">@g.Contre</td><td class="c-abstention">@g.Abstention</td>
                <td>@g.NonVotant</td><td>@g.Absent</td><td>@g.Total</td>
                <td class="col-barre">
                    <div class="barre-empilee fine" role="img" aria-label="@L.T("repartition-des-votes-du-groupe") @g.Sigle">
                        <span class="b-pour" style="width:@(W(g.Pour))%"></span>
                        <span class="b-contre" style="width:@(W(g.Contre))%"></span>
                        <span class="b-abstention" style="width:@(W(g.Abstention))%"></span>
                        <span class="b-non_votant" style="width:@(W(g.NonVotant))%"></span>
                        <span class="b-absent" style="width:@(W(g.Absent))%"></span>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<h2>@L.T("tous-les")@L.Membres(s.Chambre)</h2>
<input id="filtre" class="filtre" type="search" placeholder="@L.T("chercher-un-nom-un-groupe")" aria-label="@L.T("chercher-un-elu-838c")" autocomplete="off" />
<div class="table-wrap">
    <table class="deputes" id="deputes">
        <thead><tr><th>@char.ToUpper(L.Membre(s.Chambre)[0])@L.Membre(s.Chambre)[1..]</th><th>@L.T("groupe")</th><th>@L.T("vote")</th></tr></thead>
        <tbody>
        @foreach (var d in Model.Sieges.OrderBy(x => x.Nom).ThenBy(x => x.Prenom))
        {
            <tr data-q="@((d.NomComplet + " " + d.GroupeSigle).ToLowerInvariant())">
                <td>@if (d.Lien is { } lienFiche) { <a href="@L.Lien(lienFiche)">@Noms.Html(d.Prenom, d.Nom)</a> } else { @Noms.Html(d.Prenom, d.Nom) }</td>
                <td>@d.GroupeSigle</td>
                <td>
                    <span class="badge b-@d.Position">@Libelle(d.Position)</span>
                    @if (d.Rectifie)
                    {
                        <span class="tag tag-rectifie">@(d.OrigineInconnue ? L.T("mise-au-point-ca20") : L.T("rectifie-a-l-origine") + (d.PositionOrigine is null ? L.T("absent-7df8") : Libelle(d.PositionOrigine).ToLowerInvariant()) + ")")</span>
@if (d.OrigineInconnue) { @Doute.Html(NiveauDoute.Manquant, L.T("origine-inconnue"), L.T("la-position-publiee-au-scrutin-avant")) }
                    }
                    @if (d.ParDelegation)
                    {
                        <span class="tag tag-delegation">@L.T("par-delegation-ad67")</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<script>
    (function () {
        var svg = document.querySelector('#hemicycle svg');
        var lv = document.getElementById('legende-vote');
        var lg = document.getElementById('legende-groupe');
        var boutons = document.querySelectorAll('.bascule button');
        boutons.forEach(function (b) {
            b.addEventListener('click', function () {
                var parGroupe = b.dataset.mode === 'groupe';
                svg.classList.toggle('par-groupe', parGroupe);
                lv.hidden = parGroupe;
                lg.hidden = !parGroupe;
                boutons.forEach(function (x) { x.classList.toggle('actif', x === b); });
            });
        });
        var anneau = document.getElementById('anneau');
        anneau.addEventListener('change', function () { svg.classList.toggle('anneau', anneau.checked); });
    })();
    (function () {
        var input = document.getElementById('filtre');
        var rows = document.querySelectorAll('#deputes tbody tr');
        input.addEventListener('input', function () {
            var q = input.value.trim().toLowerCase();
            rows.forEach(function (r) { r.hidden = q && r.dataset.q.indexOf(q) === -1; });
        });
    })();
</script>
